---
// VISUAL: SaSurfaceMap (kind "SaSurfaceMap"). Data-driven five-card board for the AI SEO, AEO and GEO pages. Reads:
//   X.variant  "ai" | "aeo" | "geo"  (changes the card shape and connector: ai = spark, aeo = quote bubble, geo = source arrows)
//   X.cols[5]  { head, lines: [text, text], chip, tone: "w" | "b" | "ok" }  head 1 to 3 words, lines 2 short phrases, chip 2 to 3 words
//   X.base     label of the bar under the cards
// Pins in a row above (y = 0, x = 10, 30, 50, 70, 90). No figures. Styles scoped (prefix ssm-).
interface Props { X: any; pins: { x: number; y: number; label: string }[] }
const { X } = Astro.props as Props;
const cols = (X.cols ?? []) as { head: string; lines: string[]; chip: string; tone?: string }[];
const v = X.variant ?? "ai";
---
<div class="ssm-row" aria-hidden="true"></div>
<div class={"ssm-art ssm-art--" + v} role="img" aria-label={X.artLabel ?? "Five cards, each showing one place a brand drops out of the answer."}>
  {cols.map((c) => (
    <div class="ssm-c">
      <b class="ssm-h"><i aria-hidden="true"></i>{c.head}</b>
      <div class="ssm-b">{c.lines.map((l, k) => <span class={"ssm-l" + (k > 0 ? " ssm-l--2" : "")}>{l}</span>)}</div>
      <em class={"ssm-chip ssm-chip--" + (c.tone ?? "w")}>{c.chip}</em>
    </div>
  ))}
</div>
<div class="ssm-base" aria-hidden="true"><span>{X.base}</span></div>
<style is:global>
.ssm-row { height: 78px; }
.ssm-art { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(6px, 1.2vw, 14px); }
.ssm-c { position: relative; display: flex; flex-direction: column; gap: 10px; min-width: 0; padding: clamp(8px, 1.1vw, 14px); border: 1px solid #DADDE1; border-radius: 14px; background: #fff; }
.ssm-c::after { content: ""; position: absolute; left: 50%; bottom: -18px; width: 0; height: 18px; border-left: 2px dashed #9DB8F7; }
.ssm-h { display: flex; align-items: center; gap: 7px; font: 800 clamp(10px, .95vw, 12.5px)/1.2 var(--font-body); letter-spacing: .06em; text-transform: uppercase; color: #65676B; }
.ssm-h i { flex: none; width: 10px; height: 10px; background: var(--mmc-blue); border-radius: 50%; }
.ssm-b { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 7px; min-height: 92px; }
.ssm-l { padding: 7px 9px; border-radius: 9px; background: #F1F5FF; font: 700 clamp(10.5px, .9vw, 12px)/1.3 var(--font-body); color: var(--mmc-blue-900); }
.ssm-l--2 { background: transparent; border: 1px dashed #8A93A6; color: #65676B; font-weight: 600; }
.ssm-chip { align-self: flex-start; padding: 4px 9px; border-radius: 99px; font: 800 10px/1.25 var(--font-body); font-style: normal; text-transform: uppercase; letter-spacing: .04em; }
.ssm-chip--w { background: #FFF3D6; color: #8A5A00; } .ssm-chip--b { background: #FDE8E8; color: #B42318; } .ssm-chip--ok { background: #E3F6E9; color: #1B7A3D; }
.ssm-base { margin-top: 18px; height: 40px; border-radius: 12px; background: var(--mmc-blue-900); display: grid; place-items: center; padding-inline: 12px; } .ssm-base span { font: 800 12px var(--font-body); letter-spacing: .08em; text-transform: uppercase; color: #fff; text-align: center; }
/* variants */
.ssm-art--ai .ssm-h i { clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%); width: 13px; height: 13px; border-radius: 0; background: conic-gradient(from 45deg, var(--mmc-blue), #8AB0FF, var(--mmc-blue)); }
.ssm-art--aeo .ssm-l { border-radius: 14px 14px 14px 3px; } .ssm-art--aeo .ssm-h i { border-radius: 50% 50% 50% 0; }
.ssm-art--geo .ssm-c:not(:last-child)::before { content: ""; position: absolute; top: 28px; right: calc(-1 * clamp(6px, 1.2vw, 14px) - 1px); width: clamp(6px, 1.2vw, 14px); border-top: 2px solid #9DB8F7; z-index: 1; }
.ssm-art--geo .ssm-h i { border-radius: 3px; transform: rotate(45deg); }
@media (max-width: 760px) { .ssm-row { height: 58px; } .ssm-h { display: none; } .ssm-b { min-height: 70px; } .ssm-l { font-size: 11px; padding: 5px 6px; } .ssm-chip { font-size: 11px; padding: 3px 6px; } .ssm-c { padding: 6px; gap: 6px; } .ssm-base { height: 36px; } .ssm-base span { font-size: 11px; } }
/* five columns must stay (pins above align to them): keep one phrase per card at full legible size, the second phrase is dropped */
@media (max-width: 520px) { .ssm-art { gap: 4px; } .ssm-c { padding: 5px 3px; } .ssm-l { font-size: 11px; line-height: 1.2; padding: 5px 2px; text-align: center; hyphens: auto; overflow-wrap: anywhere; } .ssm-l--2 { display: none; } .ssm-b { min-height: 56px; } .ssm-chip { align-self: stretch; text-align: center; font-size: 11px; letter-spacing: 0; text-transform: none; padding: 3px 1px; overflow-wrap: anywhere; } .ssm-art--geo .ssm-c::before { display: none; } }
</style>
