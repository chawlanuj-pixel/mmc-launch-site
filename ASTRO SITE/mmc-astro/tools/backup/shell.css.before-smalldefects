          background: var(--mmc-yellow);
          box-shadow: 0 0 0 3px rgba(var(--mmc-yellow-rgb), 0.2);
        }
        .cookie__body {
          font-family: var(--font-body);
          font-size: 13.5px;
          line-height: 1.55;
          color: var(--fg-1);
          margin: 0;
          max-width: 640px;
        }
        .cookie__body a {
          color: var(--mmc-blue);
          border-bottom: 1px solid currentColor;
        }
        .cookie__body a:hover { color: var(--mmc-blue-700); }

        .cookie__btn {
          font-family: var(--font-body);
          font-size: 12px;
          font-weight: 700;
          letter-spacing: 0.12em;
          text-transform: uppercase;
          padding: 11px 18px;
          border-radius: 999px;
          border: 1px solid transparent;
          transition: all var(--dur-base) var(--ease-out);
          cursor: pointer;
          white-space: nowrap;
        }
        .cookie__btn--primary {
          background: var(--mmc-blue);
          color: #fff;
        }
        .cookie__btn--primary:hover {
          background: var(--mmc-blue-700);
          transform: translateY(-1px);
          position: relative; z-index: 2;
        }
        .cookie__btn--secondary {
          background: #fff;
          color: var(--mmc-blue);
          border-color: rgba(var(--mmc-blue-rgb), 0.22);
        }
        .cookie__btn--secondary:hover {
          border-color: var(--mmc-blue);
        }
        .cookie__btn--ghost {
          background: transparent;
          color: var(--mmc-ink);
          border-color: rgba(var(--mmc-blue-rgb), 0.22);
        }
        .cookie__btn--ghost:hover {
          color: var(--mmc-blue);
        }

        /* Prefs panel */
        .cookie__prefs { flex: 1; min-width: 100%; }
        .cookie__prefs-head {
          display: flex;
          justify-content: space-between;
          align-items: center;
          padding-bottom: 14px;
          margin-bottom: 14px;
          border-bottom: 1px solid rgba(var(--mmc-blue-rgb), 0.12);
        }
        .cookie__prefs-title {
          font-family: var(--font-display);
          font-weight: 700;
          font-size: 18px;
          letter-spacing: -0.015em;
          color: var(--fg-1);
        }
        .cookie__close {
          width: 32px; height: 32px;
          border-radius: 50%;
          background: rgba(var(--mmc-blue-rgb), 0.08);
          color: var(--mmc-blue);
          font-size: 20px; line-height: 1;
          cursor: pointer;
          transition: background var(--dur-base) var(--ease-out);
        }
        .cookie__close:hover { background: rgba(var(--mmc-blue-rgb), 0.16); }

        .cookie__list {
          list-style: none;
          margin: 0;
          padding: 0;
          display: flex;
          flex-direction: column;
          gap: 4px;
        }
        .cookie__list li {
          padding: 14px 0;
          border-bottom: 1px solid rgba(var(--mmc-blue-rgb), 0.10);
        }
        .cookie__list li:last-child { border-bottom: 0; }
        .cookie__list-head {
          display: flex;
          justify-content: space-between;
          align-items: center;
          margin-bottom: 4px;
          gap: 14px;
        }
        .cookie__list-name {
          font-family: var(--font-display);
          font-weight: 700;
          font-size: 15px;
          letter-spacing: -0.005em;
          color: var(--fg-1);
        }
        .cookie__list-locked {
          font-family: var(--font-body);
          font-size: 10px;
          font-weight: 700;
          letter-spacing: 0.18em;
          text-transform: uppercase;
          color: var(--mmc-yellow);
          padding: 4px 10px;
          background: rgba(var(--mmc-yellow-rgb), 0.16);
          border-radius: 999px;
        }
        .cookie__list p {
          font-family: var(--font-body);
          font-size: 12.5px;
          line-height: 1.5;
          color: var(--fg-2);
          margin: 0;
          max-width: 600px;
        }

        /* Toggle */
        .cookie__toggle {
          position: relative;
          width: 42px;
          height: 22px;
          flex-shrink: 0;
          cursor: pointer;
        }
        .cookie__toggle input { opacity: 0; position: absolute; inset: 0; cursor: pointer; }
        .cookie__toggle-track {
          position: absolute; inset: 0;
          background: rgba(var(--mmc-blue-rgb), 0.18);
          border-radius: 999px;
          transition: background var(--dur-base) var(--ease-out);
        }
        .cookie__toggle-track::after {
          content: "";
          position: absolute;
          left: 3px;
          top: 3px;
          width: 16px; height: 16px;
          border-radius: 50%;
          background: #fff;
          transition: transform var(--dur-base) var(--ease-out);
          box-shadow: 0 1px 2px rgba(0,0,0,0.18);
        }
        .cookie__toggle input:checked + .cookie__toggle-track {
          background: var(--mmc-blue);
        }
        .cookie__toggle input:checked + .cookie__toggle-track::after {
          transform: translateX(20px);
        }

        .cookie__prefs-foot {
          display: flex;
          justify-content: flex-end;
          gap: 8px;
          padding-top: 18px;
          margin-top: 8px;
          border-top: 1px solid rgba(var(--mmc-blue-rgb), 0.12);
        }

        @media (max-width: 720px) {
          .cookie__inner { flex-direction: column; align-items: stretch; }
          .cookie__r { justify-content: flex-end; }
          .cookie__prefs-foot { flex-direction: column-reverse; }
          .cookie__btn { width: 100%; text-align: center; }
