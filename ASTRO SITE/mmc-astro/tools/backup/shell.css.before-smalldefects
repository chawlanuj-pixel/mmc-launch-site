/* ===== Cookie banner on phones: a slim bar instead of a 312px card (was 37% of the screen) ===== */
@media (max-width: 640px) {
  .cookie { left: 8px; right: 8px; bottom: 8px; }
  .cookie__inner { padding: 12px 14px; gap: 10px; border-radius: 16px; }
  .cookie__l { min-width: 0; }
  .cookie__eyebrow { display: none; }
  .cookie__body { font-size: 12px; line-height: 1.45; }
  .cookie__r { display: flex; width: 100%; gap: 6px; flex-wrap: nowrap; }
  .cookie__btn { flex: 1 1 0; min-height: 44px; padding: 10px 6px; font-size: 12px; letter-spacing: .02em; }
  .cookie__prefs { max-height: 70vh; overflow-y: auto; }
  .cookie__btn--ghost { flex: 0 0 auto; padding-inline: 10px; }
}

/* Cookie banner: a compact card on desktop (bottom right) so it never covers a hero CTA; ghost button always readable. */
@media (min-width: 761px) {
  .cookie { left: auto; right: clamp(12px, 2vw, 24px); width: min(560px, calc(100vw - 48px)); }
  .cookie__inner { padding: 16px 20px; gap: 14px; }
  .cookie__r { width: 100%; justify-content: flex-end; }
}
@media (max-width: 640px) { .cookie__btn--ghost { min-width: 44px; } }
@media (max-width: 640px) {
  .cookie .cookie__r { flex-wrap: nowrap; }
  .cookie .cookie__btn--ghost { flex: 0 0 auto; width: auto; min-width: 0; padding-inline: 12px; }
  .cookie .cookie__btn--secondary, .cookie .cookie__btn--primary { flex: 1 1 0; min-width: 0; }
}

/* Narrow phones: the wordmark and Menu button must fit inside the nav pill (overflowed at 360 and 375). */
@media (max-width: 400px) {
  .mmc-nav__inner { padding-left: 10px; padding-right: 5px; gap: 6px; }
  .mmc-nav__mark { gap: 8px; }
  .mmc-nav__mark-icon { width: 28px; height: 28px; }
  .mmc-nav__name-mmc { font-size: 12px; letter-spacing: -.01em; }
}


/* ===== Launch hygiene (accessibility + phone) ============================== */
.skip-link {
  position: fixed; left: 12px; top: -64px; z-index: 300;
  padding: 12px 18px; border-radius: 999px;
  background: #0B1020; color: #fff; font: 700 13px/1 var(--font-body, sans-serif);
  letter-spacing: 0.04em; text-decoration: none;
  transition: top 160ms ease;
}
.skip-link:focus { top: 12px; outline: 2px solid var(--mmc-yellow, #FFC528); outline-offset: 2px; }
main:focus { outline: none; }

/* iOS Safari zooms the page when a focused field is under 16px. */
@media (max-width: 640px) {
  input:not([type="range"]):not([type="checkbox"]):not([type="radio"]):not([type="hidden"]),
  textarea, select { font-size: 16px !important; }
}

/* Touch targets: keep the visual size, grow the hit area to 44px. */
@media (max-width: 820px) {
  .ft__col a, .ft__base a, .ft a:not(.ft__brand):not(.ft__cta) { min-height: 44px; display: inline-flex; align-items: center; }
  .mmc-nav__mark, .sm-link, .sunmenu__sub a, .btn { min-height: 44px; }
  .audit__close, .cookie__close { min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; }
}

/* Decorative loops that ignore prefers-reduced-motion. */
@media (prefers-reduced-motion: reduce) {
  .mmc-nav__meta-dot, [class*="cs-strip"], [class*="cs__strip"] { animation: none !important; }
}

/* ===== Phone menu (<= 720px): root -> directory -> category, one overlay. Desktop and tablet are unchanged. ===== */
@media (max-width: 720px) {
  .sunmenu__content--phone {
    display: flex; flex-direction: column; gap: 10px;
    padding: calc(env(safe-area-inset-top, 0px) + 84px) max(20px, env(safe-area-inset-right, 0px)) calc(12px + env(safe-area-inset-bottom, 0px)) max(20px, env(safe-area-inset-left, 0px));
    height: 100vh; height: 100dvh;
  }
  .mm-head { flex: none; padding-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.22); }
  /* "The Index" and the descriptor stay, in a smaller size than the desktop menu */
  .mm-index { font-size: 10px; letter-spacing: 0.2em; margin-bottom: 6px; }
  .mm-index::before { width: 18px; }
  .sunmenu__multi.mm-multi { padding: 0; border: 0; gap: 6px; font-size: 13px; letter-spacing: -0.01em; line-height: 1.3; }
  .mm-nav { flex: 1 1 auto; min-height: 0; position: relative; overflow: hidden; }
  .mm-views { position: relative; height: 100%; }

  /* Views slide horizontally; the hidden ones are visibility:hidden (and inert), so they are never focusable. */
  .mm-view {
    position: absolute; inset: 0; display: flex; flex-direction: column; min-height: 0;
    transition: transform 260ms var(--ease-out), opacity 260ms var(--ease-out), visibility 0s linear 260ms;
  }
  /* inherit, not visible: the overlay itself is visibility:hidden until the menu opens, and a child set to visible would show through it */
  .mm-view.is-current { transform: none; opacity: 1; visibility: inherit; transition-delay: 0s; }
  .mm-view.is-left  { transform: translateX(-28%); opacity: 0; visibility: hidden; }
  .mm-view.is-right { transform: translateX(100%); opacity: 0; visibility: hidden; }

  .mm-list { list-style: none; margin: 0; padding: 0; }
  .mm-scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
  .mm-list > li { border-bottom: 1px solid rgba(255,255,255,0.16); }
  .mm-list > li:last-child { border-bottom: 0; }

  .mm-row {
    display: flex; align-items: center; gap: 14px; width: 100%; min-height: 46px; padding: 8px 2px;
    background: transparent; border: 0; border-radius: 0; text-align: left; cursor: pointer; text-decoration: none;
    color: rgba(255,255,255,0.9); font: inherit; -webkit-tap-highlight-color: transparent;
    transition: background-color 150ms var(--ease-out), color 150ms var(--ease-out);
  }
  .mm-row:active, .mm-row:hover { background: rgba(255,255,255,0.08); color: #fff; }
  .mm-row:focus-visible, .mm-back:focus-visible, .mm-page:focus-visible { outline: 2px solid var(--mmc-yellow); outline-offset: -2px; background: rgba(255,255,255,0.08); color: #fff; }
  .mm-n { flex: none; width: 22px; font-family: var(--font-body); font-weight: 600; font-size: 11px; letter-spacing: 0.14em; color: rgba(255,255,255,0.85); }
  .mm-label { flex: 1; min-width: 0; font-family: var(--font-display); font-weight: 700; font-size: 20px; letter-spacing: -0.02em; line-height: 1.15; }
  .mm-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .mm-body .mm-label { flex: none; font-size: 18px; }
  .mm-desc { font-family: var(--font-body); font-weight: 500; font-size: 12.5px; line-height: 1.3; color: rgba(255,255,255,0.75); }
  .mm-arr { flex: none; display: inline-flex; color: var(--mmc-yellow); padding-right: 2px; }
  .mm-row--two { min-height: 56px; }

  .mm-bar { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .mm-back, .mm-page {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 4px; background: transparent; border: 0; cursor: pointer;
    font-family: var(--font-body); font-weight: 700; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; color: #fff;
    -webkit-tap-highlight-color: transparent;
  }
  .mm-back svg { color: var(--mmc-yellow); }
  .mm-page { color: var(--mmc-yellow); }
  .mm-back:active, .mm-page:active { opacity: 0.7; }
  .mm-title { flex: none; margin: 2px 0 2px; font-family: var(--font-display); font-weight: 700; font-size: 26px; letter-spacing: -0.025em; line-height: 1.1; color: #fff; }
  .mm-hint { flex: none; margin: 0 0 8px; font-family: var(--font-body); font-style: italic; font-size: 13px; line-height: 1.35; color: rgba(255,255,255,0.8); }

  .mm-cta { flex: none; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.22); }
  .mm-cta .btn { width: 100%; justify-content: center; min-height: 48px; }
  .mm-cta .glow-btn__inner { justify-content: center; }

  @media (max-height: 700px) {
    .sunmenu__content--phone { gap: 8px; padding-top: calc(env(safe-area-inset-top, 0px) + 78px); }
    .mm-row { min-height: 44px; padding-block: 6px; }
    .mm-row--two { min-height: 52px; }
    .mm-title { font-size: 23px; }
  }
}
@media (max-width: 720px) and (prefers-reduced-motion: reduce) {
  .mm-view { transition: none; }
}

/* Cookie notice on phones (<=600px): a compact bar. Short text on one line, the three choices as one row of small buttons. */
.cookie__short { display: none; }
@media (max-width: 600px) {
  .cookie__long { display: none; }
  .cookie__short { display: inline; }
  .cookie { left: 6px; right: 6px; bottom: calc(6px + env(safe-area-inset-bottom, 0px)); }
  .cookie__inner { flex-direction: column; flex-wrap: nowrap; align-items: stretch; padding: 8px 8px 8px 12px; gap: 6px; border-radius: 14px; }
  .cookie__l { flex: 0 0 auto; min-width: 0; }
  .cookie__body { font-size: 11.5px; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cookie__r { display: flex; width: 100%; flex: 0 0 auto; gap: 6px; flex-wrap: nowrap; justify-content: stretch; }
  .cookie .cookie__btn { flex: 1 1 0; min-width: 0; width: auto; min-height: 36px; padding: 6px 8px; font-size: 10.5px; letter-spacing: .04em; }
  .cookie .cookie__btn--ghost { flex: 0 0 auto; padding-inline: 14px; }
  .cookie__prefs { max-height: 62dvh; }
}
