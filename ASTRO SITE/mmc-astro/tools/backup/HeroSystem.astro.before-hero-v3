---
// Home hero: the headline and booking button on the left, and an animated "one loop" diagram on the right
// (Strategy -> Content -> Technology -> Growth, with the MMC mark at the centre) over a slow, animated blue background.
// Copy is unchanged from the previous hero. Styles: hero-system.css (hs- prefix) plus the shared .hv-* copy styles in home-v2b.css.
import "../../styles/hero-system.css";

const NODES = [
  { t: "Strategy", s: "the brief", icon: `<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r=".6"/>` },
  { t: "Content", s: "the ad", icon: `<rect x="3" y="5" width="18" height="14" rx="3.5"/><path d="M10.2 9.4v5.2l4.4-2.6z"/>` },
  { t: "Technology", s: "the page", icon: `<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M13.5 6l-3 12"/>` },
  { t: "Growth", s: "the order", icon: `<path d="M3 17l6-6 4 4 8-8M15 7h6v6"/>` },
];
---
<section class="hv-hero hs-hero no-section-bg" id="top" data-hs-hero>
  <div class="hs-bg" aria-hidden="true">
    <span class="hs-blob hs-blob--1"></span>
    <span class="hs-blob hs-blob--2"></span>
    <span class="hs-blob hs-blob--3"></span>
    <span class="hs-lines"></span>
    <span class="hs-beam"></span>
  </div>
  <div class="hn-wrap hs-grid">
    <div class="hs-copy hv-hero__copy">
      <span class="hv-chip"><i></i>We build and grow brands · D2C, B2B and education</span>
      <h1>Performance <span class="hv-pill" aria-hidden="true"><img src="/assets/d2c/unboxing.jpg" alt="" width="220" height="120" /></span> marketing that survives the <em>P&amp;L.</em></h1>
      <p class="hv-hero__sub">Media, creative, retention and technology run by one senior team, measured on contribution margin, not on the dashboard screenshot.</p>
      <div class="hv-hero__cta">
        <button class="btn btn--primary glow-btn" type="button" data-book="home-hero">
          <span class="glow-btn__glow" aria-hidden="true"></span>
          <span class="glow-btn__inner">Book a strategy call<span class="arrow"></span></span>
        </button>
        <a class="btn btn--link" href="#work">See the work<span class="arrow"></span></a>
      </div>
    </div>
    <div class="hs-visual">
      <div class="hs-diagram" role="img" aria-label="Strategy, content, technology and growth connected in one loop around the MMC mark: the brief becomes the ad, the ad becomes the page, the page becomes the order, and what we learn feeds the next brief.">
        <span class="hs-ring hs-ring--in" aria-hidden="true"></span>
        <span class="hs-ring hs-ring--out" aria-hidden="true"></span>
        <span class="hs-core" aria-hidden="true">
          <span class="hs-core__glow"></span>
          <span class="hs-core__ripple"></span>
          <span class="hs-core__ripple hs-core__ripple--2"></span>
          <span class="hs-core__badge"><img src="/assets/logo-mark.png" alt="" width="56" height="50" /></span>
        </span>
        <i class="hs-pk hs-pk--c" aria-hidden="true"></i>
        <i class="hs-pk hs-pk--b" aria-hidden="true"></i>
        <i class="hs-pk hs-pk--a" aria-hidden="true"></i>
        <i class="hs-pk hs-pk--lead" aria-hidden="true"></i>
        {NODES.map((n, i) => (
          <div class={`hs-node hs-node--${i}`} aria-hidden="true">
            <div class="hs-card">
              <span class="hs-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={n.icon} /></span>
              <span class="hs-txt"><b>{n.t}</b><small>{n.s}</small></span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Pause the loop while the hero is off-screen or the tab is hidden.
  const hero = document.querySelector<HTMLElement>("[data-hs-hero]");
  if (hero) {
    let onScreen = true;
    const sync = () => hero.classList.toggle("is-paused", !onScreen || document.hidden);
    if ("IntersectionObserver" in window) {
      new IntersectionObserver((es) => { onScreen = es[es.length - 1].isIntersecting; sync(); }, { threshold: 0.05 }).observe(hero);
    }
    document.addEventListener("visibilitychange", sync);
  }
</script>
