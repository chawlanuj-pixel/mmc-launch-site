---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Shell from "../../components/Shell.astro";
import PageFx from "../../components/pages/PageFx.astro";
import ToolExplainer from "../../components/shared/ToolExplainer.astro";
import PreFooterCta from "../../components/shared/PreFooterCta.astro";
import StickyBookingBar from "../../components/shared/StickyBookingBar.astro";
import { TOOL_CLOSINGS } from "../../lib/prefooter";
import "../../styles/tools.css";
import { metaHead } from "../../lib/metaHead";
import { UnitEconomics } from "../../islands/tools/UnitEconomics.jsx";
---
<BaseLayout {...metaHead("tools__unit-economics", "/tools/unit-economics/")}>
  <Shell>
    <main id="main" tabindex="-1" class="app-main"><UnitEconomics client:load />
      <ToolExplainer slug="unit-economics" />
      <PreFooterCta source="tool-unit-economics" eyebrow="Next step" {...TOOL_CLOSINGS["unit-economics"]} />
    </main>
    <StickyBookingBar source="tool-unit-economics" />
  </Shell>
  <PageFx />
</BaseLayout>
