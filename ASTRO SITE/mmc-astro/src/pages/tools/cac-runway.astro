---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Shell from "../../components/Shell.astro";
import PageFx from "../../components/pages/PageFx.astro";
import PreFooterCta from "../../components/shared/PreFooterCta.astro";
import StickyBookingBar from "../../components/shared/StickyBookingBar.astro";
import { TOOL_CLOSINGS } from "../../lib/prefooter";
import "../../styles/tools.css";
import { metaHead } from "../../lib/metaHead";
import { CacRunway } from "../../islands/tools/CacRunway.jsx";
---
<BaseLayout {...metaHead("tools__cac-runway", "/tools/cac-runway/")}>
  <Shell>
    <main id="main" tabindex="-1" class="app-main"><CacRunway client:load />
      <PreFooterCta source="tool-cac-runway" eyebrow="Next step" {...TOOL_CLOSINGS["cac-runway"]} />
    </main>
    <StickyBookingBar source="tool-cac-runway" />
  </Shell>
  <PageFx />
</BaseLayout>
