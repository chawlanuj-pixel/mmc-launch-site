---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Shell from "../../components/Shell.astro";
import PageFx from "../../components/pages/PageFx.astro";
import ToolExplainer from "../../components/shared/ToolExplainer.astro";
import PreFooterCta from "../../components/shared/PreFooterCta.astro";
import StickyBookingBar from "../../components/shared/StickyBookingBar.astro";
import { TOOL_CLOSINGS } from "../../lib/prefooter";
import "../../styles/tools.css";
import { metaHead } from "../../lib/metaHead";
import { BreakevenRoas } from "../../islands/tools/BreakevenRoas.jsx";
---
<BaseLayout {...metaHead("tools__breakeven-roas", "/tools/breakeven-roas/")}>
  <Shell>
    <main id="main" tabindex="-1" class="app-main"><BreakevenRoas client:load />
      <ToolExplainer slug="breakeven-roas" />
      <PreFooterCta source="tool-breakeven-roas" eyebrow="Next step" {...TOOL_CLOSINGS["breakeven-roas"]} />
    </main>
    <StickyBookingBar source="tool-breakeven-roas" />
  </Shell>
  <PageFx />
</BaseLayout>
