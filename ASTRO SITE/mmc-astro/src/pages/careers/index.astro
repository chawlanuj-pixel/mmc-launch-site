---
// Careers, v3 (October 2026). Its own hero (ink panel beside an edge-to-edge studio photo, with team shortcuts),
// then: how we work (photo rail), open roles (filterable by team), how hiring works (photo steps), fit (ink),
// FAQ, close. Every role fact comes from roles.json via src/lib/roles. Styles: src/styles/careers3.css (cr3-).
// Previous version: tools/backup/about-careers-20261012/careers-index.astro.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Shell from "../../components/Shell.astro";
import PageFx from "../../components/pages/PageFx.astro";
import Img from "../../components/hub/Img.astro";
import Arrow from "../../components/hub/Arrow.astro";
import Faq from "../../components/hub/Faq.astro";
import { fixDeep } from "../../lib/links";
import { roles, stepsFor, processFaq, roleCount, MODE } from "../../lib/roles";
import { SECONDARY } from "../../lib/site";
import PreFooterCta from "../../components/shared/PreFooterCta.astro";
import StickyBookingBar from "../../components/shared/StickyBookingBar.astro";
import "../../styles/careers3.css";

const SITE = "https://www.mondaymarketing.company";
const title = "Careers at MMC | Marketing Jobs in Mumbai and Indore";
const description = "Open roles at MMC across performance, creative, strategy and technology for D2C, B2B and education brands. Apply with your CV and a short note.";
const TAG: Record<string, string> = { performance: "Performance", creative: "Creative", strategy: "Strategy", technology: "Technology" };
const TEAMS = Object.keys(TAG).map((id) => ({ id, name: TAG[id], n: roles.filter((r) => r.discipline === id).length })).filter((t) => t.n > 0);

const WHY = [
  ["No account-manager layer.", "The person doing the work talks to the client. Strategists own the relationship.", "contact/call.jpg", "A strategist on the phone with a client, laptop and notes open"],
  ["Own verticals, not tasks.", "We do not hand out projects, we hand out P&Ls. You carry the outcome, not just the task list.", "company/strategy.jpg", "Two people at a round table working through a plan"],
  ["Write your own brief.", "Every senior here is expected to ship a brief unprompted in their first 90 days.", "contact/brief.jpg", "Someone writing a brief on a laptop at a studio desk"],
  ["Early enough to shape it.", "The person who joins next helps decide how this place works, not just what it ships.", "company/whiteboard.jpg", "Three people shaping a plan together at a whiteboard"],
];

const STEPS = stepsFor("careersPage");

const NOT_FOR = [
  ["You want a defined lane", "The lane changes. Some weeks you will do work that is not yours."],
  ["You need a manager to unblock you", "There is no manager layer. You decide, ship, and tell us afterwards."],
  ["You want a big-company benefits sheet", "We do not have one, and we would rather say so than list things we cannot back."],
  ["You are waiting for process to arrive", "You would be the person writing it. That is the job, not a phase before the job."],
];
const GOOD_FIT = [
  ["You have done the work yourself", "Not managed someone doing it. The person with the plan also builds it."],
  ["You want the client in the room", "You will be on the call, owning the number, without anyone translating for you."],
  ["You would rather own an outcome than a task", "We hand out P&Ls. You will carry several, and all of the result."],
  ["You want a say in what this becomes", "The shape of the company is still an open question."],
];

const FAQ = [
  { q: "Do I need a resume?", a: "Yes. Apply with your CV (a file or a link) and a short note: what you would own, what you would change in the first ninety days, and what you need from us. Without a CV we cannot process the application." },
  { q: "What is the hiring process?", a: processFaq() },
  { q: "Is the work test paid?", a: "Yes. We pay for the piece of work either way." },
  { q: "Where will I work?", a: "MMC works from Mumbai and Indore. Each role page states its location and whether it is onsite, hybrid or remote." },
  { q: "What if my role is not listed?", a: "Write the role yourself. Send your CV and a short note saying what you would own and what you would change in ninety days, using the button on this page." },
  { q: "Which kinds of brands would I work on?", a: "D2C brands, B2B companies and educational institutes. D2C is where we go deepest. See <a href=\"Our Work.html\">a few of the brands we work with</a>." },
];
const FAQF = fixDeep(FAQ);

const jsonld = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "@id": SITE + "/careers/#breadcrumb", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE + "/" },
    { "@type": "ListItem", position: 2, name: "Careers", item: SITE + "/careers/" } ] },
  { "@context": "https://schema.org", "@type": "CollectionPage", "@id": SITE + "/careers/#webpage", url: SITE + "/careers/", name: title, description,
    isPartOf: { "@id": SITE + "/#website" }, breadcrumb: { "@id": SITE + "/careers/#breadcrumb" }, publisher: { "@id": SITE + "/#organization" },
    mainEntity: { "@id": SITE + "/careers/#open-roles" }, inLanguage: "en" },
  { "@context": "https://schema.org", "@type": "ItemList", "@id": SITE + "/careers/#open-roles", name: "Open roles at Monday Marketing Company", url: SITE + "/careers/",
    numberOfItems: roles.length, itemListOrder: "https://schema.org/ItemListUnordered",
    itemListElement: roles.map((r, i) => ({ "@type": "ListItem", position: i + 1, name: r.title, url: SITE + "/careers/" + r.slug + "/" })) },
  { "@context": "https://schema.org", "@type": "FAQPage", "@id": SITE + "/careers/#faq", mainEntity: FAQ.map((f) => ({ "@type": "Question", name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") } })) },
];
---
<BaseLayout title={title} description={description} path="/careers/" ogTitle="People who write their own briefs" ogDescription="Open roles across performance, creative, strategy and technology. Apply with your CV and a short note." ogAlt="Careers at Monday Marketing Company." jsonld={jsonld}>
  <Shell footerCta={{ nav: true, label: "View open roles", href: "/careers/#roles" }}>
    <main id="main" tabindex="-1" class="app-main n-app cr3">

      <!-- 1. Hero: ink panel + studio photo, team shortcuts -->
      <section class="cr3-hero" id="top" aria-labelledby="cr3-h1">
        <div class="cr3-hero__panel">
          <div class="cr3-hero__in">
            <nav class="cr3-crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Careers</span></nav>
            <p class="cr3-hero__kicker"><span aria-hidden="true"></span>Careers at MMC · Mumbai and Indore, with a few roles remote</p>
            <h1 class="cr3-hero__h1" id="cr3-h1">People who write <em>their own</em> briefs.</h1>
            <p class="cr3-hero__sub">We hire senior people and hand them ownership. Roles across performance, creative, strategy and technology. Apply with your CV and a short note.</p>
            <div class="cr3-hero__act">
              <a class="btn btn--primary glow-btn" href="#roles"><span class="glow-btn__glow" aria-hidden="true"></span><span class="glow-btn__inner">{SECONDARY.roles}<span class="arrow"></span></span></a>
              <button class="btn btn--link cr3-hero__pitch" type="button" onclick="window.mmcOpenBrief(event)">Or pitch us your own role<span class="arrow"></span></button>
            </div>
            <div class="cr3-hero__teams">
              <p><b>{String(roleCount).padStart(2, "0")}</b> roles open now, by team</p>
              <ul>
                {TEAMS.map((t) => (
                  <li><a href={"#roles"} data-team={t.id}><span>{t.name}</span><i>{t.n}</i></a></li>
                ))}
              </ul>
            </div>
          </div>
        </div>
        <figure class="cr3-hero__fig">
          <img src="/assets/careers2/studio-wide.jpg" alt="A team at a long studio table mid-review, laptops open and a whiteboard of plans behind them" width="1400" height="940" loading="eager" fetchpriority="high" decoding="async" />
          <figcaption><i aria-hidden="true"></i>The studio, mid-review.</figcaption>
        </figure>
      </section>

      <!-- 2. How we work: four glimpses -->
      <section class="n-band n-band--white cr3-why" id="why" aria-labelledby="cr3-why-h">
        <div class="n-wrap">
          <div class="cr3-head cr3-head--split n-rise">
            <div>
              <span class="n-eyebrow">How we work</span>
              <h2 class="n-h2" id="cr3-why-h">Four things you would feel <span class="n-serif">in your first month.</span></h2>
            </div>
            <p class="n-lede">MMC hires senior people across performance, creative, strategy and technology, and gives them ownership from day one.</p>
          </div>
          <ol class="cr3-why__rail n-rise d1" tabindex="0" aria-label="How we work, four points">
            {WHY.map((b, k) => (
              <li class="cr3-why__item">
                <figure><Img name={b[2]} ratio="4 / 5" alt={b[3]} /></figure>
                <span class="cr3-why__n" aria-hidden="true">{String(k + 1).padStart(2, "0")}</span>
                <h3>{b[0]}</h3>
                <p>{b[1]}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- 3. Open roles, filterable by team -->
      <section class="n-band n-band--paper cr3-roles" id="roles" aria-labelledby="cr3-roles-h">
        <div class="n-wrap">
          <div class="cr3-head cr3-head--split n-rise">
            <div>
              <span class="n-eyebrow">Open roles</span>
              <h2 class="n-h2" id="cr3-roles-h">Where we are <span class="n-serif">hiring.</span></h2>
            </div>
            <p class="n-lede">Each role has its own page with the details and an application form.</p>
          </div>

          <div class="cr3-filter" role="group" aria-label="Filter roles by team">
            <button type="button" aria-pressed="true" data-filter="all">All teams <i>{roleCount}</i></button>
            {TEAMS.map((t) => <button type="button" aria-pressed="false" data-filter={t.id}>{t.name} <i>{t.n}</i></button>)}
          </div>
          <p class="cr3-filter__status" aria-live="polite" id="cr3-status">Showing all {roleCount} roles</p>

          <ul class="cr3-list">
            {roles.map((r) => (
              <li class="cr3-row" data-team={r.discipline}>
                <a href={"/careers/" + r.slug + "/"}>
                  <span class="cr3-row__pic"><Img name={r.img} ratio="3 / 2" /></span>
                  <span class="cr3-row__main">
                    <span class="cr3-row__tag">{TAG[r.discipline]}</span>
                    <h3>{r.title}</h3>
                    <span class="cr3-row__hint">{r.hint}</span>
                  </span>
                  <span class="cr3-row__facts">
                    <span><b>Location</b>{r.location}{MODE[r.workMode] && !r.location.toLowerCase().includes(MODE[r.workMode].toLowerCase()) ? ", " + MODE[r.workMode].toLowerCase() : ""}</span>
                    <span><b>Experience</b>{r.band}</span>
                  </span>
                  <span class="cr3-row__go"><span class="cr3-sr">View the role</span><Arrow /></span>
                </a>
              </li>
            ))}
          </ul>

          <div class="cr3-own n-rise">
            <figure><Img name="careers2/brief-review.jpg" ratio="3 / 2" alt="Two people reading a one-page brief together at a desk" /></figure>
            <div>
              <h3>Not listed? Write the role yourself.</h3>
              <p>Send your CV and a short note: what you would own, what you would change in the first ninety days, and what you need from us.</p>
              <button type="button" class="btn btn--ghost cr3-own__btn" onclick="window.mmcOpenBrief(event)">Pitch us your role<span class="arrow"></span></button>
            </div>
          </div>
        </div>
      </section>

      <!-- 4. How hiring works -->
      <section class="n-band n-band--white cr3-hire" id="hiring" aria-labelledby="cr3-hire-h">
        <div class="n-wrap">
          <div class="cr3-head n-rise">
            <span class="n-eyebrow">How hiring works</span>
            <h2 class="n-h2" id="cr3-hire-h">Four steps. <span class="n-serif">No portal.</span></h2>
            <p class="n-lede">You meet the people you would work with before anyone makes a decision.</p>
          </div>
          <ol class="cr3-steps">
            {STEPS.map((s, k) => (
              <li class={"cr3-step n-rise d" + (k + 1)}>
                <span class="cr3-step__n" aria-hidden="true">{String(k + 1).padStart(2, "0")}</span>
                <figure><Img name={s.img || "company/onepage.jpg"} ratio="4 / 3" /></figure>
                <h3>Step {k + 1}. {s.h}</h3>
                <p>{s.d}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- 5. Fit -->
      <section class="n-band n-band--ink cr3-fit" id="fit" aria-labelledby="cr3-fit-h">
        <div class="n-wrap">
          <div class="cr3-head n-rise">
            <span class="n-eyebrow">Before you apply</span>
            <h2 class="n-h2" id="cr3-fit-h">Small is the job, <span class="n-serif">not a phase.</span></h2>
          </div>
          <div class="cr3-fit__grid n-rise d1">
            <figure class="cr3-fit__fig"><Img name="company/session.jpg" ratio="4 / 5" alt="A small team round one table, laptops and printed creative between them" /></figure>
            <div class="cr3-fit__col cr3-fit__col--yes">
              <h3>You would do well</h3>
              <ul>{GOOD_FIT.map((t) => <li><b>{t[0]}</b><span>{t[1]}</span></li>)}</ul>
            </div>
            <div class="cr3-fit__col cr3-fit__col--no">
              <h3>Will frustrate you</h3>
              <ul>{NOT_FOR.map((t) => <li><b>{t[0]}</b><span>{t[1]}</span></li>)}</ul>
            </div>
          </div>
        </div>
      </section>

      <Faq title={["Questions before", "you apply."]} faq={FAQF} tone="paper" />

      <PreFooterCta source="careers" eyebrow="How to apply" h2a="Your CV and one page." h2b="That is the application."
        lede="Pick a role above and use its form, or write your own. Bring your CV and a short note: what you would own, change in ninety days, and need from us."
        primary={{ label: "Pitch us your role", brief: true }} secondary={{ label: SECONDARY.roles, href: "#roles" }} />

    </main>
    <StickyBookingBar source="careers" mode="roles" />
  </Shell>
  <PageFx />
  <script>
    /* Team filter. Without JS every role shows; with it, the buttons (and the hero team links) narrow the list. */
    const btns = Array.from(document.querySelectorAll<HTMLButtonElement>(".cr3-filter [data-filter]"));
    const rows = Array.from(document.querySelectorAll<HTMLElement>(".cr3-row"));
    const status = document.getElementById("cr3-status");
    const names: Record<string, string> = {};
    btns.forEach((b) => { names[b.dataset.filter || ""] = (b.firstChild?.textContent || "").trim(); });
    const apply = (team: string) => {
      let n = 0;
      rows.forEach((r) => { const on = team === "all" || r.dataset.team === team; r.hidden = !on; if (on) n++; });
      btns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === team)));
      if (status) status.textContent = team === "all" ? `Showing all ${n} roles` : `Showing ${n} ${n === 1 ? "role" : "roles"} in ${names[team] || team}`;
    };
    btns.forEach((b) => b.addEventListener("click", () => apply(b.dataset.filter || "all")));
    document.querySelectorAll<HTMLAnchorElement>(".cr3-hero__teams a[data-team]").forEach((a) =>
      a.addEventListener("click", () => apply(a.dataset.team || "all")));
    const q = new URLSearchParams(location.search).get("team");
    if (q && btns.some((b) => b.dataset.filter === q)) apply(q);
  </script>
</BaseLayout>
