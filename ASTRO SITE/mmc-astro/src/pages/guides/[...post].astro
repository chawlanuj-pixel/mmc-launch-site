---
// /guides/<slug>/ for Command Centre guides (section "guides", Phase 4). A rest route on purpose: it ranks below
// src/pages/guides/[slug].astro, so the four repo guides keep their own template and output; posts-core.mjs refuses a CMS slug
// that equals a repo guide slug. Noindex posts are built (robots noindex) but never listed. No CMS guides: no pages.
import PostPage from "../../components/posts/PostPage.astro";
import { routablePosts, type Post } from "../../lib/posts";

export function getStaticPaths() {
  return routablePosts("guides").map((post) => ({ params: { post: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
---
<PostPage post={post} />
