---
// Main homepage (was the V2b preview). The previous homepage is kept at /home-previous/ (noindex).
// Keeps the client-approved hover-to-project islands (HomeCaps), the nav and the footer.
// New sections: proof hero, "who we work with" band, stacking work cards, platform ribbon,
// four-step process, closing line with the calculators. Styles: home-v2b.css (hv- prefix),
// on top of home4.css (hn- prefix) for the parts it still reuses.
import BaseLayout from "../layouts/BaseLayout.astro";
import Shell from "../components/Shell.astro";
import HeroSystem from "../components/home/HeroSystem.astro";
import Disciplines from "../components/home/Disciplines.astro";
import WorkRail from "../components/home/WorkRail.astro";
import OnCamera from "../components/home/OnCamera.astro";
import AboutStudio from "../components/home/AboutStudio.astro";
import { href } from "../lib/links";
import { pageHead } from "../lib/pagehead";
import { tileBrands, tagsFor, brandName } from "../lib/work";
import { GUIDES } from "../lib/guides";
import "../styles/hub-extra.css";
import "../styles/home4.css";
import "../styles/home-v2b.css";
import "../styles/mobile-home.css"; // phones only (<= 760px); keep this import last


const ICONS: Record<string, string> = {
  d2c: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8h12l1 12H5L6 8z"/><path d="M9 8V7a3 3 0 0 1 6 0v1"/></svg>`,
  b2b: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M3 13h18"/></svg>`,
  edu: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9l10-5 10 5-10 5L2 9z"/><path d="M6 11.5V16c0 1.2 2.7 3 6 3s6-1.8 6-3v-4.5M22 9v6"/></svg>`,
};
const AUDIENCES = [
  { id: "d2c", n: "D2C brands", d: "Ads, creative, conversion and retention for brands that sell direct to shoppers.", s: "Ads, creative and retention for brands that sell direct.", img: "d2c/unboxing.jpg", href: "d2c.html", go: "See D2C work" },
  { id: "b2b", n: "B2B companies", d: "Website, creative and paid media for a purchase that takes longer and involves several people.", s: "Website, creative and paid media for longer buying cycles.", img: "b2b/call.jpg", href: "b2b.html", go: "See B2B work" },
  { id: "edu", n: "Education", d: "Search, landing pages, CRM and follow-up for institutes that earn a family's trust over weeks.", s: "Search, landing pages and CRM for trust-led institutes.", img: "edu/students.jpg", href: "education.html", go: "See education work" },
];



/* Logo copies: /assets/clients/sm/<id>.png, cropped to the mark and resized to 480px wide at most. */
const LOGO_DIM: Record<string, [number, number]> = {"giraffe": [480, 290], "oosh": [480, 274], "sprnt": [427, 300], "awwbaby": [480, 215], "lepure": [480, 269], "notic": [460, 300], "mittiy": [300, 300], "vagakids": [480, 163], "bloom": [472, 300], "skyfling": [480, 178], "nmc": [480, 150], "mvj": [480, 281]};
/* Home tiles: ids come from work-clients.json (home.tiles). Name, label, tags and the case-study link all come from src/lib/work.ts,
   so a brand shows the same everywhere. A tile links (and shows "See the work") only when /work/<id>/ exists. */
const CLIENTS = tileBrands().map((b) => ({ id: b.id, n: b.name, t: b.label, svc: tagsFor(b.id, true), href: b.href }));

/* Recorded videos. Posters and 480p copies live in /assets/voices/. */
const VIDEOS = [
  { id: "giraffe-1", brand: brandName("giraffe"), kind: "D2C" },
  { id: "giraffe-2", brand: brandName("giraffe"), kind: "D2C" },
];


/* Platform marks: the vendors' own artwork, stored in /assets/platforms/ */
/* The stack, in five rows. [file, name, wordmark?]: wordmark logos already carry their name, so no caption. */
const STACK = [
  { label: "Media", items: [["meta.svg", "Meta"], ["google.svg", "Google Ads"], ["amazon-wordmark.svg", "Amazon", true], ["youtube.svg", "YouTube"], ["tiktok.svg", "TikTok"], ["linkedin.svg", "LinkedIn"]] },
  { label: "Quick commerce", items: [["blinkit.svg", "Blinkit"], ["zepto.svg", "Zepto", true], ["swiggy.png", "Instamart"]] },
  { label: "Commerce and checkout", items: [["shopify.svg", "Shopify"], ["gokwik.png", "GoKwik"], ["shopflo.png", "Shopflo"], ["razorpay.svg", "Razorpay"]] },
  { label: "Retention and CRM", items: [["klaviyo.png", "Klaviyo", true], ["moengage.png", "MoEngage"], ["whatsapp.svg", "WhatsApp"]] },
  { label: "Measurement", items: [["ga4.svg", "GA4"], ["tableau.png", "Tableau"], ["adobe.svg", "Adobe"], ["mixpanel.svg", "Mixpanel"]] },
];

/* Steps: same copy as the live process section. */
const STEPS = [
  { n: "01", t: "We dig", d: "A full read of the account, the funnel and the cost sheet before anyone touches a budget.", w: "Week 1", img: "/assets/rt/data.jpg" },
  { n: "02", t: "We model", d: "Unit economics first: break-even ROAS, CAC ceiling, payback. The plan has to survive the maths.", w: "Week 1 to 2", img: "/assets/ux/test.jpg" },
  { n: "03", t: "We ship", d: "Creative, media and site changes go live together, because they only work together.", w: "Week 2 to 4", img: "/assets/d2c/packing.jpg" },
  { n: "04", t: "We compound", d: "Weekly optimisation against contribution, monthly against the P&L. We're measured on staying.", w: "Month 2 onward", img: "/assets/home2/hero-main.jpg" },
];

/* Calculator lines: the copy already used on the D2C page. No figures. */
const NUMBERS = [
  { big: "CM3", t: "Unit economics", d: "What one order leaves behind.", href: "/tools/unit-economics/" },
  { big: "ROAS", t: "Break-even ROAS", d: "The ROAS you need to break even.", href: "/tools/breakeven-roas/" },
  { big: "CAC", t: "CAC runway", d: "How long a new brand burns cash.", href: "/tools/cac-runway/" },
  { big: "LTV:CAC", t: "LTV:CAC", d: "What a customer is worth, and when you recover it.", href: "/tools/ltv-cac/" },
];
/* Latest insights: real published guides, not invented blog posts or dates (same copy as home-v2). */
const INSIGHT_ORDER = ["attribution-overlap", "contribution-margin-roas", "creative-testing"];
const INSIGHTS = INSIGHT_ORDER.map((slug) => GUIDES.find((g) => g.slug === slug)!).map((g) => ({ title: g.short, d: g.desc, href: g.href, img: g.img }));
const arrow = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;

const SITE = "https://www.mondaymarketing.company";
const TITLE = "MMC: Growth Partner for D2C, B2B and Education | India";
const DESC = "Monday Marketing Company is an India-based growth partner for D2C, B2B and education brands. Paid media, creative, retention and websites, measured on profit.";
const OG_DESC = "One senior team for D2C, B2B and education. Media, creative, retention and websites, measured on profit.";

const head = pageHead("home", "/");
const jsonld: any[] = JSON.parse(JSON.stringify(head.jsonld));
const org = jsonld.find((b) => b["@type"] === "Organization");
if (org) {
  org.description = "Monday Marketing Company is an India-based growth partner for D2C brands, B2B companies and educational institutes. Paid media, creative, retention and websites, measured on profit.";
  delete org.numberOfEmployees;
}
const wp = jsonld.find((b) => b["@type"] === "WebPage");
if (wp) { wp.name = TITLE; wp.description = DESC; }
if (!jsonld.some((b) => b["@type"] === "ProfessionalService") && org) {
  jsonld.push({
    "@context": "https://schema.org", "@type": "ProfessionalService", "@id": SITE + "/#service",
    name: "Monday Marketing Company", url: SITE + "/", image: SITE + "/assets/og-card.jpg",
    description: "Paid media, creative, retention marketing and websites for D2C brands, B2B companies and educational institutes.",
    address: org.address, telephone: org.telephone, email: org.email, areaServed: org.areaServed,
    parent: { "@id": SITE + "/#organization" }, provider: { "@id": SITE + "/#organization" },
  });
}


---
<BaseLayout title={TITLE} description={DESC} path="/" ogTitle={head.ogTitle} ogDescription={OG_DESC} ogAlt={head.ogAlt} jsonld={jsonld}>
  <script is:inline src="/assets/mmc-popularity.js"></script>
  <Shell>
    <main id="main" tabindex="-1" class="app-main hn hv">

      <div class="hn-mcta">
        <button type="button" class="btn btn--primary glow-btn" data-book="home-sticky-mobile">
          <span class="glow-btn__glow" aria-hidden="true"></span>
          <span class="glow-btn__inner">Book a strategy call<span class="arrow"></span></span>
        </button>
      </div>

      <HeroSystem />

      <section class="hv-clients no-section-bg" id="clients" aria-label="A few of the brands we work with">
        <div class="hn-wrap">
          <div class="hv-head hv-head--row">
            <div>
              <p class="hn-eyebrow">A few of the brands we work with</p>
              <h2>What we've built for the brands <em>that trust us.</em></h2>
              <p class="hv-head__p"><span class="p-l">Websites, ads, creative and lead generation, run for D2C brands, B2B companies and education. Here is what we run for each of them.</span><span class="p-s">Websites, ads, creative and lead generation for each brand.</span></p>
            </div>
            <a class="hn-work__all" href={href("Our Work.html")}>See every project<Fragment set:html={arrow} /></a>
          </div>
          <!-- BRAND PAGER: four tiles at a time on desktop, a page every few seconds until someone touches it, then manual. Every tile stays reachable by arrows, dots, swipe and Tab. -->
          <div class="hv-cl" data-cl>
            <div class="hv-cl__vp" data-cl-vp role="region" aria-label="Brands we work with, use the arrows or swipe">
              <ul class="hv-cl__list">
                {CLIENTS.map((c, i) => (
                  <li>
                    {c.href ? (
                      <a class="hv-client" href={c.href}>
                        <span class="hv-client__logo"><img src={`/assets/clients/sm/${c.id}.png`} alt={c.n} loading={i < 4 ? "eager" : "lazy"} decoding="async" width={LOGO_DIM[c.id][0]} height={LOGO_DIM[c.id][1]} /></span>
                        <span class="hv-client__meta"><b>{c.n}</b><i>{c.t}</i></span>
                        <span class="hv-client__tags">{c.svc.map((x) => <span>{x}</span>)}</span>
                        <span class="hv-client__go">See the work<Fragment set:html={arrow} /></span>
                      </a>
                    ) : (
                      <div class="hv-client" style="cursor:default;transform:none">
                        <span class="hv-client__logo"><img src={`/assets/clients/sm/${c.id}.png`} alt={c.n} loading={i < 4 ? "eager" : "lazy"} decoding="async" width={LOGO_DIM[c.id][0]} height={LOGO_DIM[c.id][1]} /></span>
                        <span class="hv-client__meta"><b>{c.n}</b><i>{c.t}</i></span>
                        <span class="hv-client__tags">{c.svc.map((x) => <span>{x}</span>)}</span>
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </div>
            <div class="hv-cl__ctl">
              <span class="hv-cl__bar" aria-hidden="true"><i data-cl-bar></i></span>
              <span class="hv-cl__dots" data-cl-dots></span>
              <button type="button" class="hv-cl__btn" data-cl-prev aria-label="Previous brands"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
              <button type="button" class="hv-cl__btn" data-cl-next aria-label="Next brands"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
            </div>
          </div>
        </div>
      </section>

      <!-- TOOLS: one straight ribbon of the vendors' own marks, a slim band of its own right after the clients. -->
      <section class="hv-plat no-section-bg" id="tools" aria-label="Platforms we run">
        <div class="hv-plat__in">
          <div class="hn-wrap hv-plat__head">
            <h2>We don't just advise on the stack. <em>We run it.</em></h2>
            <p>Media, quick commerce, checkout, retention and measurement, set up and run by one team.</p>
          </div>
          <div class="hn-wrap hv-stack" data-stack>
            <div class="hv-stack__tabs" role="tablist" aria-label="Stack categories">
              {STACK.map((r, i) => <button type="button" role="tab" class="hv-stack__tab" aria-selected={i === 0 ? "true" : "false"} data-stack-tab={i}>{r.label}</button>)}
            </div>
            {STACK.map((r, i) => {
              const reps = Math.ceil(12 / r.items.length);
              const seq = Array.from({ length: reps }, () => r.items).flat();
              return (
                <div class={"hv-stack__row" + (i % 2 ? " is-rev" : "") + (i === 0 ? " is-on" : "")} data-stack-row={i}>
                  <p class="hv-stack__label">{r.label}</p>
                  <div class="hv-stack__ribbon">
                    <ul class="hv-stack__track" style={`--hv-dur:${Math.round(seq.length * 5)}s`}>
                      {[0, 1].map((c) => seq.map(([f, n, w]) => (
                        <li class={"hv-stack__chip" + (w ? " is-word" : "")} aria-hidden={c ? "true" : undefined}>
                          <img src={"/assets/platforms/" + f} alt={c ? "" : n} height="30" loading="lazy" decoding="async" />
                          {!w && <b>{n}</b>}
                        </li>
                      )))}
                    </ul>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>

      <script is:inline>
        (function () {
          var root = document.querySelector("[data-stack]"); if (!root) return;
          var tabs = root.querySelectorAll("[data-stack-tab]"), rows = root.querySelectorAll("[data-stack-row]");
          tabs.forEach(function (t) { t.addEventListener("click", function () {
            var n = t.getAttribute("data-stack-tab");
            tabs.forEach(function (x) { x.setAttribute("aria-selected", x === t ? "true" : "false"); });
            rows.forEach(function (r) { r.classList.toggle("is-on", r.getAttribute("data-stack-row") === n); });
          }); });
        })();
      </script>

      <AboutStudio />

      <!-- WHO WE WORK WITH: one sun band, three doors. D2C is the widest, none is the only one. -->
      <section class="hv-who no-section-bg" id="who">
        <div class="hn-wrap">
          <div class="hv-head">
            <p class="hn-eyebrow">Who we work with</p>
            <h2>Three kinds of business, <em>one way of working.</em></h2>
          </div>
          <div class="hv-who__grid">
            {AUDIENCES.map((a) => (
              <a class={"hv-who__card hv-who__card--" + a.id} href={href(a.href)}>
                <span class="hv-who__pic"><img src={"/assets/" + a.img} alt="" loading="lazy" decoding="async" width="720" height="540" /></span>
                <span class="hv-who__body">
                  <span class="hv-who__hd"><span class="hv-who__ic" aria-hidden="true"><Fragment set:html={ICONS[a.id]} /></span><b>{a.n}</b></span>
                  <span class="hv-who__d"><span class="p-l">{a.d}</span><span class="p-s">{a.s}</span></span>
                  <span class="hv-who__go">{a.go}<Fragment set:html={arrow} /></span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <Disciplines />

      <WorkRail />

      <OnCamera />

      <!-- LATEST INSIGHTS: three real guides, image-led, a compact band that never exceeds one screen. -->
      <section class="hv-ins no-section-bg" id="insights">
        <div class="hn-wrap">
          <div class="hv-ins__top">
            <div>
              <p class="hn-eyebrow">Guides &amp; tools</p>
              <h2><b>Latest</b> insights, <em>plainly put.</em></h2>
            </div>
            <div class="hv-ins__side">
              <p>Margin, ROAS and attribution, explained without the jargon.</p>
              <a class="hn-work__all" href="/guides/">See all guides<Fragment set:html={arrow} /></a>
            </div>
          </div>
          <div class="hv-ins__row">
            {INSIGHTS.map((n) => (
              <a class="hv-ins__card" href={n.href}>
                <span class="hv-ins__shot"><img src={n.img} alt="" loading="lazy" decoding="async" width="700" height="460" /></span>
                <span class="hv-ins__body">
                  <span class="hv-ins__tag">Guide</span>
                  <h3>{n.title}</h3>
                  <p>{n.d}</p>
                  <span class="hv-ins__go">Read the guide<span class="hv-ins__chip" aria-hidden="true"><Fragment set:html={arrow} /></span></span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- PROCESS: four steps, a picture each. -->
      <section class="hv-proc no-section-bg" id="process">
        <div class="hn-wrap">
          <div class="hv-head">
            <p class="hn-eyebrow">How it works</p>
            <h2>Four weeks to a <em>working engine.</em></h2>
            <p class="hv-head__p"><span class="p-l">No three-month discovery. The model is built in week one, because everything after it depends on knowing what an order is actually worth.</span><span class="p-s">No three-month discovery: the model is built in week one.</span></p>
          </div>
          <ol class="hv-proc__row">
            {STEPS.map((s) => (
              <li class="hv-proc__card">
                <span class="hv-proc__pic"><img src={s.img} alt="" loading="lazy" decoding="async" width="640" height="420" /></span>
                <span class="hv-proc__meta"><b>{s.n}</b><i>{s.w}</i></span>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- CLOSING: one large line and the booking action. -->
      <section class="hv-close no-section-bg" id="close">
        <div class="hn-wrap hv-close__in">
          <div>
            <p class="hn-eyebrow" style="color:var(--n-sun)">Ready when you are</p>
            <h2>Let's find out what a customer is <em>actually worth.</em></h2>
            <p><span class="p-l">Thirty minutes with a senior strategist. No deck, no pitch, a direct read on the three things to fix first.</span><span class="p-s">Thirty minutes with a senior strategist. No deck, no pitch.</span></p>
          </div>
          <div class="hv-close__cta">
            <button type="button" class="btn btn--primary glow-btn" data-book="home-final">
              <span class="glow-btn__glow" aria-hidden="true"></span>
              <span class="glow-btn__inner">Book a strategy call<span class="arrow"></span></span>
            </button>
            <a class="btn btn--link" href={href("tools.html")}>Run the numbers yourself<span class="arrow"></span></a>
          </div>
        </div>
        <div class="hn-wrap hv-close__tools">
          <p class="hn-eyebrow" style="color:var(--n-sun)">The numbers we start with</p>
          <p class="hv-close__tl">Know these four before you <em>spend another rupee.</em></p>
          <div class="hv-num__grid">
            {NUMBERS.map((n) => (
              <a class="hv-num__card" href={n.href}>
                <span class="hv-num__big">{n.big}</span>
                <b>{n.t}</b>
                <span class="hv-num__d">{n.d}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

    </main>
  </Shell>
  <script>import "../scripts/hub.ts";</script>
  <script is:inline>
    (function () {
      var deck = document.querySelector("[data-deck]");
      if (!deck) return;
      var track = deck.querySelector("[data-deck-track]");
      var cards = [].slice.call(track.children);
      var bar = deck.querySelector("[data-deck-bar]");
      var raf = 0;
      function step() { var c = cards[1] ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth; return c || track.clientWidth; }
      function paint() {
        raf = 0;
        var mid = track.scrollLeft + track.clientWidth / 2;
        cards.forEach(function (c) {
          var w = c.offsetWidth || 1;
          var d = Math.min(1, Math.abs((c.offsetLeft + w / 2) - mid) / w);
          c.style.setProperty("--d", d.toFixed(3));
        });
        var max = track.scrollWidth - track.clientWidth;
        bar.style.width = (8 + 92 * (max > 0 ? track.scrollLeft / max : 1)).toFixed(1) + "%";
        deck.querySelector("[data-deck-prev]").disabled = track.scrollLeft < 4;
        deck.querySelector("[data-deck-next]").disabled = track.scrollLeft > max - 4;
      }
      function go(dir) { track.scrollBy({ left: dir * step(), behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" }); }
      track.addEventListener("scroll", function () { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
      window.addEventListener("resize", paint);
      deck.querySelector("[data-deck-prev]").addEventListener("click", function () { go(-1); });
      deck.querySelector("[data-deck-next]").addEventListener("click", function () { go(1); });
      track.addEventListener("keydown", function (e) { if (e.key === "ArrowRight") { e.preventDefault(); go(1); } else if (e.key === "ArrowLeft") { e.preventDefault(); go(-1); } });
      paint();
    })();
  </script>
  <script is:inline>
    (function () {
      var cl = document.querySelector("[data-cl]");
      if (!cl) return;
      var vp = cl.querySelector("[data-cl-vp]");
      var tiles = [].slice.call(vp.querySelectorAll("li"));
      var prev = cl.querySelector("[data-cl-prev]"), next = cl.querySelector("[data-cl-next]");
      var dotsEl = cl.querySelector("[data-cl-dots]"), bar = cl.querySelector("[data-cl-bar]");
      var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      var n = 1, pages = 1, dots = [], timer = 0, paused = false, done = reduce || !matchMedia("(hover: hover)").matches, inView = false, raf = 0;
      function padL() { return parseFloat(getComputedStyle(vp).paddingLeft) || 0; }
      function stride() { return tiles[1].offsetLeft - tiles[0].offsetLeft; }
      function maxLeft() { return vp.scrollWidth - vp.clientWidth; }
      function measure() {
        var gap = stride() - tiles[0].offsetWidth;
        var content = vp.clientWidth - padL() * 2;
        n = Math.max(1, Math.floor((content + gap) / stride() + 0.02));
        pages = Math.ceil(tiles.length / n);
        if (dots.length !== pages) {
          dotsEl.textContent = "";
          dots = [];
          for (var i = 0; i < pages; i++) (function (i) {
            var b = document.createElement("button");
            b.type = "button"; b.className = "hv-cl__dot"; b.setAttribute("aria-label", "Show group " + (i + 1)); b.innerHTML = "<i></i>";
            b.addEventListener("click", function () { stop(); goto(i); });
            dotsEl.appendChild(b); dots.push(b);
          })(i);
        }
      }
      function page() { var m = maxLeft(); if (m > 0 && vp.scrollLeft >= m - 4) return pages - 1; return Math.min(pages - 1, Math.round(vp.scrollLeft / (n * stride()))); }
      function goto(p) {
        p = Math.max(0, Math.min(pages - 1, p));
        vp.scrollTo({ left: Math.min(maxLeft(), tiles[Math.min(tiles.length - 1, p * n)].offsetLeft - padL()), behavior: reduce ? "auto" : "smooth" });
      }
      function paint() {
        raf = 0;
        var p = page(), m = maxLeft();
