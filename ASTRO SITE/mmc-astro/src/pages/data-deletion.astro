---
import BaseLayout from "../layouts/BaseLayout.astro";
import Shell from "../components/Shell.astro";
import "../styles/hub-extra.css";
import "../styles/contact-new.css";

const title = "Delete your data | Monday Marketing Company";
const description = "How to ask Monday Marketing Company to delete the personal details you gave us through our website or through a Facebook or Instagram lead form.";
---
<BaseLayout title={title} description={description} path="/data-deletion/">
  <Shell>
    <main id="main" tabindex="-1" class="app-main n-app">
      <section class="n-band n-band--paper">
        <div class="n-wrap dd" style="max-width:760px">
          <span class="n-eyebrow">Your data</span>
          <h1 class="n-h2">How to ask us to delete your data</h1>
          <p>If you gave us your details through our website, or through a lead form on Facebook or Instagram, you can ask us to delete them at any time.</p>

          <h2 class="n-h3">How to ask</h2>
          <p>Email <a href="mailto:privacy@mondaymarketing.company?subject=Delete%20my%20data">privacy@mondaymarketing.company</a> with the subject "Delete my data". Please write from the email address, or include the phone number, that you gave us, so we can find your records. If you used a Facebook or Instagram lead form, tell us the name of the Page or advert if you remember it.</p>

          <h2 class="n-h3">What we do</h2>
          <ul>
            <li>We confirm your request by email within 3 working days.</li>
            <li>We delete your contact details, your enquiry and the notes and history we hold about you from our systems within 30 days.</li>
            <li>We stop sharing details about you with advertising platforms. Where a platform holds a copy we sent, you can also remove it through your own Facebook or Google account settings.</li>
            <li>We may keep a minimal record that a request was made and completed, and anything the law requires us to keep.</li>
          </ul>

          <h2 class="n-h3">More</h2>
          <p>Our <a href="/privacy/">privacy policy</a> explains what we collect and why. If you are not happy with how we handle your request, tell us and we will put it right.</p>
        </div>
      </section>
    </main>
  </Shell>
</BaseLayout>

<style>
  /* Links read as links (the article link style), and the heading gets room before the first paragraph. */
  .dd h1 { margin-bottom: 20px; }
  .dd a { color: var(--n-blue, #1D4ED8); text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .dd a:hover { text-decoration-thickness: 2.5px; }
</style>
