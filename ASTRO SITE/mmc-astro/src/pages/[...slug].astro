---
import BaseLayout from "../layouts/BaseLayout.astro";
import Shell from "../components/Shell.astro";
import Hero from "../components/hub/Hero.astro";
import Answer from "../components/hub/Answer.astro";
import Article from "../components/hub/Article.astro";
import Stages from "../components/hub/Stages.astro";
import LoopB from "../components/hub/LoopB.astro";
import Numbers from "../components/hub/Numbers.astro";
import BrandTiles from "../components/shared/BrandTiles.astro";
import WhoFor from "../components/shared/WhoFor.astro";
import PlatformShowcase from "../components/shared/PlatformShowcase.astro";
import Beyond from "../components/hub/Beyond.astro";
import AiVersion from "../components/hub/AiVersion.astro";
import Breadcrumb from "../components/shared/Breadcrumb.astro";
import CtaBand from "../components/shared/CtaBand.astro";
import NumberedGrid from "../components/hub/NumberedGrid.astro";
import WhyUs from "../components/hub/WhyUs.astro";
import ProcessAccordion from "../components/hub/ProcessAccordion.astro";
import TestimonialSlider from "../components/shared/TestimonialSlider.astro";
import Faq from "../components/hub/Faq.astro";
import FreeToolsStrip from "../components/shared/FreeToolsStrip.astro";
import { TOOLS_FOR } from "../lib/site";
import PreFooterCta from "../components/shared/PreFooterCta.astro";
import LinkStrip from "../components/shared/LinkStrip.astro";
import { guidesFor } from "../lib/links-map";
import StickyBookingBar from "../components/shared/StickyBookingBar.astro";
import AnswerSpread from "../components/svc2/AnswerSpread.astro";
import PinnedWork from "../components/svc2/PinnedWork.astro";
import LeakDiagram from "../components/svc2/LeakDiagram.astro";
import Proof from "../components/svc2/Proof.astro";
import First90Days from "../components/svc2/First90Days.astro";
import FitAndQuestions from "../components/svc2/FitAndQuestions.astro";
import Close from "../components/svc2/Close.astro";
import "../styles/hub-extra.css";
import "../styles/svc2.css";
import { fixDeep } from "../lib/links";
import { rewriteJsonld } from "../lib/hub";
import { GUIDES } from "../lib/guides";
import { closingFor } from "../lib/prefooter";
import { proofRows } from "../lib/proof";
import AudienceHub from "../components/hubs2/AudienceHub.astro";
import IndustriesHub from "../components/hubs2/IndustriesHub.astro";
import { audienceFromHub } from "../components/hubs2/model";
import { isWhiteLabel, WL_TOOLS_KEY, whiteLabelJsonld, whiteLabelGroups, agencyTwin } from "../lib/whitelabel";

export async function getStaticPaths() {
  const mods = import.meta.glob("../data/hubs/*.json", { eager: true, import: "default" }) as Record<string, any>;
  // /guides/ has its own page file (src/pages/guides/index.astro); skip it here so the two routes do not collide.
  return Object.values(mods).filter((d) => d.path !== "/guides/").map((d) => ({
    params: { slug: d.path.replace(/^\/|\/$/g, "") },
    props: { d },
  }));
}
const { d } = Astro.props;
const H = fixDeep(d.hub);
const updated: string = d.updated || "2026-10-09";
// /guides/ card names come from the one guide catalogue (src/lib/guides.ts), never from this JSON.
if (H.key === "guides" && Array.isArray(H.stages)) {
  H.stages = H.stages.map((st: any) => { const g = GUIDES.find((x) => String(st.href).includes(x.slug)); return g ? { ...st, tag: g.short, href: g.href, img: st.img } : st; });
}
// White-label pages (src/lib/whitelabel.ts): agency areaServed and audience on Service nodes, no D2C tools or guides, agency close.
const WL = isWhiteLabel(d.path);
const jsonld = WL ? whiteLabelJsonld(rewriteJsonld(d.jsonld, updated)) : rewriteJsonld(d.jsonld, updated);
const seg = d.path.replace(/^\/|\/$/g, "").split("/");
const toolsKey = WL ? WL_TOOLS_KEY : seg[0] === "industries" ? "industries-" + seg[1] : seg[seg.length - 1];
// Redesigned 7-section layout (src/components/svc2). A page uses it when src/data/svc2/<hub path with __>.json exists; otherwise the classic template renders.
const svc2 = import.meta.glob("../data/svc2/*.json", { eager: true, import: "default" }) as Record<string, any>;
const S2 = Object.entries(svc2).find(([k]) => k.endsWith("/" + seg.join("__") + ".json"))?.[1];
// Closing band. White-label pages: optional svc2 `close.final` { eyebrow?, h2a, h2b, lede, button?: { label, href }, link?: { label, href } }
// for an agency close the copywriter writes; until it is filled in, the page's own hub `cta` (already agency-facing) is used, as before.
const F = WL && S2?.close?.final && S2.close.final.h2a && S2.close.final.h2b && S2.close.final.lede ? S2.close.final : undefined;
const C = F ? { ...closingFor(H.key, { h2a: F.h2a, h2b: F.h2b, lede: F.lede }), ...(F.eyebrow ? { eyebrow: F.eyebrow } : {}), ...(F.link !== undefined ? { secondary: F.link } : {}) } : closingFor(H.key, H.cta);
// A custom button must be a link (label + href); the booking button keeps the one site-wide booking label.
const primary = F?.button?.label && F?.button?.href ? { label: F.button.label, href: F.button.href } : undefined;
// White-label hub: its children in TABLE-C groups (body links). Direct service pages: the "Are you an agency?" twin link.
const wlGroups = WL && d.path === "/white-label/" ? whiteLabelGroups() : [];
const twin = agencyTwin(d.path);
// Hub-page family (src/components/hubs2, hubs2.css). A page uses it when src/data/hubs2/<hub path with __>.json exists;
// remove that file and the classic template below renders again. Title, meta, JSON-LD, FAQ and CTA still come from the hub JSON.
const hubs2 = import.meta.glob("../data/hubs2/*.json", { eager: true, import: "default" }) as Record<string, any>;
const X2 = S2 ? undefined : Object.entries(hubs2).find(([k]) => k.endsWith("/" + seg.join("__") + ".json"))?.[1];
// The brand tiles only render when at least one client carries this service; the hero "See the work" link must agree (#proof, else /work/).
const hasProof = !!H.proof && proofRows(H.proof).length > 0;
const hasTools = !!TOOLS_FOR[toolsKey];
const guideCards = (H.key === "guides" || H.key === "resources" || H.key === "industries") ? [] : guidesFor(toolsKey).map((g) => ({ title: g.short, meta: g.tag, text: g.desc, href: g.href, go: "Read the guide" }));
---
<BaseLayout title={d.title} description={d.description} path={d.path} ogTitle={d.ogTitle} ogDescription={d.ogDescription} ogAlt={d.ogAlt} jsonld={jsonld} preloadImage={X2 ? (X2.kind === "industries" ? X2.doors[0].img : (X2.hero.img.startsWith("/") ? X2.hero.img : "/assets/" + X2.hero.img)) : H.tiles?.[0]?.img ? "/assets/" + H.tiles[0].img : undefined}>
  <Shell>
    <main id="main" tabindex="-1" class={"app-main n-app" + (S2 ? " s2" : "") + (X2 ? " h2-page" : "")}>
      {X2 ? (
        X2.kind === "industries" ? <IndustriesHub H={H} X={X2} jsonld={jsonld} /> : <AudienceHub M={audienceFromHub(H, X2, jsonld)} />
      ) : (
      <Fragment>
      <Hero H={H} proof={hasProof} />
      {S2 ? (
        <Fragment>
          <AnswerSpread H={H} S={S2} jsonld={jsonld} updated={updated} source={H.key} />
          <PinnedWork S={S2} />
          <LeakDiagram H={H} S={S2} />
          <Proof H={H} S={S2} />
          <First90Days H={H} S={S2} />
          <FitAndQuestions H={H} S={S2} agency={twin} />
          <Close H={H} S={S2} source={H.key} toolsKey={toolsKey} groups={wlGroups} />
        </Fragment>
      ) : (
        <Fragment>
        <Breadcrumb jsonld={jsonld} />
        <Answer {...H.answer} />
        <Article A={H.article} updated={updated} />
        {H.platform ? <PlatformShowcase kind={H.platform} /> : null}
        <NumberedGrid G={H.grid} />
        <Stages L={H.leaks} S={H.stages} hubKey={H.key} />
        <WhyUs W={H.why} />
        {H.loop ? <LoopB H={H} /> : null}
        <Numbers N={H.numbers} />
        <ProcessAccordion A={H.accordion} P={H.process} fallbackImg={H.why?.img || H.answer?.image} fallbackAlt={H.process ? H.process.h2a + " " + H.process.h2b : ""} />
        {H.who ? <WhoFor {...H.who} tone="paper" /> : null}
        {hasProof ? <BrandTiles {...H.proof} tone="white" /> : null}
        <TestimonialSlider />
        <Beyond Y={H.beyond} tone="paper" />
        <AiVersion slug={seg[seg.length - 1]} />
        <Faq title={H.faqTitle} faq={H.faq} tone="white" />
        <CtaBand source={H.key} img={H.tiles?.[0]?.img} alt="" />
        {TOOLS_FOR[toolsKey] && <FreeToolsStrip page={toolsKey} bg="paper" />}
        <LinkStrip id="read-the-method" eyebrow="Read the method" h1="Guides behind" h2="the numbers." cards={guideCards} bg={hasTools ? "paper" : "white"} all={{ href: "/guides/", label: "All guides" }} />
        </Fragment>
      )}
      <PreFooterCta source={H.key} h2a={C.h2a} h2b={C.h2b} lede={C.lede} eyebrow={C.eyebrow} secondary={C.secondary} primary={primary} />
      </Fragment>
      )}
    </main>
    <StickyBookingBar source={H.key} />
  </Shell>
  <script>import "../scripts/hub.ts";</script>
  {S2 && <script>import "../scripts/svc2.ts";</script>}
</BaseLayout>
