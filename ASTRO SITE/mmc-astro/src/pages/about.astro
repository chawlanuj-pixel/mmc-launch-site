---
// About, v3 (October 2026). Its own editorial hero (paper ground, oversized type, edge-to-edge studio photo), then
// a short sequence: why we exist (a vendor diagram), the five systems (sticky photo), how the work runs (three
// photo steps on ink), what we believe (photo quote + type list), audiences, the studio, FAQ, close.
// Styles: src/styles/about3.css (prefix ab3-). Previous version: tools/backup/about-careers-20261012/about.astro.
import BaseLayout from "../layouts/BaseLayout.astro";
import Shell from "../components/Shell.astro";
import AudienceCards from "../components/company/AudienceCards.astro";
import { BOOK, SECONDARY } from "../lib/site";
import PageFx from "../components/pages/PageFx.astro";
import FreeToolsStrip from "../components/shared/FreeToolsStrip.astro";
import PreFooterCta from "../components/shared/PreFooterCta.astro";
import StickyBookingBar from "../components/shared/StickyBookingBar.astro";
import { fixDeep, href } from "../lib/links";
import { rewriteJsonld } from "../lib/hub";
import Faq from "../components/hub/Faq.astro";
import "../styles/about3.css";
import { AGENCY_LINE, agencyTwin } from "../lib/whitelabel";
const agency = agencyTwin("/about/")!;

const SITE = "https://www.mondaymarketing.company";
const title = "About Monday Marketing Company | Mumbai, India";
const description = "MMC is an India-based growth partner for D2C, B2B and education brands, in content and media since 2015. One senior team, measured on contribution margin.";

const ARR = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>';

const CRAFTS = ["Design", "Marketing", "Technology", "Content", "AI"];

/* The five pieces most brands buy from five different vendors. Left: apart. Right: one team. */
const VENDORS = ["Media buying", "Creative", "Website", "Retention", "Brand"];

const SYSTEMS = [
  { k: "Performance media", img: "company/performance.jpg", alt: "A media buyer at two monitors reading campaign dashboards", p: "Meta, Google, Amazon and quick commerce run as one account structure, budgeted against contribution margin rather than platform ROAS.", href: "performance-marketing.html", link: "Performance marketing" },
  { k: "Creative and UGC", img: "sv/content.jpg", alt: "A creator filming a product video in front of a ring light", p: "Creator content, performance edits, statics and landing-page copy, written against a single brand thesis.", href: "ugc-and-video.html", link: "UGC and video" },
  { k: "Retention and follow-up", img: "services/retention.jpg", alt: "A shopper reading a brand's follow-up message on a phone", p: "Email, WhatsApp and loyalty, built on the reason customers come back.", href: "retention-marketing.html", link: "Retention marketing" },
  { k: "Conversion and technology", img: "sv/tech.jpg", alt: "A storefront open on a laptop and a phone beside a code editor", p: "Shopify builds, checkout, site speed and conversion rate optimisation, so the media has somewhere good to land.", href: "conversion-rate-optimisation.html", link: "Conversion rate optimisation" },
  { k: "Brand and packaging", img: "sv/brand.jpg", alt: "Packaging boxes, jars and logo sketches spread across a desk", p: "Identity, packaging and design systems that everything else is built on.", href: "branding.html", link: "Branding" },
];

const METHOD = [
  { h: "A free audit, not a pitch.", d: "The first step is a call where a senior strategist reads your ad accounts against your break-even ROAS.", img: "about2/callscreen.jpg", alt: "A senior strategist walking a client through a growth chart on a video call" },
  { h: "One senior team.", d: "Media, creative, retention and technology run under one strategist and one P&L. The person doing the work talks to you.", img: "company/session.jpg", alt: "A small team around one table, laptops and printed creative spread between them" },
  { h: "Judged on contribution margin.", d: "Profit left after variable costs, not the platform dashboard.", img: "about2/desk-open.jpg", alt: "A desk with a laptop open to a campaign performance sheet, a notebook of next steps and a cup of chai" },
];

const BELIEFS = [
  ["Ideas matter more than designations.", "Anyone can bring the idea that changes the plan."],
  ["Execution matters more than noise.", "Shipping the work beats looking busy."],
  ["Speed beats hierarchy.", "Fewer layers between the person with the plan and the person who builds it."],
  ["Honesty over polish.", "If the numbers say a plan is not working, we say so."],
  ["Build for the next ten years.", "Quick spikes are exciting. Sustainable growth is worth more."],
];

const FAQ = [
  { q: "What is Monday Marketing Company?", a: "Monday Marketing Company (MMC) is an India-based growth partner for D2C, B2B and education brands, in content and media since 2015, a full-service growth agency since 2020, and based in Mumbai and Indore. It is led by D2C performance marketing." },
  { q: "What are the connected systems?", a: "Performance media, creative and UGC, retention and follow-up, conversion and technology, and brand and packaging. They are run by one senior team under one strategist and one P&amp;L, rather than by five separate vendors." },
  { q: "Who does MMC work with?", a: "D2C brands, B2B companies and educational institutes. D2C is where we go deepest, but the work is not D2C only. Tell us what you run and we will say which approach fits." },
  { q: "What does measured on contribution margin mean?", a: "Contribution margin is the profit left after variable costs. We budget and judge media against it, not against platform ROAS alone, because a platform can report a healthy ROAS on an order that loses money. <a href=\"guide-contribution-margin-roas.html\">Read the guide</a>." },
  { q: "Where is MMC based?", a: "Mumbai and Indore, India. You can reach us through the <a href=\"Contact.html\">contact page</a>." },
  { q: "How do we start?", a: "With a free paid-media audit: a call where a senior strategist reads your ad accounts against your break-even ROAS. <a href=\"audit.html\">See how it works</a>." },
  { q: "Does MMC publish pricing or client results?", a: "No. Cost depends on scope and, for media, on ad spend, so we quote after the audit call. We list the services we run for each brand but do not publish per-client results." },
];
const FAQF = fixDeep(FAQ);

const jsonld = rewriteJsonld([
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "@id": SITE + "/about/#breadcrumb", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE + "/" },
    { "@type": "ListItem", position: 2, name: "About", item: SITE + "/about/" } ] },
  { "@context": "https://schema.org", "@type": "AboutPage", "@id": SITE + "/about/#webpage", url: SITE + "/about/", name: title, description,
    isPartOf: { "@id": SITE + "/#website" }, breadcrumb: { "@id": SITE + "/about/#breadcrumb" }, publisher: { "@id": SITE + "/#organization" },
    about: { "@id": SITE + "/#organization" }, mainEntity: { "@id": SITE + "/#organization" }, inLanguage: "en" },
  { "@context": "https://schema.org", "@type": "FAQPage", "@id": SITE + "/about/#faq", mainEntity: FAQ.map((f) => ({ "@type": "Question", name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "").replace(/&amp;/g, "&") } })) },
]);
---
<BaseLayout title={title} description={description} path="/about/" ogTitle="About Monday Marketing Company" ogDescription="An India-based growth partner for D2C, B2B and education brands. Connected systems, one senior team." ogAlt="Monday Marketing Company: about the agency." jsonld={jsonld}>
  <Shell>
    <main id="main" tabindex="-1" class="app-main n-app ab3">

      <!-- 1. Hero: oversized type on paper, then the studio edge to edge -->
      <section class="ab3-hero" id="top" aria-labelledby="ab3-h1">
        <div class="n-wrap">
          <nav class="ab3-crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">About</span></nav>
          <p class="ab3-hero__kicker">
            <span class="ab3-hero__dot" aria-hidden="true"></span>About Monday Marketing Company
          </p>
          <h1 class="ab3-hero__h1" id="ab3-h1">
            <span class="ab3-line">A growth partner measured</span>
            <span class="ab3-line d2">the way <em>your business</em></span>
            <span class="ab3-line d3">is measured.</span>
          </h1>
          <div class="ab3-hero__row">
            <div class="ab3-hero__lead">
              <p>Monday Marketing Company runs media, creative, retention, conversion and brand as connected systems, for D2C brands, B2B companies and educational institutes, under one senior team.</p>
              <div class="ab3-hero__act">
                <button type="button" class="btn btn--primary glow-btn" onclick="window.mmcBookCall('about-hero', event)"><span class="glow-btn__glow" aria-hidden="true"></span><span class="glow-btn__inner">{BOOK}<span class="arrow"></span></span></button>
                <a class="btn btn--link" href="/work/">{SECONDARY.work}<span class="arrow"></span></a>
              </div>
            </div>
            <ul class="ab3-crafts" aria-label="What we combine">
              {CRAFTS.map((c, k) => <li>{c}{k < CRAFTS.length - 1 && <i aria-hidden="true">×</i>}</li>)}
            </ul>
          </div>
        </div>
        <figure class="ab3-hero__fig">
          <img src="/assets/about2/huddle.jpg" alt="Two people at a whiteboard walking through a marketing funnel diagram together" width="1200" height="806" loading="eager" fetchpriority="high" decoding="async" />
          <figcaption class="ab3-hero__facts">
            <span><b>Since</b> 2015</span>
            <span><b>Based in</b> Mumbai and Indore</span>
            <span><b>Works with</b> D2C, B2B and education</span>
          </figcaption>
        </figure>
      </section>

      <!-- 2. Why we exist: five vendors apart vs one team -->
      <section class="n-band n-band--white ab3-why" id="why" aria-labelledby="ab3-why-h">
        <div class="n-wrap ab3-why__grid">
          <div class="ab3-why__copy n-rise">
            <span class="n-eyebrow">Why we exist</span>
            <h2 class="n-h2" id="ab3-why-h">A coordination problem, <span class="n-serif">not a marketing problem.</span></h2>
            <p class="ab3-p">Most growing brands do not lack marketing. They lack coordination: a media buyer who never speaks to the creative team, a website the performance numbers never reach, a retention email that goes out a week after the launch it should have supported.</p>
            <p class="ab3-p">MMC was built to close that gap. The same team that reads your ad account also briefs your creative, rebuilds your landing page and writes your retention flow, so the work is planned together instead of stitched together after the fact.</p>
          </div>
          <figure class="ab3-diagram n-rise d1" aria-labelledby="ab3-diagram-cap">
            <div class="ab3-diagram__col ab3-diagram__col--apart">
              <span class="ab3-diagram__label">Five vendors</span>
              <ul>{VENDORS.map((v) => <li><span>{v}</span><i aria-hidden="true"></i></li>)}</ul>
              <span class="ab3-diagram__foot">Five briefs, five reports, nobody owns the margin</span>
            </div>
            <div class="ab3-diagram__col ab3-diagram__col--one">
              <span class="ab3-diagram__label">One MMC team</span>
              <div class="ab3-diagram__hub">
                <ul>{VENDORS.map((v) => <li><span>{v}</span></li>)}</ul>
                <span class="ab3-diagram__core" aria-hidden="true"><b>One P&amp;L</b></span>
              </div>
              <span class="ab3-diagram__foot">One plan, one strategist, one number</span>
            </div>
            <figcaption id="ab3-diagram-cap" class="ab3-cap">The same five jobs, run apart and run together.</figcaption>
          </figure>
        </div>
      </section>

      <!-- 3. The five systems: sticky photo, rows swap it -->
      <section class="n-band n-band--paper ab3-sys" id="systems" aria-labelledby="ab3-sys-h">
        <div class="n-wrap">
          <div class="ab3-head n-rise">
            <span class="n-eyebrow">How it works</span>
            <h2 class="n-h2" id="ab3-sys-h">One senior team, <span class="n-serif">every system.</span></h2>
            <p class="n-lede">Each system does one job. Because the same senior team runs every system, the media, the creative, the site and the follow-up are planned as one thing rather than reported on separately.</p>
          </div>
          <div class="ab3-sys__grid">
            <div class="ab3-sys__stage" aria-hidden="true">
              {SYSTEMS.map((s, k) => (
                <img class={k === 0 ? "is-on" : ""} data-k={k} src={"/assets/" + s.img} alt="" width="1200" height="806" loading="lazy" decoding="async" />
              ))}
              <span class="ab3-sys__count"><b data-sys-n>01</b> / {String(SYSTEMS.length).padStart(2, "0")}</span>
            </div>
            <ol class="ab3-sys__list">
              {SYSTEMS.map((s, k) => (
                <li class={"ab3-sys__row" + (k === 0 ? " is-on" : "")} data-k={k}>
                  <figure class="ab3-sys__pic"><img src={"/assets/" + s.img} alt={s.alt} width="1200" height="806" loading="lazy" decoding="async" /></figure>
                  <span class="ab3-sys__n">{String(k + 1).padStart(2, "0")}</span>
                  <div class="ab3-sys__body">
                    <h3>{s.k}</h3>
                    <p>{s.p}</p>
                    <a class="ab3-go" href={href(s.href)}>{s.link}<Fragment set:html={ARR} /></a>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <!-- 4. How the work runs: three photo steps on ink -->
      <section class="n-band n-band--ink ab3-method" id="practice" aria-labelledby="ab3-method-h">
        <div class="n-wrap">
          <div class="ab3-head ab3-head--split n-rise">
            <div>
              <span class="n-eyebrow">What it is like to work with us</span>
              <h2 class="n-h2" id="ab3-method-h">Your numbers <span class="n-serif">on screen first.</span></h2>
            </div>
            <a class="ab3-go ab3-go--dark" href={href("audit.html")}>{SECONDARY.audit}<Fragment set:html={ARR} /></a>
          </div>
          <ol class="ab3-method__list">
            {METHOD.map((m, k) => (
              <li class={"ab3-step n-rise d" + (k + 1)}>
                <figure><img src={"/assets/" + m.img} alt={m.alt} width="1200" height="806" loading="lazy" decoding="async" /></figure>
                <span class="ab3-step__n" aria-hidden="true">{String(k + 1).padStart(2, "0")}</span>
                <h3>{m.h}</h3>
                <p>{m.d}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- 5. What we believe: photo quote, then the list as type -->
      <section class="ab3-beliefs" id="principles" aria-labelledby="ab3-bel-h">
        <figure class="ab3-quote">
          <img src="/assets/company/whiteboard.jpg" alt="Three people planning a campaign on a whiteboard" width="1200" height="806" loading="lazy" decoding="async" />
          <div class="ab3-quote__wrap"><div class="n-wrap"><blockquote>Ideas matter more <em>than designations.</em></blockquote></div></div>
        </figure>
        <div class="n-band n-band--white ab3-beliefs__band">
          <div class="n-wrap ab3-beliefs__grid">
            <div class="ab3-beliefs__head n-rise">
              <span class="n-eyebrow">What we believe</span>
              <h2 class="n-h2" id="ab3-bel-h">Things we would put <span class="n-serif">on the wall.</span></h2>
              <a class="ab3-go" href={href("services.html")}>See every service<Fragment set:html={ARR} /></a>
            </div>
            <ol class="ab3-beliefs__list n-rise d1">
              {BELIEFS.map((b, k) => (
                <li><b aria-hidden="true">{String(k + 1).padStart(2, "0")}</b><strong>{b[0]}</strong><span>{b[1]}</span></li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <!-- 6. Who we work with -->
      <section class="n-band n-band--paper ab3-aud" id="who" aria-labelledby="ab3-aud-h">
        <div class="n-wrap">
          <div class="ab3-head n-rise">
            <span class="n-eyebrow">Who we work with</span>
            <h2 class="n-h2" id="ab3-aud-h">Three kinds of brand, <span class="n-serif">one way of working.</span></h2>
            <p class="n-lede">Lead generation for a college and performance media for a D2C brand look different day to day. The senior team, the audit-first start and the measure against contribution margin or cost per qualified lead stay the same.</p>
            <p class="ab3-p ab3-p--agency">{AGENCY_LINE.lead} {AGENCY_LINE.see} <a class="ab3-go" href={agency.href}>{agency.anchor}<Fragment set:html={ARR} /></a></p>
          </div>
          <AudienceCards />
        </div>
      </section>

      <!-- 7. The studio -->
      <section class="n-band n-band--white ab3-studio" id="studio" aria-labelledby="ab3-studio-h">
        <div class="n-wrap ab3-studio__grid">
          <div class="ab3-studio__copy n-rise">
            <span class="n-eyebrow">The studio</span>
            <h2 class="n-h2" id="ab3-studio-h">Media first, <span class="n-serif">based in Mumbai and Indore.</span></h2>
            <p class="ab3-p">The team works from Mumbai and Indore, with some roles remote across India. Strategy, media, creative and technology sit at the same table, which is most of the point.</p>
            <address class="ab3-studio__addr">
              <span>Monday Marketing Company</span>
              <span>WeWork Zenia, Hiranandani Business Park, Thane 400607</span>
            </address>
            <div class="ab3-studio__links">
              <a class="ab3-go" href={href("Contact.html")}>Visit or write to us<Fragment set:html={ARR} /></a>
              <a class="ab3-go" href="/careers/">Work with us<Fragment set:html={ARR} /></a>
            </div>
          </div>
          <div class="ab3-studio__mosaic n-rise d1">
            <figure class="ab3-studio__a"><img src="/assets/contact/office.jpg" alt="A glass office building among palm trees in a business park" width="1200" height="806" loading="lazy" decoding="async" /></figure>
            <figure class="ab3-studio__b"><img src="/assets/contact/meeting.jpg" alt="Three people leaning over a printed plan on a studio table" width="1200" height="806" loading="lazy" decoding="async" /></figure>
            <figure class="ab3-studio__c"><img src="/assets/careers2/desk-close.jpg" alt="A laptop with design work open on a desk beside a notebook and phone" width="1200" height="806" loading="lazy" decoding="async" /></figure>
          </div>
        </div>
      </section>

      <Faq title={["Questions about", "MMC."]} faq={FAQF} tone="paper" />

      <FreeToolsStrip slugs={["unit-economics", "breakeven-roas", "ltv-cac"]} bg="white" />
      <PreFooterCta source="about" h2a="See what a senior team" h2b="reads in your numbers."
        lede="On a call, with a senior strategist. We show what your first 30 days would look like and who works on your account." />

    </main>
    <StickyBookingBar source="about" />
  </Shell>
  <PageFx />
  <script>
    /* Systems: the row nearest the middle of the screen (or the one hovered / focused) lights its photo in the sticky frame. */
    const list = document.querySelector<HTMLElement>(".ab3-sys__list");
    const stage = document.querySelector<HTMLElement>(".ab3-sys__stage");
    if (list && stage) {
      const rows = Array.from(list.querySelectorAll<HTMLElement>(".ab3-sys__row"));
      const imgs = Array.from(stage.querySelectorAll<HTMLElement>("img"));
      const num = stage.querySelector<HTMLElement>("[data-sys-n]");
      let cur = 0;
      const set = (k: number) => {
        if (k === cur) return;
        cur = k;
        rows.forEach((r, i) => r.classList.toggle("is-on", i === k));
        imgs.forEach((im, i) => im.classList.toggle("is-on", i === k));
        if (num) num.textContent = String(k + 1).padStart(2, "0");
      };
      rows.forEach((r, i) => {
        r.addEventListener("pointerenter", () => set(i));
        r.addEventListener("focusin", () => set(i));
      });
      const wide = window.matchMedia("(min-width: 961px)");
      const onScroll = () => {
        if (!wide.matches) return;
        const mid = window.innerHeight * 0.5;
        let best = cur, bestD = Infinity;
        rows.forEach((r, i) => { const b = r.getBoundingClientRect(); const d = Math.abs(b.top + b.height / 2 - mid); if (d < bestD) { bestD = d; best = i; } });
        set(best);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
    }
  </script>
  <style is:global>
    /* "Are you an agency?" line: the link flows inside the sentence at the sentence's size, so a phone wraps the words instead of
       dropping the whole link under "See". Vertical padding keeps a tall hit area without changing the line height. */
    .ab3-p--agency .ab3-go { display: inline; min-height: 0; padding-block: 12px; font-size: inherit; font-weight: 700; }
    .ab3-p--agency .ab3-go svg { display: inline-block; vertical-align: -1px; margin-left: 6px; }
  </style>
</BaseLayout>
