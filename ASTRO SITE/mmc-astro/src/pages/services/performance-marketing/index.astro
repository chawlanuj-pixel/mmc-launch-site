---
// /services/performance-marketing/: the paid-media hub on the hubs2 pattern (src/components/hubs2). Meta, Google, Amazon
// and quick commerce, each with its real mark, an honest line on when to use it and a link to its own page; the
// attribution figure; the calculators; creative; real work. Previous version: tools/backup/performance-marketing-index.astro.before-hubs2.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Shell from "../../../components/Shell.astro";
import PageFx from "../../../components/pages/PageFx.astro";
import PreFooterCta from "../../../components/shared/PreFooterCta.astro";
import StickyBookingBar from "../../../components/shared/StickyBookingBar.astro";
import Faq from "../../../components/hub/Faq.astro";
import Crumb from "../../../components/hubs2/Crumb.astro";
import Lede from "../../../components/hubs2/Lede.astro";
import Pic from "../../../components/hubs2/Pic.astro";
import Calcs from "../../../components/hubs2/Calcs.astro";
import WorkTiles from "../../../components/hubs2/WorkTiles.astro";
import Fx from "../../../components/hubs2/Fx.astro";
import { pageHead } from "../../../lib/pagehead";
import { href } from "../../../lib/links";
import "../../../styles/hubs2.css";

const base = pageHead("pm", "/services/performance-marketing/");
// The page serves D2C, B2B and education, so the head no longer reads D2C-only (URL unchanged).
const title = "Performance Marketing for D2C, B2B and Education | MMC";
const description = "MMC runs Meta, Google, Amazon and quick-commerce ads for D2C, B2B and education brands in India, judged on contribution margin or qualified leads.";

const FAQ = [
  { q: "What does MMC's performance marketing cover?", a: "Media buying on Meta, Google, Amazon and quick commerce, plus the creative and reporting that go with it, run as one account structure. For D2C brands it is judged on contribution margin; for B2B companies and educational institutes, on qualified leads and enrolments." },
  { q: "Meta, Google, Amazon or quick commerce: what comes first?", a: "Start where your buyers already look for you and where your margin can carry the spend. Google catches people already searching, Meta creates demand, Amazon and quick commerce matter when your buyers shop there. We settle the order in the audit, against your break-even ROAS." },
  { q: "How is success measured?", a: `On contribution margin, and on blended results reconciled to your store data, not on platform-reported ROAS. Break-even ROAS is the floor. It is revenue per order divided by contribution per order, and you can work yours out with the <a href="${href("breakeven-roas-calculator.html")}">free break-even ROAS calculator</a>.` },
  { q: "What does it cost?", a: "It depends on ad spend and scope, so we quote after the audit call, once we have seen your accounts. Your ad spend is paid to the platforms and sits outside our fee." },
  { q: "Do you work with B2B and education brands?", a: `We do. D2C gets the deepest coverage on this page, but we also run paid media as <a href="/services/lead-generation/">lead generation</a> for B2B companies and educational institutes. There the goal is qualified leads and enrolments, not baskets and repeat orders, so the work is set up differently. See the <a href="/industries/b2b/">B2B</a> and <a href="/industries/education/">education</a> pages.` },
  { q: "Is there a minimum commitment?", a: "We agree terms on the audit call, once we know what you need." },
];
const strip = (s: string) => s.replace(/<[^>]+>/g, "");
const jsonld = (base.jsonld as any[]).map((b) => {
  if (!b) return b;
  if (b["@type"] === "FAQPage") return { ...b, mainEntity: FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: strip(f.a) } })) };
  if (b["@type"] === "WebPage") return { ...b, name: title, description };
  if (b["@type"] === "Service") return { ...b, description };
  return b;
});

const QC_MARKS = ["/assets/platforms/blinkit.svg", "/assets/platforms/zepto.svg"];
const TILES = [
  { id: "meta", name: "Meta", mark: "/assets/platforms/meta.svg", img: "pm-v3/channel-meta.jpg", pos: "50% 38%", note: "Reels and feeds", href: href("meta-ads.html"), alt: "A woman on a sofa watching Reels on her phone." },
  { id: "google", name: "Google", mark: "/assets/platforms/google.svg", img: "pm-v3/channel-google.jpg", pos: "60% 50%", note: "Search and Shopping", href: href("google-ads.html"), alt: "A shopper comparing products in Google search results on a laptop." },
  { id: "amazon", name: "Amazon", mark: "/assets/platforms/amazon.svg", img: "pm-v3/channel-amazon.jpg", pos: "50% 50%", note: "Sponsored ads", href: href("amazon-ads.html"), alt: "Two Amazon delivery boxes stacked on a table." },
  { id: "qc", name: "Quick commerce", mark: "/assets/platforms/blinkit.svg", img: "pm-v3/channel-quickcommerce.jpg", pos: "42% 50%", note: "Blinkit, Zepto, Instamart", href: href("quick-commerce-ads.html"), alt: "A Blinkit delivery rider on a scooter in a city street." },
];
const CHANNELS = [
  { id: "meta", name: "Meta Ads", marks: ["/assets/platforms/meta.svg"], img: "meta/structure.jpg", href: href("meta-ads.html"), link: "Meta Ads, in detail",
    when: "You need new demand: people who do not know you yet, reached in Reels and feeds, where the creative does most of the targeting.",
    note: "Illustrative layout of Meta Ads Manager. Not a client account, no real figures. Meta and its logo belong to Meta Platforms." },
  { id: "google", name: "Google Ads", marks: ["/assets/platforms/google.svg"], img: "google/search.jpg", href: href("google-ads.html"), link: "Google Ads, in detail",
    when: "People already search for what you sell. Search and Shopping catch that intent, with your brand search kept apart.",
    note: "Illustrative layout of a Google results page. Not a client account, no real figures. Google and its logo belong to Google LLC." },
  { id: "amazon", name: "Amazon Ads", marks: ["/assets/platforms/amazon.svg"], img: "amazon/ads.jpg", href: href("amazon-ads.html"), link: "Amazon Ads, in detail", work: true,
    when: "Your buyers shop on Amazon. Sponsored ads are planned with your listings and stock, and read against total sales.",
    note: "Illustrative layout of the Amazon Ads console. Not a client account, no real figures. Amazon and its logo belong to Amazon.com, Inc." },
  { id: "qc", name: "Quick commerce ads", marks: QC_MARKS, img: "qc/listing.jpg", href: href("quick-commerce-ads.html"), link: "Quick commerce ads, in detail", work: true,
    when: "Your product is bought in minutes on Blinkit, Zepto or Instamart. Ads only work when the stock is there, so they are planned with availability.",
    note: "Illustrative layouts of the Blinkit and Zepto apps. Not a client account, no real figures. Blinkit, Zepto and their logos belong to their owners." },
];
const CLAIMS = [
  { n: "Meta", mark: "/assets/platforms/meta.svg", how: "Saw the Reel, bought within 7 days of clicking" },
  { n: "Google", mark: "/assets/platforms/google.svg", how: "Searched the brand name, then bought" },
  { n: "Amazon", mark: "/assets/platforms/amazon.svg", how: "Sponsored ad on the way to the same purchase" },
];
const CREATIVE = [
  { img: "ugc/brief.jpg", t: "Brief", d: "One brand thesis, then several angles: the hook, the offer and the proof.", alt: "A team planning ad angles around a table of printed frames." },
  { img: "ugc/shoot.jpg", t: "Shoot", d: "Creator and UGC-style video, founder and product footage, shot to cut into many ads.", alt: "A creator filming a product video on a phone on a tripod." },
  { img: "ugc/edit.jpg", t: "Edit", d: "Hooks, lengths and formats cut from the same footage, plus statics and carousels.", alt: "An editor cutting a vertical video on a desktop screen." },
  { img: "ugc/test.jpg", t: "Test", d: "Angles run against each other on a fixed budget, with a rule agreed for what counts as a winner.", alt: "A creative testing board on a laptop." },
  { img: "ugc/refresh.jpg", t: "Refresh", d: "Creative tires. New versions of the winners go in before results slip.", alt: "A wall of ad creative being refreshed with new versions." },
];
---
<BaseLayout {...base} title={title} description={description} jsonld={jsonld} preloadImage={"/assets/" + TILES[0].img}>
  <Shell>
    <main id="main" tabindex="-1" class="app-main n-app h2-page">
      <section class="h2-plat no-section-bg" id="top">
        <div class="n-wrap">
          <div class="h2-plat__grid">
            <div class="h2-plat__copy">
              <div>
                <Crumb jsonld={jsonld} />
                <span class="n-eyebrow">Performance marketing</span>
              </div>
              <h1 class="h2-h1">Performance marketing that <em>pays back in profit</em>.</h1>
              <p class="h2-sub">Meta, Google, Amazon and quick-commerce media for D2C, B2B and education brands, judged on contribution margin, not on what a platform reports.</p>
              <div class="h2-acts">
                <button type="button" class="btn btn--primary glow-btn" onclick="window.mmcBookCall('pm-hero', event)"><span class="glow-btn__glow" aria-hidden="true"></span><span class="glow-btn__inner">Book a strategy call<span class="arrow"></span></span></button>
                <a class="btn btn--link" href="#numbers">Run the numbers yourself<span class="arrow"></span></a>
              </div>
            </div>
            <div>
              <ul class="h2-plat__tiles" aria-label="Channels we run">
                {TILES.map((t, k) => (
                  <li>
                    <a href={t.href}>
                      <img class="h2-plat__ph" src={"/assets/" + t.img} alt={t.alt} width="1024" height="688" loading={k < 2 ? "eager" : "lazy"} fetchpriority={k === 0 ? "high" : undefined} decoding="async" style={`object-position:${t.pos}`} />
                      <span class="h2-plat__mark"><img src={t.mark} alt="" width="22" height="22" />{t.name}</span>
                      <span class="h2-plat__cap"><span>{t.note}</span><i class="h2-arr" aria-hidden="true"></i></span>
                    </a>
                  </li>
                ))}
              </ul>
              <p class="h2-note">Illustrative scenes. Meta, Google, Amazon, Blinkit and their logos belong to their owners.</p>
            </div>
          </div>
        </div>
      </section>

      <Lede tone="white"
        lead="Performance marketing buys and manages paid media for a brand, then answers for what it returns. MMC runs it across Meta, Google, Amazon and quick commerce, with account structure, creative and reporting managed as one system. The work is judged on contribution margin, the profit left after variable costs, not on what a platform reports."
        hl="answers for what it returns"
        img="au/look-tracking.jpg" alt="Ad platform results checked against store orders on two screens."
        note="Illustrative layouts of Meta Ads Manager and a Shopify orders page. Not a client account, no real figures. Meta and Shopify and their logos belong to their owners."
        points={[
          { title: "Four channels", text: "Meta, Google, Amazon and quick commerce." },
          { title: "One system", text: "Account structure, creative and reporting are run together." },
          { title: "Contribution margin", text: "The measure is the profit left after variable costs." },
        ]} />

      <section class="n-band n-band--paper" id="channels">
        <div class="n-wrap">
          <header class="h2-head h2-head--split h2-rv">
            <span class="n-eyebrow">What we run</span>
            <h2 class="n-h2">Four channels, one <span class="n-serif">account structure.</span></h2>
            <p class="n-lede">Most brands buy these from separate vendors. Here they share a budget, a creative thesis and one definition of a good result. This is when each one earns its place.</p>
          </header>
          <div class="h2-chs">
            {CHANNELS.map((c) => (
              <article class="h2-ch h2-rv" id={"ch-" + c.id}>
                <div class="h2-ch__media">
                  <Pic src={c.img} alt={c.note.split(".")[0] + "."} />
                  <p class="h2-note">{c.note}</p>
                </div>
                <div>
                  <div class="h2-ch__mark">
                    <span class="h2-ch__marks">{c.marks.map((m) => <img src={m} alt="" width="40" height="40" loading="lazy" />)}</span>
                    <h3>{c.name}</h3>
                  </div>
                  <p class="h2-ch__when"><b>Use it when</b>{c.when}</p>
                  <div class="h2-ch__acts">
                    <a class="h2-go" href={c.href}>{c.link}<i></i></a>
                    {c.work && <a class="h2-go" href="/work/giraffe/">We run this for The Growing Giraffe<i></i></a>}
                  </div>
                </div>
              </article>
            ))}
          </div>
          <div class="h2-also h2-rv">
            <Pic src="b2b/capture.jpg" alt="A landing page with a short demo request form on a laptop." />
            <div>
              <p class="h2-label">B2B or education?</p>
              <p>We run paid media as lead generation too, where the goal is qualified leads and enrolments, not baskets. Leads go to your CRM and back to the platforms, so campaigns learn from the leads your team accepts.</p>
              <div class="h2-also__links">
                <a class="h2-go" href="/services/lead-generation/">Lead generation<i></i></a>
                <a class="h2-go" href="/industries/b2b/">B2B companies<i></i></a>
                <a class="h2-go" href="/industries/education/">Educational institutes<i></i></a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="n-band n-band--white" id="claims">
        <div class="n-wrap">
          <header class="h2-head h2-rv">
            <span class="n-eyebrow">Attribution</span>
            <h2 class="n-h2">One order. <span class="n-serif">Three dashboards</span> claim it.</h2>
            <p class="n-lede">A customer sees a Reel, searches your brand and buys. Each platform counts the sale under its own rules, so the dashboards add up to more revenue than you banked.</p>
          </header>
          <figure class="pmc h2-rv" style="margin:0" aria-label="Illustration: three platform dashboards each report the same ₹1,000 order, while the bank shows ₹1,000 once">
            <div class="pmc__claims">
              {CLAIMS.map((c) => (
                <article class="pmc__claim">
                  <div class="pmc__who"><img src={c.mark} alt="" width="28" height="28" loading="lazy" /><b>{c.n} reports</b></div>
                  <div class="pmc__val">₹1,000</div>
                  <div class="pmc__unit">1 purchase</div>
                  <p>{c.how}</p>
                </article>
              ))}
            </div>
            <div class="pmc__join" aria-hidden="true"><span></span><span></span><span></span></div>
            <div class="pmc__sum">
              <div class="pmc__sum-l"><span>Dashboards add up to</span><b class="pmc__over">₹3,000</b></div>
              <span class="pmc__ne" aria-hidden="true">≠</span>
              <div class="pmc__sum-r"><span>Actually in your bank</span><b>₹1,000</b></div>
            </div>
            <figcaption class="pmc__note">Illustration, not a client result. One order, one customer, three attribution windows.</figcaption>
          </figure>
          <div class="pmc__how h2-rv">
            <b>How we handle it</b>
            <p>We judge the account on the total: revenue in your store and bank against total ad spend. Platform numbers are used to compare campaigns inside one platform, not to add up the business. <a class="h2-go" href={href("guide-attribution-overlap.html")}>Read the guide<i></i></a></p>
          </div>
        </div>
      </section>

      <Calcs slugs={["breakeven-roas", "funnel-roas", "unit-economics"]} tone="paper"
        h2a="Know your floor" h2b="before you spend."
        lede="Break-even ROAS is revenue per order divided by contribution per order. Below it, you are paying for revenue instead of profit."
        guide={{ label: "Read the guide to contribution margin", href: href("guide-contribution-margin-roas.html") }} />

      <section class="n-band n-band--white" id="creative">
        <div class="n-wrap">
          <header class="h2-head h2-head--split h2-rv">
            <span class="n-eyebrow">Creative, content and UGC</span>
            <h2 class="n-h2">Creative decides <span class="n-serif">who stops scrolling.</span></h2>
            <p class="n-lede">On Meta, YouTube and quick commerce, the ad itself does most of the targeting and most of the selling. So we run creative as a testing programme, judged on the same contribution margin as the media.</p>
          </header>
          <ol class="h2-film" data-qa-clip>
            {CREATIVE.map((c) => (
              <li class="h2-rv"><Pic src={c.img} alt={c.alt} /><h3>{c.t}</h3><p>{c.d}</p></li>
            ))}
          </ol>
          <div class="h2-film__links h2-rv">
            <a class="h2-go" href={href("guide-creative-testing.html")}>How D2C brands test ad creative<i></i></a>
            <a class="h2-go" href={href("ugc-and-video.html")}>UGC and video production<i></i></a>
            <a class="h2-go" href={href("social-media-creatives.html")}>Social media creatives<i></i></a>
            <a class="h2-go" href={href("influencer-marketing.html")}>Influencer marketing<i></i></a>
          </div>
        </div>
      </section>

      <WorkTiles ids={["giraffe", "mittiy", "awwbaby", "mbb"]} h2a="Paid media and creative" h2b="for brands we work with." tone="paper" />

      <Faq tone="white" title={["Questions about", "performance marketing."]} faq={FAQ} />
      <PreFooterCta source="pm" h2a="Find out what your ad spend" h2b="really returns." lede="On a call, with a senior strategist. We read your accounts against your break-even ROAS and plan the first 30 days." />
    </main>
    <StickyBookingBar source="pm" />
  </Shell>
  <PageFx />
  <Fx />
</BaseLayout>
