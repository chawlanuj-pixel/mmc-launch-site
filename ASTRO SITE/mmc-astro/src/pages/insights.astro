---
// Insights index, built in the homepage's design language: shared blue PageHero, eyebrow + bold/light/italic
// headlines, hv-ins style guide cards, calculators band, final ink band. Styles: styles/insights-v2.css (ix-).
import BaseLayout from "../layouts/BaseLayout.astro";
import Shell from "../components/Shell.astro";
import PageHero from "../components/pages/PageHero.astro";
import PageFx from "../components/pages/PageFx.astro";
import StickyBookingBar from "../components/shared/StickyBookingBar.astro";
import GuideCard from "../components/insights/GuideCard.astro";
import { GUIDES, readTimes } from "../lib/guides";
import { TOOLS, TOOLS_LABEL, SECONDARY } from "../lib/site";
import PreFooterCta from "../components/shared/PreFooterCta.astro";
import "../styles/insights-v2.css";

const title = "Insights: Guides on ROAS, Attribution and Creative | MMC";
const description = "Plain-English guides from Monday Marketing Company on break-even ROAS, ad attribution and creative testing, plus free tools for D2C brands.";
const SITE = "https://www.mondaymarketing.company";

const guides = GUIDES;
const RT = readTimes();
const [featured, ...rest] = guides;
const arrow = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;

const IMG: Record<string, string> = {
  "unit-economics": "/assets/res/unit.jpg", "breakeven-roas": "/assets/res/roas.jpg", "ltv-cac": "/assets/res/ltv.jpg",
  "funnel-roas": "/assets/res/funnel.jpg", "cac-runway": "/assets/res/runway.jpg", "growth-trajectory": "/assets/contact/growth.jpg",
};
const calcs = TOOLS.map((t) => ({ n: t.short, d: t.blurb, href: t.href, img: IMG[t.slug] }));
const services = [
  { h: "Performance marketing", d: "Paid media read against contribution margin, not platform screenshots.", href: "/services/performance-marketing/", img: "/assets/pm-v3/channel-meta.jpg" },
  { h: "UGC and video", d: "Creative made to be tested, in the formats your buyers actually watch.", href: "/services/ugc-and-video/", img: "/assets/ugc/shoot.jpg" },
  { h: "Retention marketing", d: "Turn the first order into the second, with email, WhatsApp and winback flows.", href: "/services/retention-marketing/", img: "/assets/rt/welcome.jpg" },
];
const topicLabels = [["all", "All guides"], ["margin", "Margin and measurement"], ["creative", "Creative"]];


const jsonld = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "@id": SITE + "/insights/#breadcrumb", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE + "/" },
    { "@type": "ListItem", position: 2, name: "Insights", item: SITE + "/insights/" } ] },
  { "@context": "https://schema.org", "@type": "CollectionPage", "@id": SITE + "/insights/#webpage", url: SITE + "/insights/", name: title, description,
    isPartOf: { "@id": SITE + "/#website" }, breadcrumb: { "@id": SITE + "/insights/#breadcrumb" }, publisher: { "@id": SITE + "/#organization" }, inLanguage: "en",
    mainEntity: { "@type": "ItemList", itemListElement: guides.map((g, i) => ({ "@type": "ListItem", position: i + 1, name: g.title, url: SITE + g.href, image: SITE + g.img })) } },
];
---
<BaseLayout title={title} description={description} path="/insights/" ogTitle="Plain guides for clearer marketing decisions" ogDescription="Guides on break-even ROAS, attribution and creative testing, with free tools." ogAlt="Monday Marketing Company: insights and guides." jsonld={jsonld}>
  <Shell>
    <main id="main" tabindex="-1" class="app-main n-app ix">
      <PageHero wm="Insights" eyebrow={"● Guides and " + TOOLS_LABEL.toLowerCase()}
        lines={["Know what an order earns,", "then read your ads", '<span class="em-serif">against it.</span>']}
        sub="Plain-English guides and free tools, each a method you can run on your own numbers. The calculators are built for D2C brands."
        primary={{ label: "Read the first guide", href: featured.href }} secondary={{ label: SECONDARY.numbers, href: "/tools/" }} rightClass="ix-hero__r">
        <div class="ix-tiles">
          {guides.map((g) => (
            <a class="ix-tile" href={g.href} aria-label={g.title}>
              <img src={g.img} alt="" width="480" height="504" loading="eager" decoding="async" />
              <span class="ix-tile__cap"><b>{g.tag}</b><i>{RT[g.slug] + " min read"}</i></span>
            </a>
          ))}
          <a class="ix-tile" href="/tools/" aria-label="D2C calculators">
            <img src="/assets/res/roas.jpg" alt="" width="480" height="504" loading="eager" decoding="async" />
            <span class="ix-tile__cap"><b>D2C calculators</b><i>Run your own numbers</i></span>
          </a>
        </div>
        <p slot="chips" class="ix-proof">Free to read. No email wall. Worked examples are labelled as illustrative.</p>
      </PageHero>

      <section class="ix-band ix-band--white" id="start">
        <div class="n-wrap">
          <div class="ix-head ed-rise">
            <p class="ix-eyebrow">Start here</p>
            <h2 class="ix-h2"><b>Where do you</b> <em>want to start?</em></h2>
            <p class="ix-lede">Pick the question closest to yours. The guides run in order: margin first, then measurement, then creative.</p>
          </div>
          <div class="ix-paths">
            {guides.map((g) => (
              <a class="ix-path ed-rise" href={g.href}>
                <span class="ix-path__n">{g.n}</span>
                <h3>{g.q}</h3>
                <span class="ix-path__g">{g.title}</span>
                <span class="ix-path__t">{"Then try: " + g.tool.label}</span>
                <span class="ix-go">Read the guide<span class="ix-chip" aria-hidden="true"><Fragment set:html={arrow} /></span></span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="ix-band ix-band--paper" id="guides">
        <div class="n-wrap">
          <div class="ix-head ed-rise">
            <p class="ix-eyebrow">Library</p>
            <h2 class="ix-h2"><b>All the guides,</b> <em>in one place.</em></h2>
          </div>
          <ul class="ix-pills ed-rise" aria-label="Filter guides by topic" data-ix-filter>
            {topicLabels.map(([k, l], i) => <li><button type="button" data-f={k} aria-pressed={i === 0 ? "true" : "false"}>{l}</button></li>)}
          </ul>
          <div class="ix-grid" data-ix-grid>
            {guides.map((g) => <GuideCard topic={g.topic} href={g.href} img={g.img} tag={g.tag} title={g.title} d={g.desc} meta={RT[g.slug] + " min read"} />)}
          </div>
        </div>
      </section>

      <section class="ix-band ix-band--white" id="calculators">
        <div class="n-wrap">
          <div class="ix-head ix-head--row ed-rise">
            <div>
              <p class="ix-eyebrow">{TOOLS_LABEL}</p>
              <h2 class="ix-h2"><b>Run the numbers</b> <em>yourself.</em></h2>
              <p class="ix-lede">Six calculators. No email, no signup.</p>
            </div>
            <a class="ix-all" href="/tools/">See all free tools<Fragment set:html={arrow} /></a>
          </div>
          <div class="ix-calcs">
            {calcs.map((c) => (
              <a class="ix-calc ed-rise" href={c.href}>
                <span class="ix-calc__pic"><img src={c.img} alt="" width="400" height="200" loading="lazy" decoding="async" /></span>
                <b>{c.n}</b>
                <span class="ix-calc__d">{c.d}</span>
                <span class="ix-go">Open the calculator<span class="ix-chip" aria-hidden="true"><Fragment set:html={arrow} /></span></span>
              </a>
            ))}
          </div>
          <p class="ix-tail ed-rise">Not sure what a term means? <a href="/glossary/">Open the D2C marketing glossary.</a></p>
        </div>
      </section>

      <section class="ix-band ix-band--paper" id="services">
        <div class="n-wrap">
          <div class="ix-head ed-rise">
            <p class="ix-eyebrow">Work with us</p>
            <h2 class="ix-h2"><b>Want it done</b> <em>with you?</em></h2>
            <p class="ix-lede">The same methods, run by a senior team on your account.</p>
          </div>
          <div class="ix-grid">
            {services.map((v) => <GuideCard href={v.href} img={v.img} tag="Service" title={v.h} d={v.d} go="See the service" />)}
          </div>
          <p class="ix-tail ed-rise">For B2B and education, see <a href="/services/lead-generation/">lead generation</a>, <a href="/industries/b2b/">B2B companies</a> and <a href="/industries/education/">education</a>.</p>
        </div>
      </section>

      <PreFooterCta source="insights" h2a="Bring your numbers." h2b="We will read them with you." lede="On a call, with a senior strategist. We read your campaigns against your margins and plan the first 30 days." secondary={{ label: SECONDARY.numbers, href: "/tools/" }} />
      <StickyBookingBar source="insights" />
    </main>
  </Shell>
  <PageFx />
  <script>import "../scripts/editorial.ts";</script>
  <script is:inline>
    (function () {
      var bar = document.querySelector("[data-ix-filter]"), grid = document.querySelector("[data-ix-grid]");
      if (!bar || !grid) return;
      bar.addEventListener("click", function (e) {
        var b = e.target.closest("button[data-f]"); if (!b) return;
        var f = b.getAttribute("data-f");
        bar.querySelectorAll("button").forEach(function (x) { x.setAttribute("aria-pressed", String(x === b)); });
        grid.querySelectorAll("[data-topic]").forEach(function (c) { c.hidden = !(f === "all" || c.getAttribute("data-topic") === f); });
      });
    })();
  </script>
</BaseLayout>
