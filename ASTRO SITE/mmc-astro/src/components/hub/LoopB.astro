---
import "../../styles/svc-blocks.css";
const { H } = Astro.props;
const L = H.loop;
const SHORT: Record<string, any> = {
  "lead-generation": {
    steps: [["The lead arrives", "A form fill, call or WhatsApp message."], ["Your CRM records what happens", "Qualified, meeting booked, applied, won, enrolled."], ["CAPI sends the stage to Meta", "A server-side event, not a browser guess."], ["Meta learns your best leads", "It can move away from cheap form fills."]],
    back: "The next ads aim at leads like the ones your team accepted",
    without: { t: "Optimised for form fills", pts: ["Meta sees only that a form was filled.", "It tends to find whoever fills a form cheapest.", "Sales or admissions can end up chasing leads that never fit."] },
    with: { t: "Optimised for qualified leads", pts: ["Meta sees which leads your team accepted and won.", "Spend can shift toward buyers like the ones you win.", "The cost of a qualified lead becomes the number to watch."] },
  },
  education: {
    steps: [["The enquiry arrives", "A form fill, call or WhatsApp message."], ["Your CRM records what happens", "Contacted, applied, admitted, enrolled."], ["CAPI sends the stage to Meta", "A server-side event, not a browser guess."], ["Meta learns your best applicants", "It learns from the families who enrolled."]],
    back: "The next ads aim at families like the ones who enrolled",
    without: { t: "Optimised for enquiries", pts: ["Meta sees only that a form was filled.", "It tends to find whoever fills a form cheapest.", "Counsellors can end up chasing families who never apply."] },
    with: { t: "Optimised for applicants", pts: ["Meta sees who applied and who enrolled.", "Spend can shift toward families like those who enrolled.", "The cost of an enrolment becomes the number to watch."] },
  },
  b2b: {
    steps: [["The lead arrives", "A form fill, call or WhatsApp enquiry."], ["Your CRM records what happens", "Qualified, meeting booked, won."], ["CAPI sends the stage to Meta", "A server-side event, not a browser guess."], ["Meta learns your best leads", "It learns from the buyers sales accepted."]],
    back: "The next ads aim at leads like the good ones",
    without: { t: "Optimised for form fills", pts: ["Meta sees only that a form was filled.", "It tends to find whoever fills a form cheapest.", "Sales can end up chasing leads that never fit."] },
    with: { t: "Optimised for qualified leads", pts: ["Meta sees which leads sales accepted and won.", "Spend can shift toward buyers like the ones you win.", "The cost of a qualified lead becomes the number to watch."] },
  },
};
const ICONS = [
  '<path d="M4 12h11M11 7l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /><path d="M19 5v14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />',
  '<rect x="3.5" y="5" width="17" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="2" /><path d="M3.5 10h17M9.5 10v9" stroke="currentColor" stroke-width="2" />',
  '<path d="M5 9h12M14 5.5 17.5 9 14 12.5M19 15H7M10 11.5 6.5 15 10 18.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />',
];
const S = SHORT[H.key] || {};
const steps = L.steps.map((s: any, i: number) => ({ t: S.steps ? S.steps[i][0] : s.k, d: S.steps ? S.steps[i][1] : s.d, chip: i === 3 ? "A clearer signal" : s.chip }));
const back = S.back || L.returnLabel;
const cmp: any = {
  without: { tag: "Without the CRM feedback", t: (S.without || L.without).t, pts: S.without ? S.without.pts : [L.without.d] },
  with: { tag: "With CRM and CAPI", t: (S.with || L.with).t, pts: S.with ? S.with.pts : [L.with.d] },
};
---
<section class="lqb" id="quality" aria-labelledby="lqb-h" data-lqb>
  <div class="lqb__wrap">
    <div class="lqb__head">
      <div class="lqb__copy">
        <span class="lqb__eyebrow">{L.eyebrow}</span>
        <h2 id="lqb-h" class="lqb__h">{L.h2a} <em>{L.h2b}</em></h2>
        <p class="lqb__lede">{L.lede}</p>
      </div>
      <figure class="lqb__shot">
        <img src={"/assets/" + L.img} alt={L.imgCaption || ""} loading="lazy" decoding="async" />
        <figcaption>{L.imgCaption}</figcaption>
      </figure>
    </div>
    <div class="lqb__card">
      <ol class="lqb__flow">
        {steps.map((s: any, i: number) => (
          <li class="lqb__step">
            <span class={"lqb__ico" + (i === 3 ? " is-meta" : "")}>
              {i === 3 ? <img src="/assets/platforms/meta.svg" alt="" width="22" height="22" loading="lazy" decoding="async" /> : <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[i]} />}
            </span>
            <div class="lqb__txt">
              <span class="lqb__n">Step {i + 1}</span>
              <b>{s.t}</b>
              <span class="lqb__d">{s.d}</span>
              <em class="lqb__chip">{s.chip}</em>
            </div>
          </li>
        ))}
      </ol>
      <div class="lqb__back" aria-label={"Loops back to step 1: " + back}>
        <span class="lqb__loopico" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /><path d="M18.5 3v4h-4M5.5 21v-4h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
        <span class="lqb__pill"><i>Back to step 1</i>{back}</span>
      </div>
    </div>
    <div class="lqb__cmp">
      <div class="lqb__seg" role="group" aria-label="Compare with and without CRM feedback">
        <button type="button" data-mode="without" aria-pressed="false" class="lqb__segbtn">Without</button>
        <button type="button" data-mode="with" aria-pressed="true" class="lqb__segbtn is-on">With CRM and CAPI</button>
      </div>
      <div class="lqb__panels">
        {["without", "with"].map((k) => (
          <article class={"lqb__panel lqb__panel--" + k + (k === "with" ? " is-on" : "")} data-panel={k}>
            <span class="lqb__tag">
              {k === "with"
                ? <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="currentColor" /><path d="M5.6 10.4 8.6 13.2 14.2 7.4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                : <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="currentColor" /><path d="M6 10h8" stroke="#fff" stroke-width="2" stroke-linecap="round" /></svg>}
              {cmp[k].tag}
            </span>
            <h3>{cmp[k].t}</h3>
            <ul>{cmp[k].pts.map((p: string) => <li>{p}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
    <p class="lqb__note">Illustration of the idea, not a client result.</p>
  </div>
</section>
