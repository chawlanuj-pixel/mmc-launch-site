---
import Img from "./Img.astro";
import Arrow from "./Arrow.astro";
import { seeLink } from "../../lib/services";
const Y = Astro.props.Y;
const tone = Astro.props.tone || "white";
---
{Y && (
<section class={"n-band pm-band n-band--" + tone} id="beyond">
  <div class="n-wrap">
    <div class="pm-head n-rise">
      <span class="n-eyebrow">{Y.eyebrow || "Related"}</span>
      <h2 class="n-h2">{Y.h2a} <span class="n-serif">{Y.h2b}</span></h2>
    </div>
    <div class={"dcb n-rise d1" + (Y.cards.length === 3 ? " dcb--3" : "")}>
      {Y.cards.map((c: any) => (
        <article class="dcb__card">
          <Img name={c.img} ratio="3 / 2" class="dcb__img" />
          <h3>{c.n}</h3>
          <p>{c.d}</p>
          <a class="pm-textlink" href={c.href}>{seeLink(c.href, c.link)}<Arrow /></a>
        </article>
      ))}
    </div>
  </div>
</section>
)}
