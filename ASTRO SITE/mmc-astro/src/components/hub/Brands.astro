---
import Arrow from "./Arrow.astro";
import { href } from "../../lib/links";
import { CLIENTS, WORK_ART, csFit, tilt } from "../../lib/hub";
import BrandMeta from "../work/BrandMeta.astro";
const B = Astro.props.B;
---
{B && B.list && B.list.length ? (
<section class="n-band n-band--paper pm-band" id="brands">
  <div class="n-wrap">
    <div class="pm-head n-rise" style="margin-bottom:0">
      <span class="n-eyebrow">The brands</span>
      <h2 class="n-h2">{B.h2a} <span class="n-serif">{B.h2b}</span></h2>
      <p class="n-lede">{B.lede}</p>
    </div>
    <div class="n-wall pm-wall">
      {B.list.map((p: any) => {
        const c = CLIENTS[p.id];
        if (!c) return null;
        return (
          <div class="pm-wall__item">
            <span class="n-wall__cell" title={c.name} style={`--n-tilt:${tilt(p.id)}`}>
              <span class="n-wall__mark">
                <span class="cs-logo">
                  <span class="cs-wm" style={`--cs-wm-k:${csFit(c.name)}`}>{c.name}</span>
                  <img class="cs-logo__img" src={`/assets/clients/${p.id}.png`} alt={c.name} loading="lazy" decoding="async" />
                </span>
              </span>
              {WORK_ART.includes(p.id) && <img class="n-wall__work" src={`/assets/clients/${p.id}-work.jpg`} alt="" loading="lazy" decoding="async" />}
            </span>
            <BrandMeta id={p.id} caseLink />
          </div>
        );
      })}
    </div>
    <div class="pm-proof__foot"><a class="pm-textlink" href={href("Our Work.html")}>See more of our work<Arrow /></a></div>
  </div>
</section>
) : null}
