---
// Photo band with 4 to 6 benefits. Data key `why`; renders nothing without it.
import "../../styles/hub-v2.css";
interface Item { t: string; d: string }
const W = Astro.props.W as { eyebrow?: string; h2a: string; h2b?: string; lede?: string; img: string; alt?: string; items: Item[] } | undefined;
---
{W && W.items && W.items.length ? (
<section class="n-band pm-band n-band--white" id="why-mmc" aria-labelledby="hv2h-why-h">
  <div class="n-wrap hv2h-why">
    <figure class="hv2h-why__fig n-rise">
      <img src={"/assets/" + W.img} alt={W.alt || ""} width="800" height="1000" loading="lazy" decoding="async" />
    </figure>
    <div class="hv2h-why__main">
      <div class="hv2h-head n-rise">
        <span class="n-eyebrow">{W.eyebrow || "Why MMC"}</span>
        <h2 class="n-h2" id="hv2h-why-h">{W.h2a}{W.h2b ? " " : ""}{W.h2b && <span class="n-serif">{W.h2b}</span>}</h2>
        {W.lede ? <p class="hv2h-lede">{W.lede}</p> : null}
      </div>
      <ul class="hv2h-why__list">
        {W.items.map((it) => (
          <li class="hv2h-why__item n-rise"><h3 class="hv2h-why__t">{it.t}</h3><p class="hv2h-why__d">{it.d}</p></li>
        ))}
      </ul>
    </div>
  </div>
</section>
) : null}
