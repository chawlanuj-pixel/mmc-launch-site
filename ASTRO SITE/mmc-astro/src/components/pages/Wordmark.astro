---
// Client logo slot: wordmark in the display type, real logo cross-fades over it once assets/clients/<id>.png loads.
import { CLIENTS, csFit } from "../../lib/hub";
const { id } = Astro.props as { id: string };
const name = CLIENTS[id]?.name || id;
---
<span class="cs-logo"><span class="cs-wm" style={`--cs-wm-k:${csFit(name)}`}>{name}</span><img class="cs-logo__img" src={`/assets/clients/${id}.png`} alt={name} loading="lazy" decoding="async" onload="this.classList.add('is-on');this.previousElementSibling.classList.add('is-off')" onerror="this.classList.remove('is-on');this.previousElementSibling.classList.remove('is-off')" /></span>
