---
// A guide "cover": the one card anatomy for a guide, used by the /guides/ library and the "Keep reading" band
// under each guide, so the index and the articles read as one editorial family. Copy comes from the guide
// catalogue (src/lib/guides.ts) and the hub data; nothing is retyped here. Styles: guides3.css (gd3-cover).
interface Props {
  n: string; tag: string; title: string; href: string; img: string;
  learn?: string; q?: string; min?: number; size?: "md" | "sm"; headingLevel?: 2 | 3;
}
const { n, tag, title, href, img, learn, q, min, size = "md", headingLevel = 3 } = Astro.props;
const H = headingLevel === 2 ? "h2" : "h3";
---
<a class={"gd3-cover gd3-cover--" + size + " gd3-rise"} href={href}>
  <span class="gd3-cover__pic">
    <img src={img} alt="" width="1200" height="806" loading="lazy" decoding="async" />
    <span class="gd3-cover__n" aria-hidden="true">{n}</span>
  </span>
  <span class="gd3-cover__body">
    <span class="gd3-cover__tag">{"Guide " + n}<i aria-hidden="true"></i>{tag}</span>
    <H class="gd3-cover__h">{title}</H>
    {q && <span class="gd3-cover__q">{q}</span>}
    {learn && (
      <span class="gd3-cover__learn">
        <b>What you will learn</b>
        <span>{learn}</span>
      </span>
    )}
    <span class="gd3-cover__foot">
      {typeof min === "number" && <span class="gd3-cover__min">{min + " min read"}</span>}
      <span class="gd3-cover__go">Read the guide
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
      </span>
    </span>
  </span>
</a>
