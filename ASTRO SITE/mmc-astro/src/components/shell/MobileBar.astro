---
// Phone action bar (<=820px): "Book a call" + WhatsApp. Ported from the static site's .mbar. Styles in styles/mbar.css.
import { WHATSAPP } from "../../lib/site";
---
<div class="mbar" role="region" aria-label="Contact">
  <button type="button" class="mbar__book" data-book="mobile-bar">Book a call</button>
  <a class="mbar__wa" href={WHATSAPP} target="_blank" rel="noreferrer" data-wa="mobile-bar">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.2 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.2.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.8-.1 1.5Z"/></svg>
    <span>WhatsApp</span>
  </a>
</div>
<script>
  const w = window as any;
  document.querySelectorAll<HTMLElement>(".mbar__book").forEach((el) =>
    el.addEventListener("click", (e) => { if (w.mmcBookCall) w.mmcBookCall("mobile-bar", e); }));
  document.querySelectorAll<HTMLElement>(".mbar__wa").forEach((el) =>
    el.addEventListener("click", () => {
      try { (w.dataLayer = w.dataLayer || []).push({ event: "whatsapp_click", cta_source: "mobile-bar" }); } catch (e) {}
    }));
</script>
