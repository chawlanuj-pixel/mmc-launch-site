---
// Shared page shell: floating nav + full-screen menu (island), page content, footer, cookie banner and the
// brand-audit modal. Every page wraps its content in this. `source` prefixes the booking-analytics label.
import "../styles/shell.css";
import "../styles/ai-fab.css";
import "../styles/mbar.css";
import NavMenu from "./shell/NavMenu.tsx";
import AuditModal from "./shell/AuditModal.tsx";
import CookieBanner from "./shell/CookieBanner.tsx";
import AiFab from "./shell/AiFab.tsx";
import Footer from "./Footer.astro";
import MobileBar from "./shell/MobileBar.astro";

interface Props { source?: string; footerCta?: { label: string; href: string; nav?: boolean } }
const p = Astro.url.pathname.replace(/^\/|\/$/g, "");
const { source = p ? p.split("/").pop()! : "home", footerCta } = Astro.props;
---
<a class="skip-link" href="#main">Skip to content</a>
<NavMenu client:idle source={source} />
<slot />
<Footer cta={footerCta} />
<MobileBar />
<AuditModal client:idle />
<CookieBanner client:idle />
<AiFab client:idle />
