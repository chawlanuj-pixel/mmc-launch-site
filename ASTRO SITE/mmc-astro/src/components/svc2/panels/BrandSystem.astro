---
// PANEL: BrandSystem (kind "BrandSystem"). A brand board built in CSS and SVG, no platform mark, no real brand. 4 steps.
//   1 Position: audience, promise and "not like" cards feeding one positioning line. Tab: Position.
//   2 Name and message: five name options, one selected, with a message line. Tab: Name.
//   3 Identity: a generic mark, colour swatches and a type specimen on one board. Tab: Identity.
//   4 Guidelines: three template tiles (post, letterhead, label) and short usage rules. Tab: Guidelines.
// Needs S.work.illustrative. Illustrative layout, placeholder shapes only. Styles scoped to this file (prefix bs-).
import Frame from "./Frame.astro";
interface Props { W: any }
const { W } = Astro.props as Props;
const sw = ["#0F1E5E", "#1D4ED8", "#FFC528", "#FBFAF6", "#1C2B33"];
---
<Frame title="Brand board" label="Illustration of a brand board: position, name, identity and guidelines. Placeholder shapes, not a real brand." caption={W.illustrative} tabs={["Position", "Name", "Identity", "Guidelines"]} tabFor={[0, 1, 2, 3]} accent="#1D4ED8" accentSoft="#E3EAFC">
  <div class="s2-st s2-st--1">
    <p class="s2-st__cap">Position <span>Decided before anything is drawn</span></p>
    <div class="bs-pos">
      {["Who it is for", "What it promises", "Not like"].map((n) => <div class="s2p-card"><p class="s2p-lbl">{n}</p><i class="s2p-line s2p-line--m"></i><i class="s2p-line s2p-line--s"></i></div>)}
    </div>
    <div class="s2p-card bs-line"><p class="s2p-lbl">Positioning line</p><i class="s2p-line s2p-line--m"></i><em class="s2p-chip s2p-chip--sun">Every choice is checked against this</em></div>
  </div>
  <div class="s2-st s2-st--2">
    <p class="s2-st__cap">Name and message <span>Tested for meaning, sound and market</span></p>
    <ul class="bs-names">
      {["Name option one", "Name option two", "Name option three", "Name option four"].map((n, k) => <li class={"s2p-card" + (k === 2 ? " bs-on" : "")}><b>{n}</b>{k === 2 ? <em class="s2p-chip s2p-chip--sun">Selected</em> : <em class="s2p-chip">Tested</em>}</li>)}
    </ul>
    <div class="s2p-card bs-msg"><p class="s2p-lbl">Message</p><i class="s2p-line s2p-line--m"></i></div>
  </div>
  <div class="s2-st s2-st--3">
    <p class="s2-st__cap">Identity <span>Mark, colour and type designed together</span></p>
    <div class="bs-board">
      <div class="s2p-card bs-mark"><svg viewBox="0 0 80 80" aria-hidden="true"><circle cx="40" cy="40" r="30" /><path d="M22 46 C30 20 52 20 58 40" /><circle cx="50" cy="52" r="7" /></svg><p class="s2p-lbl">Mark</p></div>
      <div class="s2p-card"><p class="s2p-lbl">Colour</p><span class="bs-sw">{sw.map((c) => <i style={`background:${c}`}></i>)}</span></div>
      <div class="s2p-card bs-type"><p class="s2p-lbl">Type</p><span class="bs-aa">Aa</span><i class="s2p-line s2p-line--m"></i></div>
    </div>
  </div>
  <div class="s2-st s2-st--4">
    <p class="s2-st__cap">Guidelines <span>Ready to use, easy to keep</span></p>
    <ul class="bs-tpl">
      {["Social post", "Letterhead", "Pack label"].map((n, k) => <li class="s2p-card"><span class={"bs-tile bs-tile--" + k}><i></i><i></i></span><b>{n}</b></li>)}
    </ul>
    <ul class="bs-rules"><li><em class="s2p-chip s2p-chip--ok">Do</em> Keep clear space around the mark</li><li><em class="s2p-chip s2p-chip--bad">Don't</em> Recolour outside the palette</li></ul>
  </div>
</Frame>
<style is:global>
.bs-pos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6em; }
.bs-pos .s2p-card, .bs-line, .bs-msg { display: grid; gap: .5em; align-content: start; justify-items: start; padding: .8em; }
.bs-line { margin-top: auto; margin-bottom: auto; }
.bs-names { list-style: none; margin: 0; padding: 0; display: grid; gap: .5em; }
.bs-names li { display: flex; align-items: center; justify-content: space-between; padding: .6em .9em; }
.bs-names b { font: 800 1em var(--font-display); color: #1C2B33; }
.bs-on { border-color: var(--mmc-blue) !important; box-shadow: 0 0 0 2px var(--mmc-blue); }
.bs-board { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1.2fr 1fr; gap: .7em; align-content: center; }
.bs-board .s2p-card { display: grid; gap: .6em; align-content: start; justify-items: start; padding: .8em; }
.bs-mark { justify-items: center !important; } .bs-mark svg { width: 5em; fill: none; stroke: var(--mmc-blue-900); stroke-width: 4; stroke-linecap: round; } .bs-mark circle:last-child { fill: var(--mmc-yellow); stroke: none; }
.bs-sw { display: flex; gap: .3em; } .bs-sw i { width: 1.9em; height: 3.2em; border-radius: .5em; border: 1px solid #DADDE1; }
.bs-aa { font: 800 2.6em/1 var(--font-display); color: var(--mmc-blue-900); letter-spacing: -.04em; }
.bs-tpl { list-style: none; margin: 0; padding: 0; flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6em; align-content: center; }
.bs-tpl li { display: grid; gap: .4em; padding: .55em; justify-items: start; } .bs-tpl b { font: 800 .9em var(--font-display); color: #1C2B33; }
.bs-tile { display: block; width: 100%; aspect-ratio: 1.3; border-radius: .5em; background: var(--mmc-blue-900); padding: .5em; } .bs-tile i { display: block; height: .45em; width: 60%; border-radius: 99px; background: var(--mmc-yellow); margin-bottom: .35em; } .bs-tile i + i { width: 40%; background: #fff; }
.bs-tile--1 { background: var(--mmc-paper); border: 1px solid #DADDE1; } .bs-tile--1 i + i { background: #CED0D4; } .bs-tile--2 { background: var(--mmc-blue); }
.bs-rules { list-style: none; margin: 0; padding: 0; display: grid; gap: .4em; font: 600 .92em var(--font-body); color: #1C2B33; } .bs-rules li { display: flex; align-items: center; gap: .6em; }
@media (max-width: 560px) { .bs-pos { grid-template-columns: 1fr; } .bs-pos .s2p-card:nth-child(3), .bs-names li:nth-child(4), .bs-rules li:nth-child(2) { display: none; } .bs-board { grid-template-columns: 1fr 1fr; } .bs-type { display: none !important; } }
</style>
