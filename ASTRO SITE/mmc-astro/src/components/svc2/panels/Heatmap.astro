---
// PANEL: Heatmap (kind "Heatmap"). A product page with heatmap overlays and an A/B result card. No platform mark (generic analytics layout). 4 steps.
//   1 Click heatmap: warm blobs over the product photo, the size chips and the add-to-cart button. Tab: Heatmap.
//   2 Scroll map: a vertical colour strip beside the page and a dashed line where most visitors stop scrolling. Tab: Scroll.
//   3 Test plan: Variant A and Variant B mini product pages side by side with the one change called out. Tab: Experiments.
//   4 Result: the A/B result card; Variant B is ahead, with a bar pair and a "keep running until the result is clear" note (no figures). Tab: Experiments.
// Needs S.work.illustrative. Illustrative layout, no figures. Styles scoped to this file (prefix hm-).
import Frame from "./Frame.astro";
import { THUMBS } from "./crops";
interface Props { W: any }
const { W } = Astro.props as Props;
---
<Frame title="Page analytics" label="Illustration of a product page with a click heatmap, a scroll map and an A/B test result. Not a client page." caption={W.illustrative} tabs={["Heatmap", "Scroll", "Experiments"]} tabFor={[0, 1, 2, 2]} accent="#D9480F" accentSoft="#FFE9DD">
  <div class="s2-st s2-st--1 s2-st--2">
    <div class="hm-page">
      <span class="s2p-ph hm-img" style={THUMBS.shirt}>
        <i class="hm-blob s2p-at-1" style="left:44%;top:40%;--s:46%"></i>
        <i class="hm-blob s2p-at-1" style="left:70%;top:22%;--s:22%"></i>
      </span>
      <div class="hm-info">
        <i class="s2p-line s2p-line--m"></i><i class="s2p-line s2p-line--xs"></i>
        <div class="hm-sizes"><span class="s2p-chip">S</span><span class="s2p-chip hm-hot">M</span><span class="s2p-chip">L</span></div>
        <span class="hm-cta hm-hot">Add to cart</span>
        <i class="s2p-line"></i><i class="s2p-line s2p-line--s"></i>
        <div class="hm-rev"><i class="s2p-line s2p-line--xs"></i><i class="s2p-line"></i></div>
      </div>
      <span class="hm-scroll s2p-at-2" aria-hidden="true"></span>
      <span class="hm-fold s2p-at-2"><em>Most visitors stop here</em></span>
    </div>
    <div class="hm-key s2p-only-1" style="--show:flex"><span><i class="hot"></i>Most clicks</span><span><i class="cool"></i>Few clicks</span></div>
    <div class="hm-key s2p-only-2" style="--show:flex"><span><i class="hot"></i>Seen by most</span><span><i class="cool"></i>Seen by few</span></div>
  </div>
  <div class="s2-st s2-st--3">
    <p class="s2-st__cap">One change, one test <span>Add to cart moves up, reviews move beside it</span></p>
    <div class="hm-ab">
      {["A", "B"].map((v) => (
        <div class={"s2p-card hm-v" + (v === "B" ? " hm-v--b" : "")}>
          <p class="s2p-lbl">Variant {v}</p>
          <span class="s2p-ph hm-v__img" style={THUMBS.shirt}></span>
          {v === "B" ? <span class="hm-cta hm-cta--s">Add to cart</span> : null}
          <i class="s2p-line s2p-line--m"></i><i class="s2p-line s2p-line--s"></i>
          {v === "A" ? <span class="hm-cta hm-cta--s">Add to cart</span> : <span class="s2p-chip s2p-chip--sun">Reviews beside it</span>}
        </div>
      ))}
    </div>
  </div>
  <div class="s2-st s2-st--4">
    <p class="s2-st__cap">Result <span>Run until the result is clear</span></p>
    <div class="s2p-card hm-res">
      <span class="s2p-chip s2p-chip--ok">Variant B ahead</span>
      <div class="hm-bars"><div><small>Variant A</small><i style="--w:56%"></i></div><div><small>Variant B</small><i class="is-b" style="--w:74%"></i></div></div>
      <small class="s2p-mute">Add to cart rate, same traffic split, same weeks. The test keeps running until the gap is outside normal noise.</small>
    </div>
  </div>
</Frame>
<style is:global>
.s2-work[data-step="2"] .hm-page { padding-right: 2.6em; }
.hm-page { position: relative; flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1.2em; align-items: center; padding: .9em; border: 1px solid #DADDE1; border-radius: 1em; }
.hm-img { position: relative; display: block; aspect-ratio: 1 / 1; max-height: 100%; width: 100%; border-radius: .8em; overflow: hidden; }
.hm-info { display: grid; gap: .7em; align-content: center; }
.hm-sizes { display: flex; gap: .5em; }
.hm-sizes .s2p-chip { position: relative; overflow: visible; min-width: 2.6em; justify-content: center; }
.hm-cta { position: relative; display: block; padding: .75em; border-radius: .6em; background: #1C2B33; color: #fff; text-align: center; font: 800 .95em var(--font-body); }
.hm-cta--s { padding: .45em; font-size: .85em; }
.hm-rev { display: grid; gap: .4em; }
.hm-blob { position: absolute; width: var(--s); aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; background: radial-gradient(circle, rgba(255, 40, 0, .78), rgba(255, 170, 0, .5) 42%, rgba(255, 230, 0, .22) 62%, transparent 72%); pointer-events: none; }
.hm-hot { position: relative; }
.hm-hot::after { content: ""; position: absolute; inset: -70% -12%; border-radius: 50%; background: radial-gradient(closest-side, rgba(255, 40, 0, .5), rgba(255, 170, 0, .3) 55%, transparent); pointer-events: none; opacity: 0; transition: opacity .45s; }
.hm-sizes .hm-hot::after { inset: -90% -60%; }
.s2-work[data-step="1"] .hm-hot::after { opacity: 1; }
.hm-scroll { position: absolute; top: .9em; bottom: .9em; right: .9em; width: .9em; border-radius: 99px; background: linear-gradient(#E5391A, #F59E0B 38%, #7DB8E8 65%, #3B6FD0); }
.hm-fold { position: absolute; left: .9em; right: 2.4em; top: 72%; border-top: 2px dashed #D9480F; }
.hm-fold em { position: absolute; right: 0; top: -1.9em; padding: .25em .7em; border-radius: 99px; background: #D9480F; color: #fff; font: 800 .74em var(--font-body); font-style: normal; text-transform: uppercase; letter-spacing: .04em; }
.hm-key { margin-top: .8em; gap: 1.4em; font: 700 .86em var(--font-body); color: #65676B; }
.hm-key i { display: inline-block; width: 1.4em; height: .8em; border-radius: 99px; margin-right: .5em; vertical-align: -.05em; }
.hm-key .hot { background: linear-gradient(90deg, #FFB300, #E5391A); } .hm-key .cool { background: linear-gradient(90deg, #7DB8E8, #3B6FD0); }
.hm-ab { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1em; align-content: center; }
.hm-v { display: grid; gap: .55em; padding: .8em; }
.hm-v__img { display: block; aspect-ratio: 16 / 9; border-radius: .6em; }
.hm-v--b { border-color: #D9480F; box-shadow: 0 0 0 2px #D9480F; }
.hm-res { display: grid; gap: 1em; align-content: center; flex: 1; padding: 1.2em; }
.hm-res small { font-size: .8em; }
.hm-res .s2p-chip { justify-self: start; }
.hm-bars { display: grid; gap: .8em; }
.hm-bars small { font: 700 .82em var(--font-body); color: #65676B; }
.hm-bars i { display: block; height: 1.1em; width: var(--w); margin-top: .3em; border-radius: .4em; background: #CED0D4; }
.hm-bars i.is-b { background: #D9480F; }
@media (max-width: 560px) { .hm-page { grid-template-columns: .9fr 1fr; gap: .8em; padding: .6em; } .hm-v .s2p-line { display: none; } }
@media (max-width: 900px) { .s2-ui:has(.hm-res) .s2-st { padding: 10px 12px; gap: .6em; } }
@media (max-width: 900px) { .hm-res { gap: .6em; padding: .8em; } }
@media (max-width: 900px) { .hm-v .s2p-line { display: none; } }
</style>
