---
// VISUAL: WlDeliveryLeak (kind "WlDeliveryLeak"). Data-driven "where agency delivery goes wrong" board for the white-label pages. Five columns, pins in a
// row above (y = 0, x = 10, 30, 50, 70, 90). Reads X.variant and X.cols (five entries), X.base (label of the bar under the columns) and X.artLabel.
//   variant "board" (default): cols[i] = { glyph, head, lines: [a, b], chip, tone }  a small icon, a head (1 to 2 words), two short lines, a status chip.
//   variant "route": cols[i] = { glyph, head, lines: [a], chip, tone }  five stations on one hand-off line; the line breaks where a station is flagged (tone "b").
//   variant "bars":  cols[i] = { head, plan, actual, chip, tone }  plan and actual bars (0 to 100, illustrative lengths); the part of actual past plan is hatched.
// tone: "w" (watch), "b" (breaks), "ok". glyph: doc clock check chart coin layers chat code star globe users bell mail phone eye flag.
// No figures, no real brands. Styles scoped to this file (prefix wdl-).
interface Props { X: any; pins: { x: number; y: number; label: string }[] }
const { X } = Astro.props as Props;
const v = (X.variant ?? "board") as "board" | "route" | "bars";
const cols = (X.cols ?? []) as any[];
const G: Record<string, string> = {
  doc: "M6 3h9l4 4v14H6z M15 3v4h4 M9 12h7 M9 16h7", clock: "M12 4a8 8 0 100 16 8 8 0 000-16z M12 8v4l3 2", check: "M5 12.5l4.5 4.5L19 7.5",
  chart: "M4 20V10 M10 20V4 M16 20v-8 M22 20H2", coin: "M12 4a8 8 0 100 16 8 8 0 000-16z M9.5 10c0-1 1-1.8 2.5-1.8s2.5.8 2.5 1.8-1 1.5-2.5 1.8-2.5.8-2.5 1.8 1 1.8 2.5 1.8 2.5-.8 2.5-1.8",
  layers: "M12 3l9 5-9 5-9-5z M3 13l9 5 9-5", chat: "M4 5h16v11H9l-5 4z", code: "M9 7l-5 5 5 5 M15 7l5 5-5 5",
  star: "M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.300 6.700 19.400l1.200-6L3.400 9.300l6-.7z", globe: "M12 3a9 9 0 100 18 9 9 0 000-18z M3 12h18 M12 3c3 3 3 15 0 18 M12 3c-3 3-3 15 0 18",
  users: "M9 11a3 3 0 100-6 3 3 0 000 6z M3 20c0-3.500 2.700-6 6-6s6 2.500 6 6 M17 6a3 3 0 010 6 M18 14c2 .6 3 2.500 3 5", bell: "M6 17V11a6 6 0 0112 0v6l2 2H4z M10 21h4",
  mail: "M3 6h18v12H3z M3 7l9 6 9-6", phone: "M8 3h8v18H8z M11 18h2", eye: "M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z M12 9a3 3 0 100 6 3 3 0 000-6z", flag: "M5 21V4 M5 4h12l-2 4 2 4H5",
};
const icon = (g?: string) => G[g ?? "doc"] ?? G.doc;
---
<div class="wdl-row" aria-hidden="true"></div>
<div class={"wdl-art wdl-art--" + v} role="img" aria-label={X.artLabel ?? "Five stages of agency delivery, each showing where work slips."}>
  {cols.map((c, k) => (
    <div class={"wdl-c wdl-c--" + (c.tone ?? "w")}>
      {v === "route" ? <span class="wdl-node"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon(c.glyph)} /></svg></span> : null}
      <b class="wdl-h">{v !== "route" && v !== "bars" ? <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon(c.glyph)} /></svg> : null}<span>{c.head}</span></b>
      {v === "bars" ? (
        <div class="wdl-bars"><span class="wdl-bar"><i style={`width:${c.plan}%`}></i></span><span class="wdl-bar wdl-bar--a"><i style={`width:${Math.min(c.plan, c.actual)}%`}></i>{c.actual > c.plan ? <u style={`width:${c.actual - c.plan}%`}></u> : null}</span><small>Plan<br />Actual</small></div>
      ) : (
        <div class="wdl-b">{(c.lines ?? []).map((l: string, i: number) => <span class={"wdl-l" + (i > 0 ? " wdl-l--2" : "")}>{l}</span>)}</div>
      )}
      <em class={"wdl-chip wdl-chip--" + (c.tone ?? "w")}>{c.chip}</em>
    </div>
  ))}
</div>
<div class="wdl-base" aria-hidden="true"><span>{X.base}</span></div>
<style is:global>
.wdl-row { height: 78px; }
.wdl-art { position: relative; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(6px, 1.2vw, 14px); }
.wdl-c { position: relative; display: flex; flex-direction: column; gap: 10px; min-width: 0; padding: clamp(8px, 1.1vw, 14px); border: 1px solid #DADDE1; border-radius: 14px; background: #fff; }
.wdl-c::after { content: ""; position: absolute; left: 50%; bottom: -18px; width: 0; height: 18px; border-left: 2px dashed #9DB8F7; }
.wdl-h { display: flex; align-items: center; gap: 7px; font: 800 clamp(10px, .95vw, 12.5px)/1.2 var(--font-body); letter-spacing: .06em; text-transform: uppercase; color: #65676B; }
.wdl-h svg { flex: none; width: 17px; height: 17px; fill: none; stroke: var(--mmc-blue); stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
.wdl-b { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 7px; min-height: 92px; }
.wdl-l { padding: 7px 9px; border-radius: 9px; background: #F1F5FF; font: 700 clamp(10.5px, .9vw, 12px)/1.3 var(--font-body); color: var(--mmc-blue-900); }
.wdl-l--2 { background: transparent; border: 1px dashed #8A93A6; color: #65676B; font-weight: 600; }
.wdl-chip { align-self: flex-start; padding: 4px 9px; border-radius: 99px; font: 800 10px/1.25 var(--font-body); font-style: normal; text-transform: uppercase; letter-spacing: .04em; }
.wdl-chip--w { background: #FFF3D6; color: #8A5A00; } .wdl-chip--b { background: #FDE8E8; color: #B42318; } .wdl-chip--ok { background: #E3F6E9; color: #1B7A3D; }
.wdl-c--b { border-color: #F2B8B5; }
.wdl-base { margin-top: 18px; height: 40px; border-radius: 12px; background: var(--mmc-blue-900); display: grid; place-items: center; padding-inline: 12px; } .wdl-base span { font: 800 12px var(--font-body); letter-spacing: .08em; text-transform: uppercase; color: #fff; text-align: center; }
/* route: stations on one hand-off line */
.wdl-art--route::before { content: ""; position: absolute; left: 10%; right: 10%; top: 31px; border-top: 3px solid #9DB8F7; }
.wdl-art--route .wdl-c { align-items: center; text-align: center; padding-top: 12px; }
.wdl-node { position: relative; z-index: 1; width: 40px; height: 40px; margin-top: -2px; border-radius: 50%; display: grid; place-items: center; background: var(--mmc-blue-900); box-shadow: 0 0 0 5px #fff; }
.wdl-node svg { width: 20px; height: 20px; fill: none; stroke: #fff; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
.wdl-c--b .wdl-node { background: #B42318; } .wdl-c--w .wdl-node { background: #8A5A00; } .wdl-c--ok .wdl-node { background: #1B7A3D; }
.wdl-art--route .wdl-h { justify-content: center; } .wdl-art--route .wdl-b { min-height: 56px; } .wdl-art--route .wdl-chip { align-self: center; }
/* bars: plan against actual */
.wdl-bars { flex: 1; display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto auto; gap: 10px 8px; align-content: center; min-height: 92px; }
.wdl-bar { display: flex; height: 14px; border-radius: 6px; background: #EEF0F2; overflow: hidden; } .wdl-bar i { display: block; background: #8AA9F0; } .wdl-bar--a i { background: var(--mmc-blue-900); } .wdl-bar u { display: block; background: repeating-linear-gradient(135deg, #B42318 0 4px, #F6C9C6 4px 8px); }
.wdl-bars small { grid-column: 2; grid-row: 1 / span 2; font: 800 9px/1.2 var(--font-body); text-transform: uppercase; letter-spacing: .04em; color: #65676B; align-self: center; }
.wdl-bars .wdl-bar:nth-child(1) { grid-column: 1; grid-row: 1; } .wdl-bars .wdl-bar:nth-child(2) { grid-column: 1; grid-row: 2; }
@media (max-width: 760px) { .wdl-row { height: 58px; } .wdl-b { min-height: 70px; } .wdl-l { font-size: 9px; padding: 5px 6px; } .wdl-chip { font-size: 8.5px; padding: 3px 6px; } .wdl-c { padding: 6px; gap: 6px; } .wdl-base { height: 32px; } .wdl-base span { font-size: 10px; } .wdl-h { font-size: 9px; letter-spacing: 0; text-transform: none; gap: 4px; flex-direction: column; align-items: flex-start; } .wdl-h svg { width: 15px; height: 15px; } .wdl-art--route .wdl-h { align-items: center; } .wdl-bars small { display: none; } .wdl-bars { grid-template-columns: 1fr; min-height: 56px; } .wdl-bars .wdl-bar:nth-child(2) { grid-column: 1; } .wdl-node { width: 30px; height: 30px; } .wdl-node svg { width: 15px; height: 15px; } .wdl-art--route::before { top: 25px; } }
@media (max-width: 440px) { .wdl-art { gap: 4px; } .wdl-c { padding: 5px 4px; } .wdl-l { font-size: 8px; padding-inline: 4px; overflow-wrap: anywhere; } .wdl-chip { font-size: 8px; letter-spacing: 0; text-transform: none; padding: 3px 5px; overflow-wrap: normal; hyphens: none; } .wdl-h span { overflow-wrap: anywhere; } .wdl-l--2 { display: none; } }
/* Readable floor on phones (small-defects pass, same pattern as SaSurfaceMap): micro labels >= 10px, the chip that names the leak >= 11px. */
@media (max-width: 760px) { .wdl-l, .wdl-h { font-size: 11px; } .wdl-chip { font-size: 11px; letter-spacing: 0; text-transform: none; } .wdl-base span { font-size: 11px; } .wdl-h { font-size: 10px; } }
@media (max-width: 440px) { .wdl-c { padding: 5px 3px; } .wdl-l, .wdl-h { font-size: 10px; line-height: 1.2; padding-inline: 1px; hyphens: auto; overflow-wrap: break-word; letter-spacing: 0; text-transform: none; } .wdl-chip { align-self: stretch; text-align: center; font-size: 11px; line-height: 1.2; padding: 3px 1px; hyphens: auto; overflow-wrap: break-word; } .wdl-h { padding-inline: 0; } .wdl-c { padding: 5px 2px; } .wdl-chip { font-size: 10px; padding: 3px 0; margin-inline: -2px; letter-spacing: -.01em; } }
@media (max-width: 440px) { .wdl-base { height: auto; min-height: 32px; padding-block: 6px; } .wdl-base span { letter-spacing: .04em; line-height: 1.25; } }
</style>
