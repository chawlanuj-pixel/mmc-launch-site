---
// VISUAL: ShopFunnelLeak (kind "ShopFunnelLeak"). A store journey from catalogue to tracking as five narrowing cards, each under a pin
// (x = 10, 30, 50, 70, 90; y = 0). Cards: catalogue grid, product page, load bar, checkout steps with payment chips, tracked events.
// Reads X.stageLabels (five strings, left to right). Styles scoped to this file (prefix sfl-).
interface Props { X: any; pins: { x: number; y: number; label: string }[] }
const { X, pins } = Astro.props as Props;
const labels: string[] = X.stageLabels ?? ["Catalogue", "Product page", "Speed", "Checkout", "Tracking"];
---
<div class="sfl-row" aria-hidden="true"></div>
<div class="sfl" aria-hidden="true">
  {[0, 1, 2, 3, 4].map((k) => (
    <div class="sfl-col" style={`--h:${(1 - k * 0.11).toFixed(2)}`}>
      <i class="sfl-leak"></i>
      <div class="sfl-card">
        {k === 0 && <div class="sfl-grid"><i></i><i></i><i></i><i></i></div>}
        {k === 1 && <div class="sfl-pdp"><i class="sfl-img"></i><i class="sfl-ln"></i><i class="sfl-ln sfl-ln--s"></i><b>Add to cart</b></div>}
        {k === 2 && <div class="sfl-load"><span><i class="sfl-fast"></i><i class="sfl-slow"></i></span><small>Loading</small></div>}
        {k === 3 && <div class="sfl-pay"><small>Pay</small><em>UPI</em><em>Cards</em><em>COD</em></div>}
        {k === 4 && <div class="sfl-ev"><span>Purchase</span><span>Add to cart</span><span>Page view</span></div>}
      </div>
      <span class="sfl-lbl">{labels[k]}</span>
    </div>
  ))}
</div>
<style is:global>
.sfl-row { height: 78px; }
.sfl { --H: clamp(190px, 26vw, 290px); display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; height: var(--H); container-type: inline-size; }
.sfl-col { position: relative; padding-inline: 1%; display: flex; flex-direction: column; align-items: stretch; min-width: 0; }
.sfl-leak { position: absolute; left: 50%; top: -78px; height: 78px; border-left: 2.4px dashed var(--mmc-yellow); z-index: 1; }
.sfl-leak::after { content: ""; position: absolute; left: -8px; bottom: -6px; width: 14px; height: 18px; background: var(--mmc-yellow); border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%; }
.sfl-card { flex: none; height: calc((var(--H) - 30px) * var(--h)); min-height: 0; padding: 8%; display: grid; align-content: center; justify-items: stretch; border-radius: 14px; background: linear-gradient(160deg, var(--mmc-blue-100), #BFD0FA); border: 1px solid rgba(29, 78, 216, .25); overflow: hidden; }
.sfl-lbl { margin-top: 8px; flex: none; text-align: center; font: 800 clamp(10px, 1.3vw, 15px)/1.15 var(--font-display); color: var(--mmc-blue-900); }
.sfl-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6%; }
.sfl-grid i { display: block; aspect-ratio: 1.15; border-radius: 6px; background: #fff; }
.sfl-pdp { display: grid; gap: 7%; }
.sfl-img { display: block; aspect-ratio: 16 / 10; border-radius: 6px; background: #fff; }
.sfl-ln { display: block; height: 5px; border-radius: 9px; background: rgba(15, 30, 94, .35); } .sfl-ln--s { width: 60%; }
.sfl-pdp b { padding: 4px; border-radius: 6px; background: var(--mmc-blue-900); color: #fff; text-align: center; font: 800 clamp(7px, .9vw, 11px) var(--font-body); }
.sfl-load { display: grid; gap: 8px; }
.sfl-load span { display: flex; height: 12px; border-radius: 9px; background: #fff; overflow: hidden; }
.sfl-fast { width: 30%; background: var(--mmc-blue); } .sfl-slow { width: 22%; background: var(--mmc-yellow); }
.sfl-load small, .sfl-pay small { font: 800 clamp(7px, .9vw, 11px) var(--font-body); text-transform: uppercase; letter-spacing: .05em; color: var(--mmc-blue-900); }
.sfl-pay { display: grid; gap: 6px; }
.sfl-pay em { padding: 3px 6px; border-radius: 99px; background: #fff; color: var(--mmc-blue-900); text-align: center; font: 800 clamp(7px, .9vw, 11px) var(--font-body); font-style: normal; }
.sfl-ev { display: grid; gap: 6px; }
.sfl-ev span { padding: 3px 6px; border-left: 3px solid var(--mmc-blue); background: #fff; color: var(--mmc-blue-900); font: 700 clamp(7px, .9vw, 11px) var(--font-body); white-space: nowrap; overflow: hidden; }
@media (max-width: 560px) { .sfl-card { padding: 6%; } .sfl-pay em:nth-of-type(3), .sfl-ev span:nth-of-type(3) { display: none; } }
/* Readable floor on phones (small-defects pass): micro labels >= 10px, words that carry meaning >= 11px. */
@media (max-width: 760px) { .sfl-pdp b, .sfl-load small, .sfl-pay small, .sfl-pay em, .sfl-ev span { font-size: 10px; letter-spacing: 0; } .sfl-ev span { white-space: normal; line-height: 1.2; } }
@media (max-width: 440px) { .sfl-ev span { padding-inline: 3px 2px; } }
</style>
