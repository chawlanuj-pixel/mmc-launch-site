---
// VISUAL: ShelfLeak (kind "ShelfLeak"). Five zones of a pack: a lone pack on a shelf, a stock carton, a flat message hierarchy, a thumbnail that no longer reads and print marks.
// Pins sit in a row above the picture (y = 0), at x = 10, 30, 50, 70, 90, one over each of the five zones. Styles scoped to this file (prefix sl).
interface Props { X: any; pins: { x: number; y: number; label: string }[] }
const { X, pins } = Astro.props as Props;
---
<div class="sl__row" aria-hidden="true"></div>
<div class="sl__art" role="img" aria-label="Five zones of a pack: shelf, structure, hierarchy, tile size and print marks.">
  <div class="sl__z"><span class="sl__sh"><u></u><u></u><u class="me"></u><u></u></span><small class="sl__cap">On the shelf</small></div>
  <div class="sl__z"><svg viewBox="0 0 60 70" aria-hidden="true"><path d="M20 2h20v14H20z M20 16h20v26H20z M20 42h20v20H20z M2 16h18v26H2z M40 16h18v26H40z" /></svg><small class="sl__cap">Structure</small></div>
  <div class="sl__z"><span class="sl__hi"><i></i><i></i><i></i><i></i></span><small class="sl__cap">Hierarchy</small></div>
  <div class="sl__z"><span class="sl__tn"><u></u></span><small class="sl__cap">Tile size</small></div>
  <div class="sl__z"><span class="sl__pr"><u></u><u></u><u></u><u></u></span><small class="sl__cap">Print marks</small></div>
</div>
<style is:global>
.sl__row { height: 78px; }
.sl__art { display: grid; grid-template-columns: repeat(5, 1fr); gap: 2%; height: clamp(190px, 26vw, 320px); }
.sl__z { position: relative; display: grid; align-content: center; justify-items: center; padding: 12px 12px 34px; border: 1px solid var(--s2-line); border-radius: 18px; background: #fff; min-width: 0; }
.sl__sh { display: flex; align-items: flex-end; gap: 5px; width: 80%; padding-bottom: 4px; border-bottom: 3px solid #CED0D4; } .sl__sh u { flex: 1; height: clamp(40px, 6vw, 80px); border-radius: 4px; background: #DADDE1; } .sl__sh u.me { background: var(--mmc-yellow); outline: 2px dashed var(--mmc-blue-900); outline-offset: 2px; }
.sl__z svg { width: 70%; max-height: 80%; fill: var(--mmc-paper); stroke: #1C2B33; stroke-width: 1.6; }
.sl__hi { display: grid; gap: 7px; width: 70%; padding: 10px; border-radius: 8px; background: var(--mmc-blue-900); } .sl__hi i { display: block; height: 8px; border-radius: 99px; background: #fff; } .sl__hi i:nth-child(1) { background: var(--mmc-yellow); height: 12px; } .sl__hi i:nth-child(3) { width: 60%; } .sl__hi i:nth-child(4) { width: 40%; opacity: .6; }
.sl__tn { display: grid; place-items: center; width: 60%; aspect-ratio: 1.3; background: #F5F6F7; border-radius: 8px; } .sl__tn u { width: 28%; aspect-ratio: .7; background: var(--mmc-blue-900); border-radius: 2px; }
.sl__pr { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; width: 60%; } .sl__pr u { aspect-ratio: 1; border-radius: 50%; background: var(--mmc-blue); } .sl__pr u:nth-child(2) { background: #E8A100; } .sl__pr u:nth-child(3) { background: #B42318; } .sl__pr u:nth-child(4) { background: #1C2B33; }
@media (max-width: 760px) { .sl__row { height: 58px; } .sl__art { height: 170px; } .sl__z { padding: 8px 6px; border-radius: 12px; } }
.sl__cap { position: absolute; left: 4px; right: 4px; bottom: 10px; text-align: center; font: 800 clamp(9px, .95vw, 12px)/1.15 var(--font-body); letter-spacing: .05em; text-transform: uppercase; color: var(--s2-mute); }
@media (max-width: 900px) { .sl__cap { display: none; } }
</style>
