---
// VISUAL: CreatorFit (kind "CreatorFit"). A row of five creator cards with an audience-fit meter; the one that fits is outlined. Influencer shortlist view.
// Pins sit in a row above the picture (y = 0), at x = 10, 30, 50, 70, 90, one over each of the five zones. Reads X.zoneLabels (optional) only.
// Styles are scoped to this file (prefix cf).
interface Props { X: any; pins: { x: number; y: number; label: string }[] }
const { X, pins } = Astro.props as Props;
const fit = [34, 82, 58, 70, 46];
---
<div class="cf__row" aria-hidden="true"></div>
<div class="cf__art" role="img" aria-label="Five creator cards, each with an audience-fit meter. One fits best.">
  {fit.map((f, k) => (
    <div class={"cf__card" + (k === 1 ? " is-on" : "")}><span class="cf__av"></span><i class="cf__l"></i><i class="cf__l cf__l--s"></i><span class="cf__m"><i style={`width:${f}%`}></i></span><small>{X.zoneLabels?.[k] ?? "Audience fit"}</small></div>
  ))}
</div>
<style is:global>
.cf__row { height: 78px; }
.cf__art { display: grid; grid-template-columns: repeat(5, 1fr); gap: 2%; height: clamp(190px, 26vw, 320px); }
.cf__card { display: grid; align-content: center; justify-items: center; gap: 10px; padding: 12px 8px; border: 1px solid var(--s2-line); border-radius: 18px; background: #fff; min-width: 0; }
.cf__card.is-on { border-color: var(--s2-blue); box-shadow: 0 0 0 3px rgba(29, 78, 216, .25); }
.cf__av { width: clamp(34px, 5vw, 64px); aspect-ratio: 1; border-radius: 50%; background: linear-gradient(135deg, #9DB8F7, var(--mmc-blue)); }
.cf__l { display: block; height: 8px; width: 70%; border-radius: 99px; background: #DADDE1; } .cf__l--s { width: 44%; }
.cf__m { display: block; width: 80%; height: 10px; border-radius: 99px; background: #E4E6EA; } .cf__m i { display: block; height: 100%; border-radius: 99px; background: var(--s2-blue); }
.cf__card small { font: 800 clamp(9px, 1vw, 12px) var(--font-body); text-transform: uppercase; letter-spacing: .05em; color: var(--s2-mute); text-align: center; }
@media (max-width: 760px) { .cf__row { height: 58px; } .cf__card small { display: none; } .cf__art { height: 170px; } .cf__l { display: none; } }
</style>
