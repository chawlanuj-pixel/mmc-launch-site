---
// Optional proof slots for a case study: period, basis, metrics and the named MMC team.
// Every slot is EMPTY today and renders nothing. A slot appears only when real data is filled in
// case-studies.json, and a metric needs its own label, value AND basis or it is not shown.
import type { CaseStudy } from "../../lib/work";
interface Props { c: CaseStudy }
const { c } = Astro.props as Props;
const metrics = (c.metrics || []).filter((m) => m && m.label && m.value && m.basis);
const team = (c.team || []).filter((p) => p && p.name && p.role);
const has = !!(c.timeframe || c.basis || metrics.length || team.length);
---
{has && (
  <section class="n-band n-band--paper cs-proof" aria-label="Results and team">
    <div class="n-wrap">
      {(c.timeframe || c.basis) && (
        <dl class="cs-proof__meta n-rise">
          {c.timeframe && <div><dt>Period</dt><dd>{c.timeframe}</dd></div>}
          {c.basis && <div><dt>Basis</dt><dd>{c.basis}</dd></div>}
        </dl>
      )}
      {metrics.length > 0 && (
        <ul class="cs-proof__metrics n-rise d1">
          {metrics.map((m) => <li><span class="cs-proof__v">{m.value}</span><span class="cs-proof__l">{m.label}</span><span class="cs-proof__b">{m.basis}</span></li>)}
        </ul>
      )}
      {team.length > 0 && (
        <div class="cs-proof__team n-rise d2">
          <h2>On the account</h2>
          <ul>{team.map((p) => <li><b>{p.name}</b><span>{p.role}</span></li>)}</ul>
        </div>
      )}
    </div>
  </section>
)}
