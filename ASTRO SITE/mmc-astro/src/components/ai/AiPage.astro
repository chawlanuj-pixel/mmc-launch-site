---
// One AI by MMC page inside the real site shell. The body copy is the standalone build (src/components/ai/content/<key>.html,
// generated by tools/build-ai-pages.py), wrapped in .ai-scope so its stylesheet (src/styles/ai-by-mmc.css) cannot leak into the main site.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Shell from "../Shell.astro";
import "../../styles/ai-by-mmc.css";
import pages from "../../data/ai/pages.json";
import { fixDeep } from "../../lib/links";
import { AGENCY_LINE, agencyTwin } from "../../lib/whitelabel";

interface Props { pageKey: string }
const { pageKey } = Astro.props;
const P = (pages as Record<string, any>)[pageKey];
const files = import.meta.glob("./content/*.html", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const body = files[`./content/${pageKey}.html`];
// The related strip sits just before the closing "talk" band.
const talk = body.indexOf('id="talk"');
const at = talk > 0 ? body.lastIndexOf("<section", talk) : -1;
// "Are you an agency?" link to the white-label twin (src/lib/whitelabel.ts), as one more chip in the existing related row.
const twin = agencyTwin(P.path);
const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");
const agencyChip: [string, string][] = twin ? [[esc(`${AGENCY_LINE.lead} ${AGENCY_LINE.see} ${twin.anchor}`), twin.href]] : [];
const related =
  '<section class="no-section-bg band band--white xlinks" aria-labelledby="xlinks-h"><div class="wrap"><div class="head"><span class="eyebrow">Related on the main site</span>' +
  '<h2 id="xlinks-h">Part of the wider <span class="serif">MMC offer.</span></h2></div>' +
  '<div class="related">' + [...P.related, ...agencyChip].map((r: [string, string]) => `<a href="${r[1]}">${r[0]}</a>`).join("") + "</div></div></section>\n";
const html = at > 0 ? body.slice(0, at) + related + body.slice(at) : body + related;
const slug = pageKey === "index" ? "ai-by-mmc" : "ai-" + pageKey;
---
<BaseLayout title={P.title} description={P.description} path={P.path} jsonld={fixDeep(P.jsonld)}>
  <Shell source={slug}>
    <main id="main" tabindex="-1" class="app-main">
      <div class="ai-scope" data-ai-page={pageKey} set:html={html} />
    </main>
  </Shell>
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
  <script is:inline defer src="/ai-by-mmc/assets/ai-motion.js?v=4"></script>
  <script is:inline defer src="/ai-by-mmc/assets/ai.js"></script>
  <script is:inline defer src="/ai-by-mmc/assets/ai-flow-m.js"></script>
</BaseLayout>
