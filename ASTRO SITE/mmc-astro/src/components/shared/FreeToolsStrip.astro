---
// "D2C calculators" strip. One component, two variants, always fed from the TOOLS array in lib/site.ts.
//   variant="image"  hub and library pages: image cards (the /insights/ #calculators look)
//   variant="text"   compact text cards for tool-adjacent pages
// Pass `page` (a key of TOOLS_FOR) or `slugs`. Sits ABOVE the pre-footer band, never inside it.
// Rules: the sub line shows only when all six are listed; "Open the calculator" is used only for /tools/* links.
import { TOOLS, TOOLS_FOR, TOOLS_LABEL, toolBySlug } from "../../lib/site";
interface Props { page?: string; slugs?: string[]; variant?: "image" | "text"; bg?: "white" | "paper"; id?: string; all?: boolean }
const { page, slugs, variant = "image", bg = "paper", id = "free-tools", all = false } = Astro.props;
const keys = all ? TOOLS.map((t) => t.slug) : (slugs ?? (page ? TOOLS_FOR[page] : undefined) ?? []);
const list = keys.map((k) => toolBySlug(k)).filter(Boolean) as typeof TOOLS;
const IMG: Record<string, string> = {
  "unit-economics": "/assets/res/unit.jpg", "breakeven-roas": "/assets/res/roas.jpg", "ltv-cac": "/assets/res/ltv.jpg",
  "funnel-roas": "/assets/res/funnel.jpg", "cac-runway": "/assets/res/runway.jpg", "growth-trajectory": "/assets/contact/growth.jpg",
};
const showSub = list.length === TOOLS.length;
const label = (h: string) => (h.startsWith("/tools/") ? "Open the calculator" : "Open");
const arrow = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
---
{list.length > 0 && (
<section class={`fts fts--${bg} fts--${variant}`} id={id} aria-labelledby={id + "-h"} data-free-tools>
  <div class="fts__wrap">
    <div class="fts__head">
      <div>
        <p class="fts__eyebrow">{TOOLS_LABEL}</p>
        <h2 class="fts__h" id={id + "-h"}><b>Run the numbers</b> <em>yourself.</em></h2>
        {showSub && <p class="fts__sub">Six calculators. No email, no signup.</p>}
      </div>
      <a class="fts__all" href="/tools/">See all free tools<Fragment set:html={arrow} /></a>
    </div>
    <div class={"fts__grid fts__grid--" + Math.min(list.length, 4)}>
      {list.map((t) => (
        <a class="fts__card" href={t.href}>
          {variant === "image" && <span class="fts__pic"><img src={IMG[t.slug]} alt="" width="400" height="200" loading="lazy" decoding="async" /></span>}
          <b>{t.short}</b>
          <span class="fts__d">{t.blurb}</span>
          <span class="fts__go">{variant === "image" ? label(t.href) : "Run it"}<span class="fts__chip" aria-hidden="true"><Fragment set:html={arrow} /></span></span>
        </a>
      ))}
    </div>
  </div>
</section>
)}
<style is:global>
  .fts { padding-block: clamp(48px, 6vw, 88px); }
  .fts--white { background: #fff; } .fts--paper { background: #FBFAF6; }
  .fts__wrap { width: 100%; max-width: var(--shell-max, 1240px); margin: 0 auto; padding-inline: var(--shell-pad, 20px); }
  .fts__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 32px; margin-bottom: clamp(24px, 3vw, 40px); }
  .fts__eyebrow { margin: 0 0 8px; font: 700 12.5px/1.2 "Nunito", sans-serif; letter-spacing: .08em; text-transform: uppercase; color: #1E40AF; }
  .fts__h { margin: 0; font: 400 clamp(28px, 3.4vw, 44px)/1.08 "Raleway", sans-serif; letter-spacing: -.028em; color: #0F1E5E; text-wrap: balance; }
  .fts__h b { font-weight: 800; } .fts__h em { font-weight: 600; color: #1D4ED8; }
  .fts__sub { margin: 10px 0 0; font: 400 16px/1.5 "Nunito", sans-serif; color: #3F4A6B; }
  .fts__all { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font: 700 14px "Nunito", sans-serif; color: #1E40AF; text-decoration: none; }
  .fts__all svg { width: 16px; height: 16px; transition: transform .2s ease; }
  .fts__all:hover svg { transform: translateX(4px); }
  .fts__grid { display: grid; gap: 20px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .fts__grid--1 { grid-template-columns: minmax(0, 420px); }
  .fts__grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .fts__grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .fts__card { display: flex; flex-direction: column; gap: 8px; padding: 20px; background: #fff; border: 1px solid #E3E7F1; border-radius: 22px; text-decoration: none; color: inherit; transition: border-color .2s ease, transform .25s ease, box-shadow .25s ease; }
  .fts--white .fts__card { background: #FBFAF6; }
  .fts__card:hover, .fts__card:focus-visible { border-color: #1D4ED8; transform: translateY(-4px); box-shadow: 0 14px 34px rgba(15,30,94,.12); }
  .fts__card:focus-visible { outline: 3px solid #1D4ED8; outline-offset: 2px; }
  .fts__pic { display: block; height: 96px; border-radius: 14px; overflow: hidden; margin-bottom: 4px; }
  .fts__pic img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fts__card b { font: 800 20px/1.2 "Raleway", sans-serif; letter-spacing: -.015em; color: #0F1E5E; }
  .fts__d { font: 400 15px/1.5 "Nunito", sans-serif; color: #3F4A6B; }
  .fts__go { margin-top: auto; padding-top: 4px; display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 44px; font: 700 14px "Nunito", sans-serif; color: #1E40AF; }
  .fts__chip { flex: none; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: #0F1E5E; color: #fff; transition: transform .2s ease, background .2s ease; }
  .fts__chip svg { width: 15px; height: 15px; }
  .fts__card:hover .fts__chip { transform: translateX(4px); background: #1D4ED8; }
  .fts--text .fts__card { padding: 18px 20px; }
  @media (max-width: 1000px) { .fts__grid--3, .fts__grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .fts__grid, .fts__grid--2, .fts__grid--3, .fts__grid--4 { grid-template-columns: 1fr; } .fts__card b { font-size: 19px; } .fts__card { gap: 12px; } .fts__pic { height: auto; aspect-ratio: 16 / 10; margin-bottom: 2px; } }
  @media (prefers-reduced-motion: reduce) { .fts__card, .fts__chip, .fts__all svg { transition: none; } .fts__card:hover { transform: none; } }
</style>
