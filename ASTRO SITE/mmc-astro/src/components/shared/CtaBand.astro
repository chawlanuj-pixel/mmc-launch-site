---
// Mid-page CTA band. One filled button that opens the booking modal, one text link.
import "../../styles/hub-v2.css";
import { BOOK, SECONDARY } from "../../lib/site";
import { href } from "../../lib/links";
interface Props { source: string; h2a?: string; h2b?: string; lede?: string; img?: string; alt?: string }
const { source, h2a = "Want this run for", h2b = "your brand?", lede = "Tell us what you sell and who you sell to. We will tell you where we would start, whether you are a D2C brand, a B2B company or an educational institute.", img, alt = "" } = Astro.props as Props;
---
<section class="n-band hv2h-cta" aria-labelledby="hv2h-cta-h">
  <div class="n-wrap hv2h-cta__in">
    {img ? <img class="hv2h-cta__img" src={"/assets/" + img} alt={alt} width="640" height="480" loading="lazy" decoding="async" /> : null}
    <div class="hv2h-cta__copy">
      <h2 class="hv2h-cta__h" id="hv2h-cta-h"><b>{h2a}</b> <em>{h2b}</em></h2>
      <p class="hv2h-cta__p">{lede}</p>
      <div class="hv2h-cta__act">
        <button type="button" class="btn btn--primary glow-btn" onclick={`window.mmcBookCall('${source}-mid', event)`}><span class="glow-btn__glow" aria-hidden="true"></span><span class="glow-btn__inner">{BOOK}<span class="arrow"></span></span></button>
        <a class="hv2h-cta__link" href={href("/audit/")}>{SECONDARY.audit}</a>
      </div>
    </div>
  </div>
</section>
