---
// The one proof wall. Brands and tags come from data/work-clients.json (never typed by hand), a tile links to
// /work/<id>/ only when that case study exists. With no showable brand it shows one honest line instead.
import "../../styles/svc-blocks.css";
import WallCell from "../pages/WallCell.astro";
import Arrow from "../hub/Arrow.astro";
import { CLIENTS } from "../../lib/hub";
import { href } from "../../lib/links";
import { BOOK, SECONDARY } from "../../lib/site";
import { BRANDS } from "../../lib/work";
import BrandMeta from "../work/BrandMeta.astro";

interface Props {
  /** work-clients service codes; a brand is shown when it has any of them (ignored when `ids` is given) */
  codes?: string[];
  /** explicit brand ids, in order */
  ids?: string[];
  /** restrict to brand types, e.g. ["D2C"] */
  types?: string[];
  /** what we do for them, for the headline: "run Meta ads for" -> "A few of the brands we run Meta ads for." */
  does: string;
  /** spread the pick across D2C and non-D2C instead of file order */
  mix?: boolean;
  max?: number;
  book?: string;
  tone?: "white" | "paper";
}
const { codes = [], ids, types, does, mix = false, max = 6, book = "proof", tone = "paper" } = Astro.props as Props;

// Brands, labels and tags come from src/lib/work.ts (the one client book). `types` keeps its old meaning:
// "D2C" = D2C label, "B2B" = B2B label, "B2C" = Education and Other consumer.
const legacyType = (g: string) => (g === "d2c" ? "D2C" : g === "b2b" ? "B2B" : "B2C");
const caseIds = new Set(BRANDS.filter((b) => b.hasCase).map((b) => b.id));
let rows = BRANDS.map((c) => ({ id: c.id, type: legacyType(c.group), services: c.services })).filter((c) => c.id && CLIENTS[c.id]);
if (ids) rows = ids.map((i) => rows.find((r) => r.id === i)).filter(Boolean) as typeof rows;
else {
  rows = rows.filter((r) => r.services.some((s) => codes.includes(s)));
  if (types) rows = rows.filter((r) => types.includes(r.type));
  if (mix) { const d = rows.filter((r) => r.type === "D2C"), o = rows.filter((r) => r.type !== "D2C"); rows = []; for (let i = 0; i < Math.max(d.length, o.length); i++) { if (o[i]) rows.push(o[i]); if (d[i]) rows.push(d[i]); } }
}
rows = rows.slice(0, max);
const n = rows.length;
---
<section class={"n-band pm-band svb-proof n-band--" + tone + (n === 1 ? " svb-proof--one" : n === 2 ? " svb-proof--two" : "")} id="proof" aria-labelledby="proof-h">
  <div class="n-wrap">
    <div class="svb-head n-rise" style="margin-bottom:0">
      <span class="n-eyebrow">{n ? "A few of the brands" : "Proof"}</span>
      {n
        ? <h2 class="n-h2" id="proof-h">A few of the brands we <span class="n-serif">{does}.</span></h2>
        : <h2 class="n-h2" id="proof-h">Proof, <span class="n-serif">on the call.</span></h2>}
      {n ? <p class="svb-lede">The tags show what we run for each. On a computer, hover a logo to see the work.</p> : null}
    </div>
    {n ? (
      <div class="n-wall pm-wall">
        {rows.map((r) => (
          <div class="pm-wall__item">
            {caseIds.has(r.id)
              ? <a class="svb-proof__tile" href={`/work/${r.id}/`} aria-label={`${CLIENTS[r.id].name}: see the case study`}><WallCell id={r.id} /></a>
              : <WallCell id={r.id} />}
            <BrandMeta id={r.id} />
          </div>
        ))}
      </div>
    ) : (
      <div class="svb-proof__none n-rise d1" style="margin-top:clamp(28px,3vw,44px)">
        <p>Results are shared on the audit call.</p>
        <button type="button" class="svb-link" onclick={`window.mmcBookCall('${book}', event)`}>{BOOK}<Arrow /></button>
      </div>
    )}
    <div class="svb-proof__foot">
      <a class="svb-link" href={href("Our Work.html")}>{n ? SECONDARY.moreWork : SECONDARY.work}<Arrow /></a>
    </div>
  </div>
</section>
