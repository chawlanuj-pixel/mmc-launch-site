---
// Paid-landing-page lead form. Four fields: name, WhatsApp, website, monthly ad spend. Consent is one line (DPDP). Submits through
// window.MMCForms.submitLead (same path as every other MMC form), then goThanks() sends the visitor to /thank-you/.
// Several can sit on one page: ids carry `where`, the page script binds every [data-lp-form]. `where` names the placement for the lead source.
// Spend is a native radio group drawn as chips (arrow keys move between them); each field has its own error line ([data-err]).
import { PHONE_DISPLAY, PHONE_TEL } from "../../lib/site";
interface Props { where: string; city: string; tone?: "light" | "dark" }
const { where, city, tone = "light" } = Astro.props as Props;
const spend = ["Under ₹2L", "₹2L to ₹5L", "₹5L to ₹15L", "₹15L+"];
const uid = "lpf-" + where;
---
<form class={"lp-form lp-form--" + tone} data-lp-form data-where={where} data-city={city} novalidate aria-labelledby={uid + "-h"}>
  <div class="hp-field" aria-hidden="true"><label>Leave this field empty<input type="text" name="_hp" tabindex="-1" autocomplete="off" /></label></div>
  <h2 class="lp-form__h" id={uid + "-h"}>Get my free <em>audit</em></h2>
  <p class="lp-form__sub">A rough picture is enough. A senior strategist reads your ad accounts before the call.</p>
  <div class="lp-form__row">
    <div class="lp-fw">
      <label class="lp-f" for={uid + "-name"}><span>Your name</span><input id={uid + "-name"} type="text" name="name" required autocomplete="name" placeholder="Aanya Sharma" aria-describedby={uid + "-name-e"} /></label>
      <p class="lp-ferr" id={uid + "-name-e"} data-err="name" hidden></p>
    </div>
    <div class="lp-fw">
      <label class="lp-f" for={uid + "-phone"}><span>WhatsApp number</span><input id={uid + "-phone"} type="tel" name="phone" required inputmode="tel" autocomplete="tel" maxlength="20" placeholder="+91 98765 43210" aria-describedby={uid + "-phone-e"} /></label>
      <p class="lp-ferr" id={uid + "-phone-e"} data-err="phone" hidden></p>
    </div>
  </div>
  <div class="lp-fw">
    <label class="lp-f" for={uid + "-site"}><span>Website or brand name</span><input id={uid + "-site"} type="text" name="brand" required autocomplete="url" placeholder="yourbrand.com" aria-describedby={uid + "-brand-e"} /></label>
    <p class="lp-ferr" id={uid + "-brand-e"} data-err="brand" hidden></p>
  </div>
  <fieldset class="lp-f lp-f--chips" aria-describedby={uid + "-spend-e"}><legend>Monthly ad spend</legend>
    <div class="lp-chips">{spend.map((b) => <label class="lp-chip"><input type="radio" name="spend" value={b} required /><span>{b}</span></label>)}</div>
    <p class="lp-ferr" id={uid + "-spend-e"} data-err="spend" hidden></p>
  </fieldset>
  <div class="lp-fw">
    <label class="lp-consent"><input type="checkbox" name="consent" required aria-describedby={uid + "-consent-e"} /><span>I agree to MMC using these details to reply, as described in the <a href="/privacy/" target="_blank" rel="noreferrer">privacy policy</a>.</span></label>
    <p class="lp-ferr" id={uid + "-consent-e"} data-err="consent" hidden></p>
  </div>
  <p class="lp-err" role="alert" hidden></p>
  <button type="submit" class="lp-btn lp-btn--submit">Get my free audit<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6" /></svg></button>
  <p class="lp-form__fine">No pitch deck. No spam. Prefer a person? <a href={"tel:" + PHONE_TEL}>Call {PHONE_DISPLAY}</a>.</p>
</form>
