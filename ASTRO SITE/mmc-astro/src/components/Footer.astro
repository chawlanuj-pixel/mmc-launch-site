---
// Footer, "Option A, slim hubs" (owner choice, 2026-10-13). Static; styles in src/styles/footer3.css (prefix ft3-).
// Top row: logo, tagline, the two calls to action. Five hub columns, one contact line, the legal row ending in Sitemap.
// Phones (<= 720px): each column is a native <details> group. The markup ships with `open` so crawlers and no-JS
// visitors see every link; the script below closes the groups on phones and keeps them open on desktop.
// Previous footer: tools/backup/Footer.astro.before-footer3.
import "../styles/footer3.css";
import { href } from "../lib/links";
import { BOOK, PHONE_DISPLAY, PHONE_TEL } from "../lib/site";
interface Props { cta?: { label: string; href: string; nav?: boolean } }
// Default primary: BOOK, opens the booking modal. Hiring pages pass { nav: true, label, href } for a plain link.
const { cta } = Astro.props;
const nav = !!(cta && cta.nav);
const ctaLabel = nav ? cta!.label : BOOK;
const ctaHref = nav ? cta!.href : "https://calendly.com/mmc-agency-ww/audit-onboarding-calls";

interface Item { name: string; url: string; hi?: boolean; desk?: boolean }
// `all` is the phone label of the hub link ("All services"); null hides it on phones where the list already starts with it.
interface Col { hub: string; url: string; all: string | null; items: Item[] }
const cols: Col[] = [
  { hub: "Services", url: "/services/", all: "All services", items: [
    { name: "Performance marketing", url: "/services/performance-marketing/" },
    { name: "SEO and AI search", url: "/services/seo/" },
    { name: "Shopify and websites", url: "/services/shopify-development/" },
    { name: "Branding and packaging", url: "/services/branding/" },
    { name: "AI by MMC", url: "/ai-by-mmc/" },
  ] },
  { hub: "Industries", url: "/industries/", all: "All industries", items: [
    { name: "D2C brands", url: "/industries/d2c/" },
    { name: "B2B companies", url: "/industries/b2b/" },
    { name: "Education", url: "/industries/education/" },
    { name: "All industries", url: "/industries/", desk: true },
  ] },
  { hub: "White label", url: "/white-label/", all: "All white-label services", items: [
    { name: "White-label SEO", url: "/white-label/seo/" },
    { name: "White-label web development", url: "/white-label/web-development/" },
    { name: "Reseller programme", url: "/white-label/reseller-programme/" },
    { name: "Register as a partner", url: "/white-label/register/", hi: true },
  ] },
  { hub: "Resources", url: "/resources/", all: "All resources", items: [
    { name: "Our work", url: "/work/" },
    { name: "Guides", url: "/guides/" },
    { name: "Calculators", url: "/tools/" },
    { name: "Glossary", url: "/glossary/" },
  ] },
  { hub: "Company", url: "/about/", all: null, items: [
    { name: "About MMC", url: "/about/" },
    { name: "Careers", url: "/careers/" },
    { name: "Locations", url: "/locations/" },
    { name: "Contact", url: "/contact/" },
  ] },
];
const arrow = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
---
<footer id="footer" class="ft3 ink-ground">
  <div class="ft3__in">
    <div class="ft3__top">
      <div class="ft3__brand">
        <a class="ft3__logo" href="/" aria-label="Monday Marketing Company, home">
          <img src="/assets/logo-white-yellow.png" alt="MMC, Monday Marketing Company" width="120" height="100" loading="lazy" decoding="async" />
        </a>
        <div class="ft3__brand-txt">
          <p class="ft3__tag">Design × Marketing × Technology × Content × AI</p>
          <p class="ft3__since">Quietly outperforming, since 2015.</p>
        </div>
      </div>
      <div class="ft3__acts">
        {nav
          ? <a class="ft3__book" href={ctaHref}>{ctaLabel}<Fragment set:html={arrow} /></a>
          : <a class="ft3__book" href={ctaHref} target="_blank" rel="noreferrer" data-ft-book>{ctaLabel}<Fragment set:html={arrow} /></a>}
        <a class="ft3__audit" href="/audit/" data-ft-brief>Get my free audit</a>
      </div>
    </div>

    <nav class="ft3__cols" aria-label="Footer">
      {cols.map((c) => (
        <details class="ft3__grp" open data-ft3-grp>
          <summary class="ft3__sum"><span>{c.hub}</span><svg class="ft3__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"/></svg></summary>
          <a class={"ft3__hub" + (c.all ? "" : " ft3__hub--desk")} href={href(c.url)}>
            <span class="ft3__hub-d">{c.hub}</span>{c.all && <span class="ft3__hub-m">{c.all}</span>}<Fragment set:html={arrow} />
          </a>
          <ul class="ft3__list">
            {c.items.map((it) => (
              <li class={it.desk ? "ft3__desk" : undefined}><a class={it.hi ? "ft3__hi" : undefined} href={href(it.url)}>{it.name}</a></li>
            ))}
          </ul>
        </details>
      ))}
    </nav>

    <div class="ft3__contact">
      <div class="ft3__reach">
        <a class="ft3__strong" href={"tel:" + PHONE_TEL}>{PHONE_DISPLAY}</a>
        <a class="ft3__strong ft3__mail" href="mailto:sales-in@mondaymarketing.company">sales-in@mondaymarketing.company</a>
        <a class="ft3__place" href="/locations/mumbai/">Mumbai, Maharashtra</a>
      </div>
      <div class="ft3__social">
        <a href="https://www.instagram.com/monday.marketing.co/" target="_blank" rel="noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/></svg>
          <span>Instagram</span>
        </a>
        <a href="https://in.linkedin.com/company/monday-marketing-company" target="_blank" rel="noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M8 10.5V16M8 7.8v.1M11.5 16v-3.2a2.3 2.3 0 0 1 4.6 0V16M11.5 10.5V16"/></svg>
          <span>LinkedIn</span>
        </a>
      </div>
    </div>

    <div class="ft3__legal">
      <p class="ft3__copy">© 2026 Monday Marketing Company<span class="ft3__sep" aria-hidden="true">·</span><span class="ft3__llp">Operated by Studio27 Creative Media Works LLP</span></p>
      <div class="ft3__legal-links">
        <a href={href("/privacy/")}>Privacy</a>
        <a href={href("/terms/")}>Terms</a>
        <a href="#" data-ft-cookies>Cookies</a>
        <a href="/sitemap/">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<script>
  // Wire the footer buttons to the global helpers from public/assets/mmc-forms.js and the cookie banner.
  const w = window as any;
  document.querySelectorAll("[data-ft-book]").forEach((el) =>
    el.addEventListener("click", (e) => { if (w.mmcBookCall) w.mmcBookCall("footer", e); }));
  // The audit modal is left out of one private pricing page (PricingShell audit=false); there the link opens /audit/ instead.
  const hasAudit = () => !!document.querySelector('astro-island[component-url*="AuditModal"], .audit');
  document.querySelectorAll("[data-ft-brief]").forEach((el) =>
    el.addEventListener("click", (e) => { if (w.mmcOpenBrief && hasAudit()) w.mmcOpenBrief(e); }));
  // Phone link clicks: the same contact-click event the mobile bar sends (contact_method tells phone from WhatsApp). No personal data.
  document.querySelectorAll<HTMLAnchorElement>('footer a[href^="tel:"]').forEach((el) =>
    el.addEventListener("click", () => { try { (w.dataLayer = w.dataLayer || []).push({ event: "whatsapp_click", cta_source: "footer-phone", contact_method: "phone" }); } catch (e) {} }));
  document.querySelectorAll("[data-ft-cookies]").forEach((el) =>
    el.addEventListener("click", (e) => { e.preventDefault(); if (w.__mmcOpenCookies) w.__mmcOpenCookies(); }));

  // Phone accordions: closed on phones, always open on desktop (where the summary is hidden). Follows resizes and rotation.
  const groups = document.querySelectorAll<HTMLDetailsElement>("[data-ft3-grp]");
  const mq = window.matchMedia("(max-width: 720px)");
  const sync = () => groups.forEach((d) => { d.open = !mq.matches; });
  sync();
  mq.addEventListener("change", sync);
</script>
