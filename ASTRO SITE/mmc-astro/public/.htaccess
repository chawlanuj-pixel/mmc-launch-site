# MMC launch .htaccess for Hostinger / Apache. Lives in public/ so every build copies it to the site root (dist/.htaccess).
# Order matters: every redirect points straight at https://www.mondaymarketing.company, so an old URL on http or the bare domain
# reaches its final page in ONE hop. The generic https + www + trailing-slash rules come last and catch everything else.
# Sources: old WordPress map from SEO/mmc-redirects-htaccess.txt (2 Oct 2026), plus the legacy .html map from public/_redirects.
# The old WordPress /thank-you/ -> / rule was dropped on purpose: /thank-you/ is now a real page (noindex).
# public/_redirects is only read by Netlify/Cloudflare Pages; Hostinger ignores it, so this file replaces it.

<IfModule mod_rewrite.c>
RewriteEngine On

# 2. Old service pages
RewriteRule ^performance-marketing/?$ https://www.mondaymarketing.company/services/performance-marketing/ [R=301,L]
RewriteRule ^seo-company/?$ https://www.mondaymarketing.company/services/seo/ [R=301,L]
RewriteRule ^seo-company-thane/?$ https://www.mondaymarketing.company/services/seo/ [R=301,L]
RewriteRule ^e-commerce-seo-page/?$ https://www.mondaymarketing.company/services/seo/ [R=301,L]
RewriteRule ^local-seo(-2)?/?$ https://www.mondaymarketing.company/services/seo/ [R=301,L]
RewriteRule ^ui-ux-design-company-in-india/?$ https://www.mondaymarketing.company/services/ui-ux-design/ [R=301,L]
RewriteRule ^ui-ux-design/?$ https://www.mondaymarketing.company/services/ui-ux-design/ [R=301,L]
RewriteRule ^website-development-company/?$ https://www.mondaymarketing.company/services/web-development/ [R=301,L]
RewriteRule ^landing-page/?$ https://www.mondaymarketing.company/services/web-development/ [R=301,L]
RewriteRule ^pricing/?$ https://www.mondaymarketing.company/audit/ [R=301,L]
# 3. Contact and booking
RewriteRule ^contact-us/?$ https://www.mondaymarketing.company/contact/ [R=301,L]
RewriteRule ^appointments/?$ https://www.mondaymarketing.company/contact/ [R=301,L]
RewriteRule ^appointment-cal/?$ https://www.mondaymarketing.company/contact/ [R=301,L]
# 4. Legal (paths changed)
RewriteRule ^privacy-policy/?$ https://www.mondaymarketing.company/privacy/ [R=301,L]
RewriteRule ^terms-conditions/?$ https://www.mondaymarketing.company/terms/ [R=301,L]
# 5. Blog (no /blog/ on new site). If GSC shows clicks on a post, migrate it to /guides/ instead.
RewriteRule ^blog/content-marketing-agency/?$ https://www.mondaymarketing.company/services/seo/ [R=301,L]
RewriteRule ^blog/corporate-video-production-company/?$ https://www.mondaymarketing.company/services/ugc-and-video/ [R=301,L]
RewriteRule ^blog/strategies-for-website-redesign/?$ https://www.mondaymarketing.company/services/web-development/ [R=301,L]
RewriteRule ^blog/?$ https://www.mondaymarketing.company/guides/ [R=301,L]
RewriteRule ^category/.*$ https://www.mondaymarketing.company/guides/ [R=301,L]
RewriteRule ^feed/?$ https://www.mondaymarketing.company/guides/ [R=301,L]
RewriteRule ^author/.*$ https://www.mondaymarketing.company/about/ [R=301,L]
# 6. Portfolio (old entries were theme placeholders)
RewriteRule ^portfolio(/.*)?$ https://www.mondaymarketing.company/work/ [R=301,L]
# 7. Careers (/career/ -> /careers/; expired job posts -> hub)
RewriteRule ^career(/.*)?$ https://www.mondaymarketing.company/careers/ [R=301,L]
# 8. Old WordPress sitemaps and system URLs
RewriteRule ^sitemap\.xml$ https://www.mondaymarketing.company/sitemap-index.xml [R=301,L]
RewriteRule ^(sitemap_index|page-sitemap|post-sitemap|portfolio-sitemap|category-sitemap|e-landing-page-sitemap|awsm_job_openings-sitemap)\.xml$ https://www.mondaymarketing.company/sitemap-index.xml [R=301,L]
RewriteRule ^wp-(admin|login\.php).*$ https://www.mondaymarketing.company/ [R=301,L]
# 9. Preview homepage variants must never be public
RewriteRule ^(home-previous|home-v2|home-v2b)(/.*)?$ https://www.mondaymarketing.company/ [R=301,L]

# Legacy .html addresses from the first static site (from public/_redirects)
RewriteRule ^sitemap\.xml$ https://www.mondaymarketing.company/sitemap-index.xml [R=301,L]
