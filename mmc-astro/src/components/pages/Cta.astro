---
// Closing call-to-action block (MmcCta in the old assets/answer.jsx).
import { href } from "../../lib/links";
interface Props { eyebrow?: string; h2a: string; h2b: string; lede: string; label?: string; book: string; secondary?: { href: string; label: string } | null; image?: string; looks?: string[] }
const { eyebrow = "A free paid-media audit", h2a, h2b, lede, label = "Get a paid-media audit", book, image = "au/audit-call.jpg", looks = ["Break-even economics", "Account structure", "Tracking", "Creative"] } = Astro.props;
const secondary = Astro.props.secondary === undefined ? { href: "audit.html", label: "How the audit works" } : Astro.props.secondary;
---
<section class="n-band n-band--paper cta2" id="talk">
  <div class="n-wrap">
    <div class="cta2__card n-rise">
      <figure class="cta2__fig">
        <img src={"/assets/" + image} alt="" width="1024" height="688" loading="lazy" decoding="async" />
        <figcaption class="cta2__chip"><i aria-hidden="true"></i>Your numbers, on screen</figcaption>
      </figure>
      <div class="cta2__body">
        <span class="cta2__eyebrow">{eyebrow}</span>
        <h2 class="cta2__h">{h2a} <em>{h2b}</em></h2>
        <p class="cta2__lede">{lede}</p>
        {looks && looks.length ? (
          <div class="cta2__looks">
            <span class="cta2__looks-t">What the audit reads</span>
            <ul>{looks.map((t) => <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>{t}</li>)}</ul>
          </div>
        ) : null}
        <div class="cta2__act">
          <button type="button" class="cta2__btn" onclick={`window.mmcBookCall('${book}', event)`}>{label}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6" /></svg></button>
          {secondary ? <a class="cta2__link" href={href(secondary.href)}>{secondary.label}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6" /></svg></a> : null}
        </div>
      </div>
    </div>
  </div>
</section>
