---
// Insights index masthead: an editorial front page, not the hub template's tile-mosaic Hero.
interface Props { h1: [string, string]; sub: string }
const { h1, sub } = Astro.props;
---
<header class="editorial ed-masthead" id="top">
  <div class="ed-wrap">
    <div class="ed-masthead__top">
      <span class="ed-masthead__brand">MMC Insights</span>
      <span class="ed-masthead__meta">Guides, working notes and free tools for D2C, B2B and education marketers</span>
    </div>
    <div class="ix-hero">
      <div class="ix-hero__grid">
        <div>
          <span class="ed-kicker">Issue notes</span>
          <h1 class="ix-hero__h1">{h1[0]} <em>{h1[1]}</em></h1>
          <p class="ix-hero__sub">{sub}</p>
        </div>
        <p class="ix-hero__note">No fake benchmarks. Worked examples are labelled as illustrative, and every method is one you can run on your own numbers.</p>
      </div>
    </div>
  </div>
</header>
