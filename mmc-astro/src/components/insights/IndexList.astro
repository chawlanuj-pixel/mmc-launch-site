---
interface Guide { n: string; tag: string; h: string; d: string; href: string; img: string }
interface Props { guides: Guide[] }
const { guides } = Astro.props;
---
<section class="editorial ix-list">
  <div class="ed-wrap">
    {guides.map((g) => (
      <a class="ix-list__row ed-rise" href={g.href}>
        <span class="ix-list__n">{g.n}</span>
        <div class="ix-list__body">
          <span class="ix-list__tag">{g.tag}</span>
          <h3 class="ix-list__h3">{g.h}</h3>
          <p class="ix-list__p">{g.d}</p>
        </div>
        <figure class="ix-list__fig"><img src={g.img} alt="" width="400" height="300" loading="lazy" decoding="async" /></figure>
      </a>
    ))}
  </div>
</section>
