---
// Selected work: the whole portfolio reached by scrolling. Desktop pins the section and turns vertical
// scroll into horizontal travel (CSS sticky + a small rAF handler in scripts/work-rail.ts), then releases
// it. Phones, tablets, touch, short or reduced-motion screens get a plain vertical stack of the same cards.
// Styles: styles/work-rail.css (wk- prefix). The section id stays "work"; the skip control targets #voices.
import "../../styles/work-rail.css";

interface Project { id: string; name: string; tags: string[]; }
interface Props { projects?: Project[]; nextId?: string; allHref?: string; }

const DEFAULTS: Project[] = [
  { id: "giraffe", name: "The Growing Giraffe", tags: ["Conversion rate optimisation", "Performance ads, D2C", "Amazon", "Quick commerce"] },
  { id: "oosh", name: "OOsh", tags: ["Website redesign and development", "Performance ads, D2C", "Performance creative"] },
  { id: "bloom", name: "Bloom Edutours", tags: ["Website redesign and development", "Lead generation", "Performance creative", "Social media"] },
  { id: "sprnt", name: "Sprnt", tags: ["Website redesign and development", "Performance ads, D2C", "Social media"] },
  { id: "skyfling", name: "Skyfling Technologies", tags: ["Website redesign and development", "Lead generation", "Performance creative"] },
  { id: "lepure", name: "Lepure", tags: ["Website redesign and development", "Performance ads, D2C", "Performance creative", "Social media"] },
  { id: "awwbaby", name: "AwwBaby", tags: ["Website redesign and development", "Performance ads, D2C", "Performance creative"] },
  { id: "mvj", name: "MVJ College of Engineering", tags: ["Website redesign and development", "Lead generation", "Performance creative", "Social media"] },
  { id: "notic", name: "Notic", tags: ["Website redesign and development", "Performance ads, D2C", "Performance creative", "Social media"] },
  { id: "nmc", name: "NM Consultings", tags: ["Website redesign and development", "Lead generation", "Performance creative"] },
  { id: "mittiy", name: "Mittiy Made", tags: ["Conversion rate optimisation", "Performance ads, D2C", "Performance creative"] },
  { id: "vagakids", name: "Vaga Kids", tags: ["Website redesign and development", "Performance ads, D2C", "Performance creative"] },
];
const { projects = DEFAULTS, nextId = "voices", allHref = "/work/" } = Astro.props as Props;
const arrow = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
const down = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>`;
---
<section class="wk no-section-bg" id="work" data-wk data-wk-next={nextId} aria-labelledby="wk-title">
  <div class="wk__pin" data-wk-pin>
    <div class="wk__head hn-wrap">
      <div class="wk__title">
        <p class="hn-eyebrow">Selected work</p>
        <h2 id="wk-title">Real projects, <em>shown properly.</em></h2>
      </div>
      <a class="wk__skip" href={"#" + nextId} data-wk-skip>Skip to next section<Fragment set:html={down} /></a>
    </div>
    <div class="wk__view" data-wk-view>
      <ul class="wk__track" data-wk-track>
        {projects.map((c, i) => (
          <li class="wk__item">
            <a class="wk__card" href={["bloom", "lepure"].includes(c.id) ? "/work/" : "/work/" + c.id + "/"} data-wk-card>
              <img src={`/assets/clients/${c.id}-work.jpg`} alt={c.name + " project"} loading={i < 2 ? "eager" : "lazy"} decoding="async" width="1280" height="720" />
              <span class="wk__tags">{c.tags.map((t) => <span>{t}</span>)}</span>
              <span class="wk__foot"><b>{c.name}</b><span class="wk__view-cta">View<Fragment set:html={arrow} /></span></span>
            </a>
          </li>
        ))}
        <li class="wk__item wk__item--end">
          <a class="wk__card wk__card--end" href={allHref} data-wk-card>
            <span class="wk__end-eyebrow">The full portfolio</span>
            <b>Every project, in one place.</b>
            <span class="wk__end-cta">See all our work<Fragment set:html={arrow} /></span>
          </a>
        </li>
      </ul>
    </div>
    <div class="wk__bar hn-wrap" aria-hidden="true"><span class="wk__line"><i data-wk-fill></i></span></div>
  </div>
</section>
<script>
  import "../../scripts/work-rail";
</script>
