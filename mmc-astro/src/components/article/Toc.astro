---
interface Props { blocks: { id: string; h: string }[]; faqHref?: string }
const { blocks, faqHref = "#faq" } = Astro.props;
---
<nav class="art-toc" aria-label="In this guide" data-art-toc>
  <span class="art-toc__t">In this guide</span>
  <ol>
    {blocks.map((b) => <li><a href={"#" + b.id}>{b.h}</a></li>)}
  </ol>
  <div class="art-toc__extra">
    <a href={faqHref}>Jump to FAQ</a>
    <a href="/insights/">All Insights guides</a>
  </div>
</nav>
