---
// Guide article body: renders the same block data the hub template's Article.astro used
// (paras/img/list/steps/table/callout), but with editorial typography (drop cap, numbered
// process steps, pull-quote callouts, data tables) instead of the hub's gd__* card styling.
interface Block {
  id: string; h: string;
  paras?: string[]; img?: string; cap?: string;
  list?: string[];
  steps?: { t: string; d: string }[];
  table?: { caption: string; head: string[]; rows: string[][] };
  callout?: { title: string; text: string };
}
interface Props { blocks: Block[] }
const { blocks } = Astro.props;
---
<div class="art-body-col">
  {blocks.map((b) => (
    <section class="art-sec" id={b.id}>
      <h2 class="art-sec__h2">{b.h}</h2>
      {(b.paras || []).map((t) => <p set:html={t} />)}
      {b.img && (
        <figure class="art-fig">
          <img src={"/assets/" + b.img} alt="" width="1200" height="800" loading="lazy" decoding="async" />
          {b.cap && <figcaption>{b.cap}</figcaption>}
        </figure>
      )}
      {b.list && <ul class="art-list">{b.list.map((t) => <li set:html={t} />)}</ul>}
      {b.steps && (
        <ol class="art-steps">{b.steps.map((st) => <li><b>{st.t}</b><span set:html={st.d} /></li>)}</ol>
      )}
      {b.table && (
        <div class="art-tablewrap">
          <table class="art-table">
            <thead><tr>{b.table.head.map((h) => <th>{h}</th>)}</tr></thead>
            <tbody>{b.table.rows.map((r) => <tr>{r.map((c, j) => j === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
          </table>
          {b.table.caption && <p class="art-table__note">{b.table.caption}</p>}
        </div>
      )}
      {b.callout && <aside class="art-callout"><b>{b.callout.title}</b><span set:html={b.callout.text} /></aside>}
    </section>
  ))}
</div>
