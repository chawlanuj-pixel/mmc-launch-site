---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Shell from "../../components/Shell.astro";
import PageHero from "../../components/pages/PageHero.astro";
import PageFx from "../../components/pages/PageFx.astro";
import Cta from "../../components/pages/Cta.astro";
import Sticky from "../../components/pages/Sticky.astro";
import BrandWall from "../../components/pages/BrandWall.astro";
import Answer from "../../components/hub/Answer.astro";
import Img from "../../components/hub/Img.astro";
import Arrow from "../../components/hub/Arrow.astro";
import { pageHead } from "../../lib/pagehead";
import { fixDeep, href } from "../../lib/links";
import raw from "../../data/pages/services.json";
import "../../styles/sv.css";
import "../../styles/pg-wordmark.css";

const D = fixDeep(raw);
const CTA = "Book an audit call";
const WALL = [
  { id: "lepure", svc: ["Performance", "Web", "Creative", "Social"] },
  { id: "giraffe", svc: ["Performance", "CRO", "Creative", "Amazon", "Quick commerce"] },
  { id: "sprnt", svc: ["Performance", "Web", "Creative", "Social"] },
  { id: "nmc", svc: ["Web", "Lead generation", "Creative"] },
  { id: "skyfling", svc: ["Web", "Lead generation", "Creative"] },
  { id: "bloom", svc: ["Web", "Lead generation", "Creative", "Social"] },
  { id: "mvj", svc: ["Web", "Lead generation", "Creative", "Social"] },
  { id: "pandacabs", svc: ["Web", "Lead generation", "Creative", "Social"] },
  { id: "rustomjee", svc: [] },
  { id: "clubmahindra", svc: [] },
];
const book = (s: string) => `window.mmcBookCall('${s}', event)`;
---
<BaseLayout {...pageHead("services", "/services/")}>
  <Shell>
    <main class="app-main n-app">
      <PageHero wm="Services" eyebrow="● Five connected systems"
        lines={["Marketing services", 'for <span class="em-serif">D2C</span>, B2B and', "education brands."]}
        sub="Paid media, search, brand, technology and content, run by one team. Start with the system that fixes your biggest leak."
        primary={{ label: CTA, book: "services-hero" }} secondary={{ label: "See the work", href: "Our Work.html" }} rightClass="svh__r">
        <div class="svh__mosaic">
          {D.SV_SYSTEMS.map((s: any, k: number) => (
            <a class={"svh__tile svh__tile--" + (k + 1)} href={"#" + s.id} aria-label={s.label}>
              <Img name={"sv/" + s.img} ratio={k < 2 ? "4 / 3" : "1 / 1"} class="svh__img" pos={s.pos} eager={k < 2} />
              <span class="svh__cap"><i>{s.n}</i><b>{s.short}</b></span>
            </a>
          ))}
        </div>
      </PageHero>

      <Answer
        lead="Monday Marketing Company (MMC) is an India-based marketing agency for D2C, B2B and education brands. Its services sit in five systems: paid media, search and conversion, brand, technology, and content."
        hl="five systems"
        points={[
          { icon: "grid", title: "Five systems", text: "Paid media, search and conversion, brand, technology, and content." },
          { icon: "users", title: "One team runs all five", text: "So the work in one system is judged by what it does for the others." },
        ]}
        image="pm-v3/process.jpg" chip="Five systems, one team" />

      <div id="systems">
        {D.SV_SYSTEMS.map((s: any, k: number) => (
          <section class={"n-band pm-band svs " + (k % 2 ? "n-band--paper" : "n-band--white")} id={s.id}>
            <div class="n-wrap">
              <div class={"svs__row" + (k % 2 ? " is-flip" : "")}>
                <div class="svs__art n-rise"><Img name={"sv/" + s.img} ratio="3 / 2" class="svs__img" pos={s.pos} /></div>
                <div class="svs__body n-rise d1">
                  <span class="n-eyebrow">System {s.n}</span>
                  <h2 class="n-h2 svs__h">{s.label}</h2>
                  <p class="svs__desc">{s.desc}</p>
                  <ul class="svs__list">
                    {s.items.map((it: any) => (
                      <li>
                        <b>{it.n}</b>
                        <span>{it.d}</span>
                        {it.href && <a class="pm-textlink" href={it.href}>{it.link}<Arrow /></a>}
                      </li>
                    ))}
                  </ul>
                  <button class="pm-textlink" onclick={book("services-" + s.id)}>Talk to us about {s.short.toLowerCase()}<Arrow /></button>
                </div>
              </div>
            </div>
          </section>
        ))}
      </div>

      <section class="n-band n-band--ink pm-band" id="start">
        <div class="n-wrap">
          <div class="pm-head n-rise">
            <span class="n-eyebrow">Where to start</span>
            <h2 class="n-h2">Start from the problem, <span class="n-serif">not the service.</span></h2>
          </div>
          <ul class="svt n-rise d1">
            {D.SV_START.map(([p, id, to]: string[]) => (
              <li><a href={"#" + id}><span>{p}</span><b>{to}<Arrow /></b></a></li>
            ))}
          </ul>
        </div>
      </section>

      <section class="n-band n-band--white pm-band" id="work">
        <div class="n-wrap">
          <div class="pm-head n-rise" style="margin-bottom:0">
            <span class="n-eyebrow">The brands</span>
            <h2 class="n-h2">A few of the brands we <span class="n-serif">work with.</span></h2>
            <p class="n-lede">D2C, B2B, education and other consumer-facing brands. Hover any one to see the work. Where a brand has no tags, we have not recorded the mix yet.</p>
          </div>
          <BrandWall items={WALL} />
          <div class="pm-proof__foot">
            <a class="pm-textlink" href={href("Our Work.html")}>See more of our work<Arrow /></a>
            <a class="pm-textlink" href={href("breakeven-roas-calculator.html")}>Try the break-even ROAS calculator<Arrow /></a>
          </div>
        </div>
      </section>

      <section class="n-band n-band--paper pm-band" id="faq">
        <div class="n-wrap">
          <div class="pm-head n-rise">
            <span class="n-eyebrow">Common questions</span>
            <h2 class="n-h2">What people ask <span class="n-serif">first.</span></h2>
          </div>
          <div class="pm-faq n-rise">
            {D.SV_FAQ.map((f: any, k: number) => (
              <details open={k === 0}>
                <summary>{f.q}</summary>
                <div class="pm-faq__a"><p set:html={f.a} /></div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <Cta eyebrow="Not sure where to start?" h2a="Tell us the problem. We will say" h2b="which system fixes it."
        lede="On a call, with a senior strategist. We look at your accounts and tell you where to start." label={CTA} book="services-final" />
    </main>
    <Sticky label={CTA} book="services-sticky" />
  </Shell>
  <PageFx />
</BaseLayout>
