---
// Our Work / portfolio index. Bespoke hero and section shapes: no hub Hero, Answer or Stages
// (see DIFFERENTIATION-BRIEF.md). Links into a real case-study detail page for every brand with
// client-approved artwork in public/assets/work2/; the rest of the client book stays wall-only.
import BaseLayout from "../layouts/BaseLayout.astro";
import Shell from "../components/Shell.astro";
import Faq from "../components/hub/Faq.astro";
import Closing from "../components/company/Closing.astro";
import WorkWall from "../components/work/WorkWall.astro";
import caseBook from "../data/case-studies.json";
import "../styles/case-study.css";
import "../styles/work-pages.css";

const SVC: Record<string, string> = (caseBook as any)._services;
const cases = (caseBook as any).items as any[];

const title = "Our Work: Case Studies and Brands We Work With | MMC";
const description = "Case studies and a brand wall from Monday Marketing Company, grouped by D2C, B2B, education and other consumer brands, with the services recorded for each.";
const SITE = "https://www.mondaymarketing.company";

const faq = [
  { q: "What kinds of brands does MMC work with?", a: 'D2C brands that sell direct to shoppers, B2B companies that win business from other businesses, and education brands that enrol students. We also work with other consumer-facing brands such as property, hospitality and mobility. See the <a href="/industries/d2c/">D2C</a>, <a href="/industries/b2b/">B2B</a> and <a href="/industries/education/">education</a> pages.' },
  { q: "Why do some brands only show a logo, with no case study?", a: "A case study needs real artwork or a work image on record. Where we only have a logo, we show the logo and the services recorded for that brand, and nothing more, rather than guess at what a page might have looked like." },
  { q: "Do you publish results for each brand?", a: 'Not on this page. We do not publish performance figures unless we can back them up with real, checkable numbers. The way we judge our own work is in the <a href="/guides/contribution-margin-roas/">contribution margin and break-even ROAS guide</a>.' },
  { q: "Can you work with a brand like ours if it is not on the wall?", a: 'Very likely. The approach is the same whatever the category: work out what a sale or an enrolment is worth, then build the media, creative and follow-up around it. A <a href="/audit/">free audit</a> is the quickest way to find out.' },
];

const jsonld = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "@id": SITE + "/work/#breadcrumb", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE + "/" },
    { "@type": "ListItem", position: 2, name: "Our Work", item: SITE + "/work/" } ] },
  { "@context": "https://schema.org", "@type": "CollectionPage", "@id": SITE + "/work/#webpage", url: SITE + "/work/", name: title, description,
    isPartOf: { "@id": SITE + "/#website" }, breadcrumb: { "@id": SITE + "/work/#breadcrumb" }, publisher: { "@id": SITE + "/#organization" }, inLanguage: "en",
    hasPart: cases.map((c) => ({ "@type": "CreativeWork", name: `${c.name} case study`, url: SITE + `/work/${c.id}/` })) },
  { "@context": "https://schema.org", "@type": "FAQPage", "@id": SITE + "/work/#faq", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") } })) },
];

const KINDS_TABS = [
  { k: "all", l: "All case studies" },
  { k: "d2c", l: "D2C" },
  { k: "b2b", l: "B2B" },
  { k: "edu", l: "Education" },
  { k: "consumer", l: "Other consumer" },
];
const GROUP_LABEL: Record<string, string> = (caseBook as any)._groupLabel;

const KINDS = [
  { k: "D2C", href: "/industries/d2c/", tag: "See the D2C page", breaks: "A shopper decides in seconds, on a phone.", does: "We start from the margin on an order, then shape ads, creative, the store and retention around it.", img: "d2c/range.jpg" },
  { k: "B2B", href: "/industries/b2b/", tag: "See the B2B page", breaks: "A buyer researches for weeks and talks to several people.", does: "We build a clear website, useful proof and lead generation that filters for fit, then help the follow-up so leads become conversations.", img: "b2b/casestudy.jpg" },
  { k: "Education", href: "/industries/education/", tag: "See the education page", breaks: "A family compares colleges over weeks, with a deadline.", does: "We run search and paid campaigns around courses and intakes, and follow every enquiry up until it becomes an enrolment.", img: "edu/campus.jpg" },
  { k: "Other consumer brands", href: "/audit/", tag: "Talk to us", breaks: "A big purchase, a long think, and the sale often closes offline.", does: "We build enquiry-led funnels: clear pages, targeted media and quick follow-up by call or message, judged on the cost of a real enquiry.", img: "work/enquiry.jpg" },
];
---
<BaseLayout title={title} description={description} path="/work/" ogTitle="Our work: case studies and brands" ogDescription="Real case studies and a brand wall across D2C, B2B, education and other consumer categories." ogAlt="Monday Marketing Company: our work." jsonld={jsonld}>
  <Shell>
    <main class="app-main n-app">
      <section class="cw-hero">
        <span class="cw-hero__wm" aria-hidden="true">Work</span>
        <div class="n-wrap cw-hero__grid">
          <div>
            <span class="cw-hero__eyebrow">Our work</span>
            <h1 class="cw-hero__h1 n-rise">Real projects,<br /><em>not a slide deck.</em></h1>
            <p class="cw-hero__sub n-rise d1">Case studies built from the actual sites, ad creative and social work we shipped, plus a wall of a few of the other brands we work with across D2C, B2B and education.</p>
            <div class="cw-hero__row n-rise d2">
              <a class="btn btn--primary glow-btn" href="#cases"><span class="glow-btn__glow" aria-hidden="true"></span><span class="glow-btn__inner">See the case studies<span class="arrow"></span></span></a>
              <a class="btn btn--link" href="#brands">See the full brand wall<span class="arrow"></span></a>
            </div>
          </div>
          <div class="cw-hero__figs n-rise d1">
            <span class="cw-hero__fig"><img src="/assets/work2/notic-case.jpg" alt="" width="900" height="675" loading="eager" decoding="async" /></span>
            <span class="cw-hero__fig"><img src="/assets/work2/sprnt-case.jpg" alt="" width="900" height="675" loading="eager" decoding="async" /></span>
          </div>
        </div>
      </section>

      <section class="n-band n-band--white" id="cases">
        <div class="n-wrap">
          <div class="cw-grid__head n-rise">
            <span class="n-eyebrow">Case studies</span>
            <h2 class="n-h2">Thirteen brands, <span class="n-serif">shown in full.</span></h2>
            <p class="n-lede">Every case study below is built from real, client-approved artwork: the actual website, ad creative and social work, not a mockup of what it might have looked like.</p>
          </div>
          <div class="cw-tabs" role="tablist" aria-label="Filter case studies by kind">
            {KINDS_TABS.map((t, i) => <button type="button" role="tab" class={"wk__tab" + (i === 0 ? " is-on" : "")} data-cf={t.k} aria-selected={i === 0 ? "true" : "false"}>{t.l}</button>)}
          </div>
          <div class="cw-grid" data-cwgrid>
            {cases.map((c) => (
              <a class="cw-card n-rise" href={`/work/${c.id}/`} data-g={c.group}>
                <span class="cw-card__fig">
                  <img src={`/assets/${c.image}`} alt="" loading="lazy" decoding="async" />
                  <span class="cw-card__logo"><img src={`/assets/clients/${c.id}.png`} alt={c.name} loading="lazy" decoding="async" /></span>
                  <span class="cw-card__type">{c.type}</span>
                </span>
                <span class="cw-card__body">
                  <strong class="cw-card__name">{c.name}</strong>
                  <span class="cw-card__scope">{c.scope}</span>
                  <span class="cw-card__svc">{c.services.map((s: string) => <span>{SVC[s]}</span>)}</span>
                  <span class="cw-card__go">Read the case study
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
                  </span>
                </span>
              </a>
            ))}
          </div>
          <p class="cw-note">Every image above is real client-approved artwork supplied by the brand, cropped for the web. None of it is a live screenshot, and none of it carries a performance figure.</p>
        </div>
      </section>

      <WorkWall />

      <section class="n-band n-band--white" id="kinds">
        <div class="n-wrap">
          <div class="pm-head n-rise">
            <span class="n-eyebrow">How we work with each kind of brand</span>
            <h2 class="n-h2">The same discipline. <span class="n-serif">A different job for each kind.</span></h2>
            <p class="n-lede">Every audience buys differently, so the work starts from a different question.</p>
          </div>
          <div class="cw-kinds n-rise d1">
            {KINDS.map((k) => (
              <article class="cw-kind">
                <span class="cw-kind__k">{k.k}</span>
                <h3>{k.breaks}</h3>
                <p>{k.does}</p>
                <a href={k.href}>{k.tag}<span aria-hidden="true"> →</span></a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="n-band n-band--paper pm-band" id="beyond-d2c">
        <div class="n-wrap">
          <div class="pm-head n-rise">
            <span class="n-eyebrow">Beyond D2C</span>
            <h2 class="n-h2">Consumer brands beyond <span class="n-serif">the online shop.</span></h2>
            <p class="n-lede">Some of the brands on the wall sell homes, holidays or rides rather than products. The job there is a steady flow of real enquiries.</p>
          </div>
          <div class="wk__kinds n-rise d1">
            <article class="wk__kind"><img src="/assets/work/consumer.jpg" alt="" width="1200" height="800" loading="lazy" decoding="async" /><h3>Property</h3><p>Buyers visit, compare and come back. Follow-up decides who they choose.</p></article>
            <article class="wk__kind"><img src="/assets/work/hospitality.jpg" alt="" width="1200" height="800" loading="lazy" decoding="async" /><h3>Hospitality</h3><p>People book a stay on a picture and a feeling. Photos and clear offers do the work.</p></article>
            <article class="wk__kind"><img src="/assets/work/mobility.jpg" alt="" width="1200" height="800" loading="lazy" decoding="async" /><h3>Mobility</h3><p>Local demand, quick decisions. Search and simple lead paths bring the calls.</p></article>
          </div>
        </div>
      </section>

      <Faq title={["Questions about", "our work."]} faq={faq.map((f) => ({ q: f.q, a: f.a }))} />

      <Closing
        eyebrow="Want to work with us"
        h2a="Want your brand"
        h2b="on this wall?"
        lede="Start with a free audit. A senior strategist reads your campaigns against what a sale, a lead or an enrolment is worth to you."
        image="work/review.jpg"
        chip="Reviewing work together"
        label="Get a free audit"
        brief={true}
        secondary={{ href: "/audit/", label: "How the audit works" }}
      />
    </main>
  </Shell>
  <script>import "../scripts/hub.ts";</script>
  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>(".cw-tabs .wk__tab");
    const cards = document.querySelectorAll<HTMLElement>(".cw-grid [data-g]");
    function apply(k: string) {
      cards.forEach((el) => { el.hidden = !(k === "all" || el.dataset.g === k); });
      tabs.forEach((t) => { const on = t.dataset.cf === k; t.classList.toggle("is-on", on); t.setAttribute("aria-selected", String(on)); });
    }
    tabs.forEach((t) => t.addEventListener("click", () => apply(t.dataset.cf || "all")));
  </script>
</BaseLayout>
