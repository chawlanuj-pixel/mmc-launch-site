---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Shell from "../../../components/Shell.astro";
import PageHero from "../../../components/pages/PageHero.astro";
import PageFx from "../../../components/pages/PageFx.astro";
import Cta from "../../../components/pages/Cta.astro";
import Sticky from "../../../components/pages/Sticky.astro";
import BrandWall from "../../../components/pages/BrandWall.astro";
import Answer from "../../../components/hub/Answer.astro";
import Img from "../../../components/hub/Img.astro";
import Arrow from "../../../components/hub/Arrow.astro";
import { pageHead } from "../../../lib/pagehead";
import { fixDeep, href } from "../../../lib/links";
import raw from "../../../data/pages/d2c.json";
import "../../../styles/pg-wordmark.css";

const D = fixDeep(raw);
const CTA = "Get a paid-media audit";
const img = (n: string) => (n.includes("/") ? n : "d2c/" + n);
const TILES = [
  { img: "packing.jpg", pos: "50% 50%", label: "Fulfilment", note: "Every order packed" },
  { img: "unboxing.jpg", pos: "50% 50%", label: "Unboxing", note: "The first impression" },
  { img: "checkout.jpg", pos: "50% 50%", label: "Checkout", note: "Where orders are won or lost" },
  { img: "range.jpg", pos: "50% 50%", label: "The range", note: "Beauty, food, kids and more" },
];
---
<BaseLayout {...pageHead("d2c", "/industries/d2c/")}>
  <Shell>
    <main class="app-main n-app">
      <PageHero wm="D2C" eyebrow="● Direct-to-consumer brands"
        lines={["Marketing for", '<span class="em-serif">D2C</span> brands', "in India."]}
        sub="One team for the whole D2C growth stack, from ads and creative to conversion and retention, judged on profit per order."
        primary={{ label: CTA, book: "d2c-hero" }} secondary={{ label: "See the brands", href: "#brands" }}>
        <div class="pmh__mosaic">
          {TILES.map((t, k) => (
            <figure class={"pmh__tile pmh__tile--" + (k + 1)}>
              <Img name={img(t.img)} ratio="1 / 1.05" class="pmh__img" pos={t.pos} eager={k < 2} />
              <figcaption><b>{t.label}</b><span>{t.note}</span></figcaption>
            </figure>
          ))}
        </div>
      </PageHero>

      <Answer
        lead="D2C marketing sells a brand's products straight to shoppers online, with no retailer in between."
        hl="straight to shoppers"
        who="Monday Marketing Company (MMC) runs the whole stack for D2C brands in India."
        points={[
          { icon: "coin", title: "It all lands on your P&L", text: "Acquisition cost, delivery, returns and repeat purchase sit with the brand, not a retailer." },
          { icon: "layers", title: "One stack, one team", text: "Ads, creative, conversion and retention, run together." },
          { icon: "gauge", title: "Judged on contribution margin", text: "The profit left after variable costs." },
        ]}
        image="d2c/unboxing.jpg" chip="No retailer in between" />

      <section class="n-band n-band--white pm-band" id="leaks">
        <div class="n-wrap">
          <div class="pm-head n-rise">
            <span class="n-eyebrow">Where D2C brands lose profit</span>
            <h2 class="n-h2">Five places the money <span class="n-serif">leaks.</span></h2>
            <p class="n-lede">Follow one customer from first ad to second order. Each stage has its own way of costing you margin, and its own fix.</p>
          </div>
          <ol class="stg n-rise d1">
            {D.DC_STAGES.map((s: any, k: number) => (
              <li class={"stg__item" + (k % 2 ? " is-flip" : "")}>
                <figure class="stg__fig">
                  <Img name={img(s.img)} ratio="4 / 3" class="stg__img" />
                  <span class="stg__num" aria-hidden="true">{k + 1}</span>
                  <figcaption class="stg__k">{s.k}</figcaption>
                </figure>
                <div class="stg__body">
                  <article class="stg__bad">
                    <span class="stg__tag">
                      <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="currentColor" /><path d="M6.5 6.5 L13.5 13.5 M13.5 6.5 L6.5 13.5" stroke="#fff" stroke-width="2" stroke-linecap="round" /></svg>
                      What you may be doing
                    </span>
                    <p>{s.breaks}</p>
                    <span class="stg__to" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M10 4 V15 M5 10.5 L10 15.5 L15 10.5" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                  </article>
                  <article class="stg__good">
                    <span class="stg__tag">
                      <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="currentColor" /><path d="M5.5 10.5 L8.7 13.6 L14.5 7" fill="none" stroke="#1A2A8C" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      What we do instead
                    </span>
                    <p>{s.does}</p>
                    <a class="stg__link" href={s.href}>{s.link}<Arrow /></a>
                  </article>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="n-band n-band--ink pm-band" id="numbers">
        <div class="n-wrap">
          <div class="pm-head n-rise">
            <span class="n-eyebrow">The numbers we start with</span>
            <h2 class="n-h2">Know these four before you <span class="n-serif">spend another rupee.</span></h2>
            <p>Free calculators. No signup. Use your own numbers.</p>
          </div>
          <div class="dcn n-rise d1">
            {D.DC_NUMBERS.map((x: any) => (
              <a class="dcn__card" href={x.href}>
                <b>{x.n}</b><span>{x.d}</span><i>Open the calculator<Arrow /></i>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="n-band n-band--paper pm-band" id="brands">
        <div class="n-wrap">
          <div class="pm-head n-rise" style="margin-bottom:0">
            <span class="n-eyebrow">The brands</span>
            <h2 class="n-h2">Some of the D2C brands we <span class="n-serif">work with.</span></h2>
            <p class="n-lede">Hover any one to see the work. The tags show what we run for each.</p>
          </div>
          <BrandWall items={D.DC_BRANDS} />
          <div class="pm-proof__foot">
            <a class="pm-textlink" href={href("Our Work.html")}>See the full client book<Arrow /></a>
          </div>
        </div>
      </section>

      <section class="n-band n-band--white pm-band" id="beyond">
        <div class="n-wrap">
          <div class="pm-head n-rise">
            <span class="n-eyebrow">Beyond D2C</span>
            <h2 class="n-h2">D2C is where we go deepest. <span class="n-serif">It is not all we do.</span></h2>
          </div>
          <div class="dcb n-rise d1">
            <article class="dcb__card">
              <Img name="shared/b2b.jpg" ratio="3 / 2" class="dcb__img" />
              <h3>B2B companies</h3>
              <p>Websites, creative and lead generation for B2B companies, where the goal is a qualified lead, not a basket.</p>
              <a class="pm-textlink" href={href("b2b.html")}>See the B2B page<Arrow /></a>
            </article>
            <article class="dcb__card">
              <Img name="shared/education.jpg" ratio="3 / 2" class="dcb__img" />
              <h3>Educational institutes</h3>
              <p>Websites, creative and lead generation for colleges and education brands, where the goal is an enquiry and then an enrolment.</p>
              <a class="pm-textlink" href={href("education.html")}>See the education page<Arrow /></a>
            </article>
          </div>
        </div>
      </section>

      <section class="n-band n-band--paper pm-band" id="faq">
        <div class="n-wrap">
          <div class="pm-head n-rise">
            <span class="n-eyebrow">Common questions</span>
            <h2 class="n-h2">What D2C founders ask <span class="n-serif">first.</span></h2>
          </div>
          <div class="pm-faq n-rise">
            {D.DC_FAQ.map((f: any, k: number) => (
              <details open={k === 0}>
                <summary>{f.q}</summary>
                <div class="pm-faq__a"><p set:html={f.a} /></div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <Cta h2a="Find where your D2C profit" h2b="leaks." lede="On a call, with a senior strategist. We read your accounts against your break-even ROAS." label={CTA} book="d2c-final" />
    </main>
    <Sticky label="Free paid-media audit" book="d2c-sticky" />
  </Shell>
  <PageFx />
</BaseLayout>
