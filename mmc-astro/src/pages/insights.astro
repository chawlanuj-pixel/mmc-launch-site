---
// Insights index: an editorial front page for the guide library. Deliberately its own family
// (src/components/insights/* + src/components/editorial/*, src/styles/editorial.css), sharing
// nothing from src/components/hub/* (Hero, Answer, Stages, Beyond, Cta belong to the service/
// industry/guide-hub template only). The 3 guide articles below reuse the same editorial family.
import BaseLayout from "../layouts/BaseLayout.astro";
import Shell from "../components/Shell.astro";
import Masthead from "../components/insights/Masthead.astro";
import Lead from "../components/insights/Lead.astro";
import IndexList from "../components/insights/IndexList.astro";
import Topics from "../components/insights/Topics.astro";
import Faq from "../components/editorial/Faq.astro";
import Cta from "../components/editorial/Cta.astro";
import "../styles/editorial.css";

const title = "Insights: Guides on Margin, Attribution and Creative Testing | MMC";
const description = "Plain-English guides from Monday Marketing Company on break-even ROAS, why ad dashboards over-count sales and how to test ad creative, plus free tools and a glossary.";
const SITE = "https://www.mondaymarketing.company";

const guides = [
  { n: "01", tag: "Margin and measurement", h: "Contribution margin and the ROAS you need to break even", d: "What one order leaves behind after product, shipping, fees and returns, and how that sets the ROAS a campaign must beat.", href: "/guides/contribution-margin-roas/", img: "/assets/guides/cost.jpg" },
  { n: "02", tag: "Margin and measurement", h: "Why ad dashboards report more sales than you made", d: "Each platform reports the conversions it can link to its own ads. Add them up and they often exceed your real orders. Here is how to read the results anyway.", href: "/guides/attribution-overlap/", img: "/assets/guides/overlap.jpg" },
  { n: "03", tag: "Creative", h: "How D2C brands test ad creative without guessing", d: "Creative decides whether the right people stop scrolling. A repeatable way to test it, read the results and refresh before ads tire.", href: "/guides/creative-testing/", img: "/assets/guides/cards.jpg" },
];
const [featured, ...rest] = guides;

const topics = [
  { h: "Margin and measurement", p: "Know what an order earns, then read your ad numbers against it. Start with the two guides, then run your own figures.", img: "/assets/guides/mer.jpg",
    links: [["Break-even ROAS guide", "/guides/contribution-margin-roas/"], ["Attribution guide", "/guides/attribution-overlap/"], ["Break-even ROAS calculator", "/tools/breakeven-roas/"], ["Unit economics calculator", "/tools/unit-economics/"], ["LTV:CAC calculator", "/tools/ltv-cac/"]] as [string, string][] },
  { h: "Creative", p: "Good creative is found by testing, not by taste. Learn a simple test, and see how we make video and user-generated content.", img: "/assets/guides/hook.jpg",
    links: [["Creative testing guide", "/guides/creative-testing/"], ["UGC and video", "/services/ugc-and-video/"], ["Meta ads", "/services/performance-marketing/meta-ads/"], ["Glossary", "/glossary/"]] as [string, string][] },
  { h: "Lead quality", p: "More leads is not the goal. The right leads, followed up quickly, are. See how we approach lead generation for B2B and education.", img: "/assets/b2b/qualify.jpg",
    links: [["Lead generation", "/services/lead-generation/"], ["B2B marketing", "/industries/b2b/"], ["Education marketing", "/industries/education/"], ["Conversion rate optimisation", "/services/cro/"]] as [string, string][] },
];

const faq = [
  { q: "What will I find on the Insights page?", a: 'Our guides, written in plain English for D2C, B2B and education marketers. Today that means three guides on <a href="/guides/contribution-margin-roas/">break-even ROAS</a>, <a href="/guides/attribution-overlap/">attribution</a> and <a href="/guides/creative-testing/">creative testing</a>.' },
  { q: "Are the guides free?", a: "Yes. Every guide, calculator and glossary entry on the site is free to read and use." },
  { q: "Where are the calculators?", a: 'On the <a href="/tools/">tools page</a>. They cover break-even ROAS, unit economics, LTV:CAC, CAC runway, funnel ROAS and growth trajectory.' },
  { q: "Can you apply this to my brand?", a: 'Yes. A <a href="/audit/">free audit</a> reads your campaigns against your own margins and shows where to start.' },
];

const jsonld = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "@id": SITE + "/insights/#breadcrumb", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE + "/" },
    { "@type": "ListItem", position: 2, name: "Insights", item: SITE + "/insights/" } ] },
  { "@context": "https://schema.org", "@type": "CollectionPage", "@id": SITE + "/insights/#webpage", url: SITE + "/insights/", name: title, description,
    isPartOf: { "@id": SITE + "/#website" }, breadcrumb: { "@id": SITE + "/insights/#breadcrumb" }, publisher: { "@id": SITE + "/#organization" }, inLanguage: "en",
    mainEntity: { "@type": "ItemList", itemListElement: guides.map((g, i) => ({ "@type": "ListItem", position: i + 1, name: g.h, url: SITE + g.href })) } },
  { "@context": "https://schema.org", "@type": "FAQPage", "@id": SITE + "/insights/#faq", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") } })) },
];
---
<BaseLayout title={title} description={description} path="/insights/" ogTitle="Plain guides for clearer marketing decisions" ogDescription="Guides on break-even ROAS, attribution and creative testing, with free tools and a glossary." ogAlt="Monday Marketing Company: insights and guides." jsonld={jsonld}>
  <Shell>
    <main class="app-main editorial">
      <Masthead h1={["Plain guides for clearer marketing", "decisions."]} sub="Guides on margin, measurement and creative testing, with free tools and a glossary, for D2C, B2B and education marketers." />
      <Lead g={featured} />
      <IndexList guides={rest} />
      <Topics topics={topics} />
      <Faq kicker="Common questions" title="Questions about our guides" faq={faq} />
      <Cta eyebrow="A free paid-media audit" h2a="Want this applied to" h2b="your own numbers?" lede="Start with a free audit. A senior strategist reads your campaigns against your margins and shows where to begin." bookKey="insights" />
    </main>
  </Shell>
  <script>import "../scripts/editorial.ts";</script>
</BaseLayout>
