---
// Home v4 ("v2" preview build): follows the section rhythm of 3mindsdigital.com's homepage
// (dark type-driven hero + floating featured-work card, plain logo strip, big bold "Word."
// headings, numbered black services accordion, closing tri-link moment) redrawn in MMC's own
// navy/sun/paper theme with MMC's real content. Published as its own route so it can be reviewed
// before it ever replaces the live homepage. Keeps the two client-approved hover-to-project
// islands (HomeCaps, HomeBrands) and does not touch Shell (nav) or the footer.
import BaseLayout from "../layouts/BaseLayout.astro";
import Shell from "../components/Shell.astro";
import HomeCaps from "../islands/home/HomeCaps.jsx";
import HomeBrands from "../islands/home/HomeBrands.jsx";
import { pageHead } from "../lib/pagehead";
import { href } from "../lib/links";
import "../styles/hub-extra.css";
import "../styles/home4.css";

const SITE = "https://www.mondaymarketing.company";
const TITLE = "Home v2 preview | MMC";
const DESC = "Internal preview build, not linked from navigation.";

const head = pageHead("home", "/home-v2/");
const jsonld: any[] = [];

/* Who we're for */
const AUDIENCES = [
  { id: "d2c", n: "D2C brands", d: "Ads, creative, conversion and retention for brands where the sale happens in one visit, and the real margin is decided after the discount and the shipping cost.", img: "d2c/unboxing.jpg", href: "d2c.html" },
  { id: "b2b", n: "B2B companies", d: "Website, creative and paid media for a purchase that takes longer and involves several people.", img: "b2b/call.jpg", href: "b2b.html" },
  { id: "edu", n: "Education", d: "Search, landing pages, CRM and follow-up for institutes that earn a family's trust over weeks.", img: "edu/students.jpg", href: "education.html" },
];

/* Selected work: real case-study brands, with the real per-brand service tags used elsewhere
   on the site (HomeBrands' own N_FOLIO), so the multi-tag pills are never invented. */
const PROOF = [
  { id: "oosh", name: "OOsh", tags: ["Website redesign and development", "Performance ads, D2C", "Performance creative"] },
  { id: "giraffe", name: "The Growing Giraffe", tags: ["Conversion rate optimisation", "Performance ads, D2C", "Amazon", "Quick commerce"] },
  { id: "sprnt", name: "Sprnt", tags: ["Website redesign and development", "Performance ads, D2C", "Social media"] },
  { id: "awwbaby", name: "AwwBaby", tags: ["Website redesign and development", "Performance ads, D2C", "Performance creative"] },
].map((c) => ({ ...c, slug: c.id, img: `/assets/clients/${c.id}-work.jpg` }));
const FEATURED = PROOF[1]; // The Growing Giraffe: richest real tag set, for the hero's floating card

/* Trust: real logos only, plain strip under the hero */
const TRUST = ["giraffe","oosh","sprnt","lepure","bloom","mvj","nmc","notic","awwbaby","mittiy","skyfling","vagakids"];

/* Differentiator: the honest contrast, vector icons only, no new photography */
const DIFF = [
  { icon: "gauge", t: "A platform reports what it wants to.", d: "Meta, Google and your store each count sales their own way, so the totals never quite agree. We start from your store's real orders." },
  { icon: "margin", t: "A ROAS number hides the loss.", d: "A campaign can look healthy on ROAS and still lose money once product, shipping and returns are paid. We read every account against contribution margin." },
  { icon: "team", t: "Five vendors means five stories.", d: "Media, creative, retention and the website are usually bought separately and never quite agree with each other. One team plans all four together." },
  { icon: "loop", t: "A quarterly report is too late to matter.", d: "By the time a slide deck says what went wrong, the budget is already spent. We read the numbers weekly and change course inside the month." },
];

/* Latest insights: real published guides, not invented blog posts or dates */
const INSIGHTS = [
  { tag: "Guide", title: "Why ad dashboards over-count sales", d: "Why Meta, Google and your store report different sales, and how to read your real results with blended ROAS, surveys and simple tests.", href: "/guides/attribution-overlap/", img: "/assets/guides/overlap.jpg" },
  { tag: "Guide", title: "Contribution margin and break-even ROAS", d: "How to work out the ROAS your own costs demand, and why platform ROAS alone can hide a loss.", href: "/guides/contribution-margin-roas/", img: "/assets/guides/cost.jpg" },
  { tag: "Guide", title: "How D2C brands test ad creative", d: "A simple, repeatable way to test hooks, angles and formats, read the results, and spot when creative is tiring.", href: "/guides/creative-testing/", img: "/assets/guides/cards.jpg" },
];
---
<BaseLayout title={TITLE} description={DESC} path="/home-v2/" ogTitle={TITLE} ogDescription={DESC} ogAlt="MMC home v2 preview" jsonld={jsonld} noindex>
  <script is:inline src="/assets/mmc-popularity.js"></script>
  <Shell>
    <main class="app-main hn">

      <!-- Persistent mobile CTA: phones have no CTA between the hero and the very
           bottom of a long page otherwise. Fixed, always in the DOM, phone-only. -->
      <div class="hn-mcta">
        <button type="button" class="btn btn--primary glow-btn" data-book="home-sticky-mobile">
          <span class="glow-btn__glow" aria-hidden="true"></span>
          <span class="glow-btn__inner">Book a strategy call<span class="arrow"></span></span>
        </button>
      </div>


      <!-- HERO: proof-first split. No stock photo — the hero's own visual is a real
           case study, full-bleed in the same device-window chrome as the Work grid,
           so the first thing a visitor sees is MMC's actual work, not a generic
           meeting photo. Exactly 4 elements on the left: kicker, headline, subhead,
           CTAs. Nothing else competing for the first 3 seconds. -->
      <section class="hn-hero no-section-bg" id="top">
        <div class="hn-wrap hn-hero__split">
          <div class="hn-hero__copy">
            <span class="hn-hero__chip"><i></i>Profit, not platform ROAS</span>
            <h1>One senior team, <em>measured on profit.</em></h1>
            <p class="hn-hero__sub">We plan media, creative, retention and your website as one system, and judge all of it by what an order or a lead is actually worth — not by platform ROAS.</p>
            <div class="hn-hero__actions">
              <button class="btn btn--primary glow-btn" type="button" data-book="home-hero">
                <span class="glow-btn__glow" aria-hidden="true"></span>
                <span class="glow-btn__inner">Book a strategy call<span class="arrow"></span></span>
              </button>
              <a class="btn btn--link" href="#work">View our work<span class="arrow"></span></a>
            </div>
          </div>
          <a class="hn-hero__work" href={"/work/" + FEATURED.slug + "/"}>
            <img src={FEATURED.img} alt="" loading="eager" decoding="async" fetchpriority="high" />
            <span class="hn-hero__work-tags">{FEATURED.tags.slice(0, 2).map((t) => <span>{t}</span>)}</span>
            <span class="hn-hero__work-foot">
              <b>{FEATURED.name}</b>
              <span>See the work<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </span>
          </a>
        </div>
      </section>

      <!-- LOGO STRIP: plain, real marks, right under the hero -->
      <section class="hn-logos" aria-label="A few of the brands we work with">
        <p class="hn-logos__label">A few of the brands we work with</p>
        <div class="hn-logos__row">
          {TRUST.map((id) => (
            <img src={`/assets/clients/${id}.png`} alt="" loading="lazy" decoding="async" width="120" height="34" />
          ))}
        </div>
      </section>

      <!-- OUR WORK: big bold heading, 2-col grid, real multi-tag pills per card -->
      <section class="hn-work" id="work">
        <div class="hn-wrap">
          <div class="hn-work__top">
            <div>
              <p class="hn-eyebrow">Selected work</p>
              <h2 class="hn-h-xl">Our work.</h2>
              <p>Real projects, not portfolio filler — the brief, the build, and what shipped.</p>
            </div>
            <a class="hn-work__all" href={href("Our Work.html")}>See all our work<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          </div>
          <div class="hn-work__grid">
            {PROOF.map((c) => (
              <a class="hn-work__card" href={"/work/" + c.slug + "/"}>
                <img src={c.img} alt="" loading="lazy" decoding="async" width="800" height="600" />
                <span class="hn-work__tags">{c.tags.slice(0, 2).map((t) => <span>{t}</span>)}</span>
                <span class="hn-work__foot"><b>{c.name}</b><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- SERVICES: numbered accordion on black, hover-to-project island kept working -->
      <section class="hn-svc no-section-bg" id="services">
        <div class="hn-wrap">
          <div class="hn-svc__top">
            <h2><span class="hn-eyebrow" style="color:var(--n-sun)">What we run</span>Five systems, <em>one team.</em></h2>
            <p>The entire growth loop, not one slice of it. Hover a row to see the work behind it.</p>
          </div>
          <HomeCaps client:visible />
        </div>
      </section>

      <!-- DIFFERENTIATOR: the honest contrast, pill-badge cards, single accent only on hover -->
      <section class="hn-diff">
        <div class="hn-wrap">
          <div class="hn-diff__head">
            <p class="hn-eyebrow">Why not just a platform</p>
            <h2>The dashboard is not the whole story.</h2>
          </div>
          <div class="hn-diff__grid">
            {DIFF.map((d) => (
              <div class="hn-diff__card">
                <span class="hn-diff__ico" data-ico={d.icon} aria-hidden="true">
                  {d.icon === "gauge" && <svg viewBox="0 0 40 40" fill="none"><path d="M8 28a12 12 0 1 1 24 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M20 28 26 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" class="hn-diff__needle"/><circle cx="20" cy="28" r="1.6" fill="currentColor"/></svg>}
                  {d.icon === "margin" && <svg viewBox="0 0 40 40" fill="none"><path d="M7 27 15 18 21 23 33 10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="hn-diff__line"/><path d="M26 10h7v7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {d.icon === "team" && <svg viewBox="0 0 40 40" fill="none"><circle cx="14" cy="16" r="4.5" stroke="currentColor" stroke-width="1.7"/><circle cx="26" cy="16" r="4.5" stroke="currentColor" stroke-width="1.7"/><path d="M6 32c1-5 4-8 8-8s7 3 8 8M18 32c1-5 4-8 8-8s7 3 8 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>}
                  {d.icon === "loop" && <svg viewBox="0 0 40 40" fill="none"><path d="M10 16a10 10 0 0 1 17-6l3 3M30 24a10 10 0 0 1-17 6l-3-3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" class="hn-diff__spin"/><path d="M27 10h4v4M13 30H9v-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                </span>
                <h3>{d.t}</h3>
                <p>{d.d}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- WHO WE'RE FOR: deliberately NOT another photo-card grid — this is the third
           section in a row that would otherwise use the same chrome as Work and
           Brands. Editorial alternating rows instead: text leads, a real photo
           interrupts from the side, left/right alternates per row. D2C leads but
           never D2C-only. -->
      <section class="hn-aud" id="who">
        <div class="hn-wrap">
          <div class="hn-aud__head">
            <p class="hn-eyebrow">Who we work with</p>
            <h2>Three kinds of business, one way of working.</h2>
          </div>
          <div class="hn-aud__rows">
            {AUDIENCES.map((a, i) => (
              <a class={"hn-aud__row" + (i % 2 === 1 ? " is-rev" : "")} href={href(a.href)}>
                <span class="hn-aud__num">{"0" + (i + 1)}</span>
                <span class="hn-aud__text">
                  <h3>{a.n}</h3>
                  <p>{a.d}</p>
                  <span class="hn-aud__go">See {a.n === "D2C brands" ? "D2C" : a.n === "B2B companies" ? "B2B" : "education"} work<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                </span>
                <span class="hn-aud__pic"><img src={"/assets/" + a.img} alt="" loading={i === 0 ? "eager" : "lazy"} decoding="async" width="900" height="700" /></span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- MID-PAGE CTA: right where a visitor's intent peaks — they've just picked
           themselves out in "Who we're for" — instead of going silent for the rest
           of the page. Repeats the exact hero CTA copy and action. -->
      <section class="hn-midcta">
        <div class="hn-wrap hn-midcta__row">
          <p>Whichever one that was, the first step is the same.</p>
          <button type="button" class="btn btn--primary glow-btn" data-book="home-mid">
            <span class="glow-btn__glow" aria-hidden="true"></span>
            <span class="glow-btn__inner">Book a strategy call<span class="arrow"></span></span>
          </button>
        </div>
      </section>

      <!-- BRANDS: logo wall, hover-to-project, kept working -->
      <section class="hn-brands" id="brands">
        <div class="hn-wrap">
          <div class="hn-brands__head">
            <div>
              <p class="hn-eyebrow">The brands</p>
              <h2>A few of the brands we work with.</h2>
            </div>
            <p>Across D2C, B2B and education. On a computer, hover a logo to see the work.</p>
          </div>
          <HomeBrands client:visible />
        </div>
      </section>

      <!-- LATEST INSIGHTS: real published guides, no invented posts or dates -->
      <section class="hn-ins">
        <div class="hn-wrap">
          <div class="hn-ins__top">
            <div>
              <p class="hn-eyebrow">Guides &amp; tools</p>
              <h2 class="hn-h-xl">Latest insights.</h2>
            </div>
            <p>Margin, ROAS and attribution, explained without the jargon.</p>
          </div>
          <div class="hn-ins__grid">
            {INSIGHTS.map((n) => (
              <a class="hn-ins__card" href={n.href}>
                <span class="hn-ins__shot"><img src={n.img} alt="" loading="lazy" decoding="async" width="700" height="460" onerror="this.closest('.hn-ins__card').querySelector('.hn-ins__shot').style.background='#EDEFF6'" /></span>
                <span class="hn-ins__body">
                  <span class="hn-ins__tag">{n.tag}</span>
                  <h3>{n.title}</h3>
                  <p>{n.d}</p>
                  <span class="hn-ins__go">Read the guide<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- CLOSING: bold heading + tri-link moment, real internal pages, no invented form -->
      <section class="hn-close no-section-bg">
        <div class="hn-wrap">
          <div class="hn-close__top">
            <p class="hn-eyebrow" style="color:var(--n-sun)">Get in touch</p>
            <h2 class="hn-h-xl hn-h-xl--on-dark">Let's talk.</h2>
            <p>Your brand is its own case. Tell us what you're trying to fix and we'll tell you straight whether we're the right team.</p>
          </div>
          <div class="hn-close__row">
            <button type="button" class="hn-close__card" data-book="home-final" style="text-align:left;width:100%;cursor:pointer;border:1px solid rgba(255,255,255,.14);font:inherit">
              <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4M11 13 21 3M21 3h-6M21 3v6"/></svg></i>
              <span>Let's talk</span>
              <b>Start a project<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M17 7H8M17 7v9"/></svg></b>
            </button>
            <a class="hn-close__card" href={href("tools.html")}>
              <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 3v3M16 3v3"/></svg></i>
              <span>Run the numbers</span>
              <b>Guides &amp; tools<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M17 7H8M17 7v9"/></svg></b>
            </a>
            <a class="hn-close__card" href={href("Careers.html")}>
              <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></i>
              <span>Explore</span>
              <b>Careers<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M17 7H8M17 7v9"/></svg></b>
            </a>
          </div>
        </div>
      </section>

    </main>
  </Shell>
  <script>import "../scripts/hub.ts";</script>
</BaseLayout>
