---
import BaseLayout from "../layouts/BaseLayout.astro";
import Shell from "../components/Shell.astro";
import PageFx from "../components/pages/PageFx.astro";
import Cta from "../components/pages/Cta.astro";
import WallCell from "../components/pages/WallCell.astro";
import HomeCaps from "../islands/pages/HomeCaps.jsx";
import HomeBrands from "../islands/pages/HomeBrands.jsx";
import HomeCreative from "../islands/pages/HomeCreative.jsx";
import { pageHead } from "../lib/pagehead";
import { href } from "../lib/links";
import { CLIENTS } from "../lib/hub";
import "../styles/pg-wordmark.css";

const book = (s: string) => `window.mmcBookCall('${s}', event)`;

const ids = Object.keys(CLIENTS);
const half = Math.ceil(ids.length / 2);
const rows = [ids.slice(0, half), ids.slice(half)];

const NUMS = [
  { to: 248, dec: 0, prefix: "₹", suffix: "Cr+", l: "Revenue compounded for clients since 2019" },
  { to: 8.7, dec: 1, prefix: "", suffix: "×", l: "Median blended ROAS across the last 12 months" },
  { to: 27, dec: 0, prefix: "", suffix: "mo", l: "Median client tenure: we're measured on staying" },
  { to: 240, dec: 0, prefix: "", suffix: "+", l: "Creative assets shipped every month" },
];
const FACTS = [
  { to: 248, dec: 0, prefix: "₹", suffix: "Cr+", l: "Revenue compounded" },
  { to: 8.7, dec: 1, prefix: "", suffix: "×", l: "Median blended ROAS" },
  { to: 24, dec: 0, prefix: "", suffix: "", l: "Brands scaled" },
  { to: 20, dec: 0, prefix: "", suffix: "+", l: "Platforms operated" },
];

const P_FILE: Record<string, string> = {
  meta: "meta.svg", google: "google.svg", amazon: "amazon.svg", tiktok: "tiktok.svg", youtube: "youtube.svg", linkedin: "linkedin.svg",
  shopify: "shopify.svg", gokwik: "gokwik.png", shopflo: "shopflo.png", razorpay: "razorpay.svg", whatsapp: "whatsapp.svg", klaviyo: "klaviyo.svg",
  moengage: "moengage.png", ga4: "ga4.svg", tableau: "tableau.png", adobe: "adobe.svg", mixpanel: "mixpanel.svg",
};
const P_GROUPS = [
  { h: "Media & platforms", items: [
    { k: "meta", n: "Meta Ads", b: "Partner" }, { k: "google", n: "Google Ads", b: "Partner" }, { k: "amazon", n: "Amazon Ads", b: null },
    { k: "tiktok", n: "TikTok Ads", b: null }, { k: "youtube", n: "YouTube", b: null }, { k: "linkedin", n: "LinkedIn Ads", b: null } ] },
  { h: "Commerce & checkout", items: [
    { k: "shopify", n: "Shopify Plus", b: "Partner" }, { k: "gokwik", n: "GoKwik", b: null }, { k: "shopflo", n: "Shopflo", b: null },
    { k: "buyspeed", n: "BuySpeed", b: null }, { k: "razorpay", n: "Razorpay", b: null } ] },
  { h: "Retention & messaging", items: [
    { k: "whatsapp", n: "WhatsApp Business", b: "API" }, { k: "klaviyo", n: "Klaviyo", b: null }, { k: "moengage", n: "MoEngage", b: null } ] },
  { h: "Measurement & BI", items: [
    { k: "ga4", n: "GA4", b: null }, { k: "tableau", n: "Tableau", b: null }, { k: "adobe", n: "Adobe Analytics", b: null }, { k: "mixpanel", n: "Mixpanel", b: null } ] },
];
const STEPS = [
  { n: "01", t: "We dig", d: "A full read of the account, the funnel and the cost sheet before anyone touches a budget.", w: "Week 1" },
  { n: "02", t: "We model", d: "Unit economics first: break-even ROAS, CAC ceiling, payback. The plan has to survive the maths.", w: "Week 1–2" },
  { n: "03", t: "We ship", d: "Creative, media and site changes go live together, because they only work together.", w: "Week 2–4" },
  { n: "04", t: "We compound", d: "Weekly optimisation against contribution, monthly against the P&L. We're measured on staying.", w: "Month 2+" },
];
---
<BaseLayout {...pageHead("home", "/")}>
  <script is:inline src="/assets/mmc-popularity.js"></script>
  <Shell>
    <main class="app-main n-app">
      <header class="n-band n-band--void n-hero" id="top">
        <span class="n-hero__glow" aria-hidden="true"></span>
        <span class="n-hero__grid" aria-hidden="true"></span>
        <div class="n-wrap n-hero__in">
          <span class="n-hero__tag n-rise"><i></i>Full-service growth studio · Bengaluru &amp; Mumbai</span>
          <h1 class="n-h1 n-hero__h n-rise d1">
            Performance marketing<br />that survives the <span class="n-serif">P&amp;L.</span>
          </h1>
          <p class="n-lede n-hero__p n-rise d2">
            Media, creative, retention and technology run by one senior team, measured on
            contribution margin, not on the dashboard screenshot.
          </p>
          <div class="n-hero__cta n-rise d3">
            <button class="n-btn n-btn--sun" onclick={book("home-hero")}>
              Book a strategy call<span class="n-btn__arr" aria-hidden="true"></span>
            </button>
            <a class="n-btn n-btn--ghost" href="#work">See the work<span class="n-btn__arr" aria-hidden="true"></span></a>
          </div>
          <div class="n-hero__foot n-rise d4">
            {FACTS.map((f) => (
              <span class="n-hero__fact"><b><span data-count={f.to} data-dec={f.dec} data-prefix={f.prefix}>{f.prefix + f.to.toFixed(f.dec)}<i>{f.suffix}</i></span></b><span>{f.l}</span></span>
            ))}
          </div>
        </div>
      </header>

      <section class="n-band n-band--sun n-band--tight" id="numbers">
        <div class="n-wrap">
          <span class="n-eyebrow n-rise" style="margin-bottom:clamp(28px,3.4vw,44px);display:flex">
            The part that matters
          </span>
          <div class="n-nums">
            {NUMS.map((n, i) => (
              <div class={"n-num n-rise d" + Math.min(4, i + 1)}>
                <span class="n-num__v"><span data-count={n.to} data-dec={n.dec} data-prefix={n.prefix}>{n.prefix + n.to.toFixed(n.dec)}<i>{n.suffix}</i></span></span>
                <span class="n-num__l">{n.l}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="n-band n-band--white n-wall" id="clients">
        <div class="n-wrap">
          <div class="n-head n-rise">
            <div class="n-head__l">
              <span class="n-eyebrow">Trusted by growing brands</span>
              <h2 class="n-h2">
                We are not for everyone.<br />
                <span class="n-serif">Just for the ones who ship.</span>
              </h2>
            </div>
            <p class="n-lede">
              Brands across B2B, B2C and D2C. Hover any one to see the
              work.
            </p>
          </div>
        </div>

        <div class="n-wall__rows">
          {rows.map((r, ri) => r.length > 0 && (
            <div class={"n-marquee n-wall__row" + (ri % 2 === 1 ? " n-marquee--rev" : "")}>
              <div class="n-marquee__track">
                {[...r, ...r].map((id, i) => <WallCell id={id} tiltKey={id + i} />)}
              </div>
              <span class="n-marquee__fade n-marquee__fade--l"></span>
              <span class="n-marquee__fade n-marquee__fade--r"></span>
            </div>
          ))}
        </div>
      </section>

      <section class="n-band n-band--white" id="capabilities">
        <div class="n-wrap">
          <div class="n-head n-rise">
            <div class="n-head__l">
              <span class="n-eyebrow">What we run</span>
              <h2 class="n-h2">Five systems, <span class="n-serif">one team.</span></h2>
            </div>
            <p class="n-lede">
              Most brands buy these from five vendors and spend their week translating between
              them. Here they share a strategist, a thesis and a P&amp;L.
            </p>
          </div>
          <HomeCaps client:visible />
        </div>
      </section>

      <section class="n-band n-band--ink" id="work">
        <div class="n-wrap">
          <div class="n-head n-rise">
            <div class="n-head__l">
              <span class="n-eyebrow">Clients</span>
              <h2 class="n-h2">Selected work,<br /><span class="n-serif">and what we run on it.</span></h2>
            </div>
            <p class="n-lede">
              A few of our brands. Each card carries the brand, the kind of business it is in
              and exactly the services we run for it. Nothing else is claimed on their behalf.
            </p>
          </div>
          <HomeBrands client:visible />
          <div class="n-rise" style="margin-top:clamp(26px,3.2vw,42px)">
            <a class="n-btn n-btn--sun" href={href("Our Work.html")}>See the work<span class="n-btn__arr" aria-hidden="true"></span></a>
          </div>
        </div>
      </section>

      <section class="n-band n-band--paper" id="creative">
        <div class="n-wrap">
          <div class="n-head n-rise">
            <div class="n-head__l">
              <span class="n-eyebrow">Creative &amp; UGC</span>
              <h2 class="n-h2">The ad is the <span class="n-serif">strategy.</span></h2>
            </div>
            <p class="n-lede">
              240+ assets a month across every placement that matters: reels, feed video, square
              statics and marketplace banners. Shot to feel native, not produced to look like an ad.
            </p>
          </div>
          <HomeCreative client:visible />
        </div>
      </section>

      <section class="n-band n-band--void" id="partners">
        <div class="n-wrap">
          <div class="n-head n-rise">
            <div class="n-head__l">
              <span class="n-eyebrow">Partners &amp; platforms</span>
              <h2 class="n-h2">
                We don't just advise on the stack.<br />
                <span class="n-serif">We run it.</span>
              </h2>
            </div>
            <p class="n-lede">
              Eighteen platforms across media, checkout, retention and measurement, configured,
              integrated and operated in-house. No handoffs to a third party, no "ask your
              developer".
            </p>
          </div>

          <div class="n-partners">
            {P_GROUPS.map((g, gi) => (
              <div class={"n-pgroup n-rise d" + Math.min(4, gi + 1)}>
                <h3 class="n-pgroup__h">{g.h}</h3>
                <div class="n-plist">
                  {g.items.map((it) => (
                    <div class="n-plogo">
                      <span class="n-plogo__m">
                        {P_FILE[it.k]
                          ? <img class="n-plogo__img" src={"/assets/platforms/" + P_FILE[it.k]} alt="" loading="lazy" decoding="async" />
                          : <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 15.4h8M6 11.6h9M8 7.8h9" fill="none" stroke="#F0603C" stroke-width="2.1" stroke-linecap="round" /><path d="M15.6 18.6 20 12l-4.4-6.6" fill="none" stroke="#F0603C" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" /></svg>}
                      </span>
                      <span class="n-plogo__n">{it.n}</span>
                      {it.b && <span class="n-plogo__b">{it.b}</span>}
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="n-band n-band--white" id="process">
        <div class="n-wrap">
          <div class="n-head n-rise">
            <div class="n-head__l">
              <span class="n-eyebrow">How it works</span>
              <h2 class="n-h2">Four weeks to a working <span class="n-serif">engine.</span></h2>
            </div>
            <p class="n-lede">
              No three-month discovery. The model is built in week one, because everything after it
              depends on knowing what an order is actually worth.
            </p>
          </div>
          <div class="n-steps">
            {STEPS.map((s, i) => (
              <div class={"n-step n-rise d" + Math.min(4, i + 1)}>
                <span class="n-step__n">{s.n}</span>
                <span class="n-step__t">{s.t}</span>
                <span class="n-step__d">{s.d}</span>
                <span class="n-step__w">{s.w}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="n-band n-band--paper" id="trust">
        <div class="n-wrap">
          <div class="n-quote">
            <div class="n-rise">
              <blockquote class="n-quote__t">
                “We'd worked with three agencies before MMC. None of them understood that{" "}
                <em>retention is a creative problem.</em> They fixed our D60 in a quarter.”
              </blockquote>
              <div class="n-quote__by">
                <b>Founder · D2C beauty</b>
                <span>Named reference available on the call</span>
              </div>
            </div>
            <div class="n-rise d2">
              <p class="n-lede" style="margin-bottom:22px">
                We take on a small number of brands at a time. If we're not the right fit, the
                30-minute call will tell you that faster than a proposal will.
              </p>
              <button class="n-btn n-btn--ink" onclick={book("home-trust")}>
                Book a strategy call<span class="n-btn__arr" aria-hidden="true"></span>
              </button>
            </div>
          </div>
        </div>
      </section>

      <Cta eyebrow="Ready when you are" h2a="Let's find out what an order is" h2b="actually worth."
        lede="Thirty minutes with a senior strategist. No deck, no pitch, a direct read on the three things to fix first."
        label="Book a strategy call" book="home-cta" secondary={{ href: "tools.html", label: "Run the numbers yourself" }} />
    </main>
  </Shell>
  <PageFx />
</BaseLayout>
