# macOS
.DS_Store

# Python bytecode from the build scripts
__pycache__/
*.pyc

# Video portfolio: 253MB of MP4s, one of them 117.9MB.
# GitHub hard-rejects any file over 100MB, so this cannot be pushed as-is.
# Track it with Git LFS, or keep it in cloud storage alongside the repo.
Video portfolio/

# Backup copies of edited files
*.bak

# Design mockups: generated artboards and screenshots, rebuilt by each round's build.py
design/mockups/*/out/
design/mockups/*/preview/

